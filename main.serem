module @main
type @Exception = %Exception [class, field=message:0]
type @SyntaxError = %SyntaxError [class]
type @IndentationError = %IndentationError [class]
type @NameError = %NameError [class]
type @AttributeError = %AttributeError [class]
type @TypeError = %TypeError [class]
type @IndexError = %IndexError [class]
type @ImportError = %ImportError [class]
type @ValueError = %ValueError [class]
type @AssertionError = %AssertionError [class]
type @PermissionError = %PermissionError [class]
type @RuntimeError = %RuntimeError [class]
type @RecursionError = %RecursionError [class]
type @NotImplementedError = %NotImplementedError [class]
type @Animal = %Animal [enum, variant=Dog, variant=Cat]
global @str.0 = str "Bar"
global @str.1 = str "Buddy"
func @input(%arg0: str) -> str {
entry:
  unreachable
}
func @abs(%arg0: i32) -> i32 {
entry:
  %0 = cmp.lt i1 %arg0, 0
  cond_branch %0 {true = if.body0, false = if.end}
if.end:
  return %arg0
if.body0:
  %1 = neg i32 %arg0
  return %1
}
func @min(%arg0: i32, %arg1: i32) -> i32 {
entry:
  %0 = cmp.lt i1 %arg0, %arg1
  cond_branch %0 {true = if.body0, false = if.body1}
if.end:
  unreachable
if.body0:
  return %arg0
if.body1:
  return %arg1
}
func @max(%arg0: i32, %arg1: i32) -> i32 {
entry:
  %0 = cmp.gt i1 %arg0, %arg1
  cond_branch %0 {true = if.body0, false = if.body1}
if.end:
  unreachable
if.body0:
  return %arg0
if.body1:
  return %arg1
}
func @clamp(%arg0: i32, %arg1: i32, %arg2: i32) -> i32 {
entry:
  %0 = call i32 @max, %arg0, %arg1
  %1 = call i32 @min, %0, %arg2
  return %1
}
func @sign(%arg0: i32) -> i32 {
entry:
  %0 = cmp.gt i1 %arg0, 0
  cond_branch %0 {true = if.body0, false = if.body1}
if.end:
  return 0
if.body0:
  return 1
if.body1:
  %1 = cmp.lt i1 %arg0, 0
  cond_branch %1 {true = if.body1, false = if.end}
  %2 = neg i32 1
  return %2
}
func @prelude___init__(%arg0: %Exception, %arg1: str) -> void {
entry:
  member.set %arg0, %arg1 {field = message}
  return
}
func @print_output(%arg0: Ptr[i8]) -> Ptr[i8] {
entry:
  %0 = call str %arg0
  %1 = alloca Ptr[str]
  store %0, %1
  %2 = load str %1
  runtime.print %2
  return %arg0
}
func @foo() -> str [decorator.print_output = true] {
entry:
  return "Bar"
}
func @main() -> i32 {
entry:
  %0 = call str @foo
  %1 = construct %Animal "Buddy" {type = Animal}
  %2 = alloca Ptr[%Animal]
  store %1, %2
  %3 = load %Animal %2
  %4 = enum.tag i32 %3
  %5 = cmp.eq i1 %4, 0
  cond_branch %5 {true = match.arm0, false = match.arm1}
match.end:
  return 0
match.arm0:
  %6 = enum.payload str %3 {index = 0}
  %7 = alloca Ptr[str]
  store %6, %7
  %8 = load str %7
  %9 = string.concat str "This is a dog named ", %8, "."
  runtime.print %9
  branch {target = match.end}
match.arm1:
  %10 = cmp.eq i1 %4, 1
  cond_branch %10 {true = match.arm1, false = match.end}
  %11 = enum.payload str %3 {index = 0}
  %12 = alloca Ptr[str]
  store %11, %12
  %13 = load str %12
  %14 = string.concat str "This is a cat named ", %13, "."
  runtime.print %14
}
