func @clamp(%arg0: i32, %arg1: i32, %arg2: i32) -> i32 {
entry:
  %0 = load i32 %arg0
  %1 = load i32 %arg1
  %2 = call i32 @max, %0, %1
  %3 = load i32 %arg2
  %4 = call i32 @min, %2, %3
