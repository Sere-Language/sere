entry:
  unreachable
}
func @abs(%arg0: i32) -> i32 {
entry:
  %0 = load i32 %arg0
  %1 = cmp.lt i1 %0, 0
  cond_branch %1 {true = if.body0, false = if.end}
if.end:
  %4 = load i32 %arg0
  return %4
if.body0:
  %2 = load i32 %arg0
  %3 = neg i32 %2
  return %3
}
func @min(%arg0: i32, %arg1: i32) -> i32 {
entry:
  %0 = load i32 %arg0
  %1 = load i32 %arg1
  %2 = cmp.lt i1 %0, %1
