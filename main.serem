func @max(%arg0: i32, %arg1: i32) -> i32 {
entry:
  %0 = load i32 %arg0
  %1 = load i32 %arg1
  %2 = cmp.gt i1 %0, %1
  cond_branch %2 {true = if.body0, false = if.body1}
if.end:
