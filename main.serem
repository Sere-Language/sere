func @sign(%arg0: i32) -> i32 {
entry:
  %0 = load i32 %arg0
  %1 = cmp.gt i1 %0, 0
  cond_branch %1 {true = if.body0, false = if.body1}
if.end:
  return 0
if.body0:
  return 1
if.body1:
  %2 = load i32 %arg0
  %3 = cmp.lt i1 %2, 0
  cond_branch %3 {true = if.body1, false = if.end}
  %4 = neg i32 1
