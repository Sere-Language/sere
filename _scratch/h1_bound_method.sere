class Environ:
    path: str

    def __init__(self, path: str) -> void:
        self.path = path

class Response:
    status: i32
    body: str

    def __init__(self, status: i32, body: str) -> void:
        self.status = status
        self.body = body

class App:
    prefix: str

    def __init__(self, prefix: str) -> void:
        self.prefix = prefix

    def dispatch(self, environ: Environ) -> Response:
        return Response(200, self.prefix + environ.path)

def serve(app: Callable[[Environ], Response], environ: Environ) -> Response:
    return app(environ)

def main() -> i32:
    a: App = App("root:")
    r: Response = serve(a.dispatch, Environ("/x"))
    print(r.status)
    print(r.body)
    again: Response = serve(a.dispatch, Environ("/y"))
    print(again.body)
    return 0
