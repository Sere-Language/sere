class Person:
    @private name: str
    @private age: i32

    def __init__(self, name: str, age: i32) -> None:
        self.name = name
        self.age = age

    def get_name(self) -> str:
        return self.name


class Mayor(Person):
    @private city: str

    def __init__(self, name: str, age: i32, city: str) -> None:
        super().__init__(name, age)
        self.city = city


def print_name(person: Person | str) -> None:
    if person is str:
        print(person)
    else:
        print(person.get_name())


def main(argv: list[str]) -> None:
    print("A")
    person = Person("Alice", 25)
    mayor = Mayor("Bob", 45, "Springfield")
    print("B")
    print_name(mayor)
    print("C")
    print_name(person)
    print("D")
    print_name("Bob")
    print("E")
    print([person, mayor])
    print("F")
