class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __contains__(self, value: i32) -> bool:
        return value == self.x or value == self.y


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    print(2 in a)
    print(9 in a)
