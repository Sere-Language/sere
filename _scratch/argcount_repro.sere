def hex(
    value: i32 | i64,
    prefix: str = "0x",
    uppercase: bool = False,
    pad: i32 | None = None,
    signed: bool = False,
    width: i32 | None = None
) -> str:
    return prefix

class Holder:
    @private items: list[i32]

    def __init__(self) -> None:
        self.items = []

    def load(self, data: list[i32], address: i64 = 0x1000) -> None:
        for i in range(0, i32(len(data))):
            self.items.append(data[i])

def main() -> i32:
    print(hex(0xA9))
    h = Holder()
    h.load([0xA9, 0x01, 0xA2])
    return 0
