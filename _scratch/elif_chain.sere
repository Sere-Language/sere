class Person:
    @private name: str

    def __init__(self, name: str) -> None:
        self.name = name

    def get_name(self) -> str:
        return self.name


class Mayor(Person):
    @private city: str

    def __init__(self, name: str, city: str) -> None:
        super().__init__(name)
        self.city = city


def classify(p: Person | str) -> None:
    if p is str:
        print("str")
    elif p is Mayor:
        print("mayor")
        print(p.get_name())
    else:
        print("person")
        print(p.get_name())


def main() -> None:
    classify(Mayor("Bob", "Springfield"))
    classify(Person("Alice"))
    classify("plain")
