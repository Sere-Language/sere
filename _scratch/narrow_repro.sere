class Person:
    @private name: str

    def __init__(self, name: str) -> None:
        self.name = name

    def get_name(self) -> str:
        return self.name


class Mayor(Person):
    @private city: str

    def __init__(self, name: str, city: str) -> None:
        super().__init__(name)
        self.city = city


def only_if(p: Person | str) -> None:
    if p is str:
        print(p)
    else:
        print(p.get_name())


def chain(p: Person | str) -> None:
    if p is str:
        print(p)
    elif p is Mayor:
        print(p.get_name())
    else:
        print(p.get_name())
