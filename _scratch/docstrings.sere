"""Module documentation."""

def add(x: i32, y: i32) -> i32:
    """Add two numbers.

    :param x: First value.
    :param y: Second value.
    :return: Their sum.
    """
    return x + y

class Foo:
    """A documented class."""

    def method(self, value: str) -> str:
        """Transform value.

        :param value: Text to transform.
        :return: Transformed text.
        """
        return value.upper()

struct Point:
    """A point in two dimensions."""
    x: i32
    y: i32

enum Color:
    """Named colors."""
    Red
    Blue

def main() -> i32:
    return 0
