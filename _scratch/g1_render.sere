class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __len__(self) -> i64:
        return 2

    def __str__(self) -> str:
        return f"Vec({self.x}, {self.y})"

    def __repr__(self) -> str:
        return f"Vec[{self.x}, {self.y}]"


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    print(len(a))
    print(str(a))
    print(f"{a}")
    print(a)
    print(repr(a))
    print([a])
    print(f"list={[a]}")
