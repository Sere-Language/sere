class Guard:
    def __enter__(self) -> i32:
        return 7

    def __exit__(self) -> void:
        print("exit")

def first[T](items: list[T]) -> T:
    return items[0]

def apply(cb: Callable[[i32, i32], i32], x: i32, y: i32) -> i32:
    return cb(x, y)

def scale(value: i32, factor: i32 = 2) -> i32:
    return value * factor

def main() -> i32:
    with Guard() as v:
        print("in", v)
    try:
        assert False, "fail"
    except AssertionError as e:
        print("caught:", e.message)
    xs = [1, 2, 3]
    print(first(xs))
    print(apply(scale, 3, 4))
    print(apply(add1, 3, 4))
    return 0

def add1(a: i32, b: i32) -> i32:
    return a + b
