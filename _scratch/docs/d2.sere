class Temp:
    celsius: f64

    @property
    def fahrenheit(self) -> f64:
        return self.celsius * 1.8 + 32.0

    @fahrenheit.setter
    def fahrenheit(self, value: f64) -> void:
        self.celsius = (value - 32.0) / 1.8

class Vec:
    @frozen x: i32
    y: i32

    def __init__(self, x: i32, y: i32) -> void:
        self.x = x
        self.y = y

def main() -> i32:
    t = Temp()
    t.celsius = 0.0
    print(t.fahrenheit)
    t.fahrenheit = 212.0
    print(t.celsius)
    v = Vec(1, 2)
    v.y = 5
    print(v.x, v.y)
    return 0
