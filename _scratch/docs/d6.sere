class Animal:
    name: str

    def __init__(self, name: str) -> void:
        self.name = name

    def speak(self) -> str:
        return "..."

class Dog(Animal):
    def speak(self) -> str:
        return "woof"

    def owned(self) -> str:
        return super().speak() + " base"

class Vec:
    @frozen x: i32
    @frozen y: i32

    def __init__(self, x: i32, y: i32) -> void:
        self.x = x
        self.y = y

    def __add__(self, other: Vec) -> Vec:
        return Vec(self.x + other.x, self.y + other.y)

    def __mul__(self, factor: i32) -> Vec:
        return Vec(self.x * factor, self.y * factor)

    def __eq__(self, other: Vec) -> bool:
        return self.x == other.x and self.y == other.y

    def __lt__(self, other: Vec) -> bool:
        return self.x < other.x

    def __str__(self) -> str:
        return f"Vec({self.x}, {self.y})"

class Offset:
    @frozen dx: i32

    def __init__(self, dx: i32) -> void:
        self.dx = dx

    def __radd__(self, other: i32) -> i32:
        return other + self.dx

def describe(a: Animal) -> str:
    return a.speak()

def main() -> i32:
    d = Dog("rex")
    print(describe(d))
    print(d.name, d.owned())
    print(Vec(1, 2) + Vec(3, 4))
    print(Vec(1, 2) * 3)
    print(Vec(1, 2) == Vec(1, 2))
    print(Vec(1, 2) != Vec(1, 2))
    print(Vec(1, 2) < Vec(3, 4))
    print(Vec(3, 4) > Vec(1, 2))
    print(5 + Offset(10))
    return 0
