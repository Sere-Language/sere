def log(prefix: str, *parts: list[str]) -> void:
    print(prefix, len(parts))

def opts(**kwargs: dict[str, str]) -> void:
    print("opts", len(kwargs))

def make(width: i32, height: i32 = 10, filled: bool = False) -> str:
    return f"{width}x{height}"

def main() -> i32:
    log("p", "a", "b")
    log("q")
    opts(sep=",", end="")
    print(make(1, 2))
    print(make(height=4, width=3))
    print(make(1, filled=True))
    add1 = lambda (x: i32) -> i32: x + 1
    print(add1(2))
    cb = add1
    print(cb(5))
    return 0
