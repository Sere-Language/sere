def main(argv: list[str]) -> i32:
    print("argc", len(argv))
    xs = [1, 2, 3]
    del xs[0]
    print(xs)
    d = {"a": 1, "b": 2}
    for k in d:
        print("key", k, d[k])
    s = "abc"
    for ch in s:
        print("ch", ch)
    n = 3
    if n < 0:
        print("neg")
    elif n == 0:
        print("zero")
    else:
        print("pos")
    i = 0
    while i < 2:
        i += 1
    print("i", i)
    assert n > 0, "n must be positive"
    label = "big" if n > 2 else "small"
    print(label)
    index = 0
    for value in xs:
        print("idx", index, value)
        index += 1
    return 0
