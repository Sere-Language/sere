class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __add__(self, other: Vec) -> Vec:
        return Vec(self.x + other.x, self.y + other.y)


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    b = Vec(3, 4)
    print("add:")
    print(a + b)
