struct S1:
    name: str

    def __str__(self) -> str:
        print("hi")
        return self.name

struct S2:
    name: str

    def __str__(self) -> str:
        parts = self.name.split('.')
        print(parts)
        return self.name

struct S3:
    name: str

    def __str__(self) -> str:
        mode = f"{self.name}"
        print(mode.split('.'))
        return mode

def free_fn(name: str) -> str:
    mode = f"{name}"
    print(mode.split('.'))
    return mode
