class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __getitem__(self, index: i32) -> i32:
        if index == 0:
            return self.x
        return self.y

    def __contains__(self, value: i32) -> bool:
        return value == self.x or value == self.y

    def __bool__(self) -> bool:
        return self.x != 0 or self.y != 0


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    print("getitem:")
    print(a[0])
    print(a[1])
    print("contains:")
    print(2 in a)
    print(9 in a)
    print("bool:")
    print(not a)
