class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __bool__(self) -> bool:
        return self.x != 0 or self.y != 0


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    print(not a)
    print(not Vec(0, 0))
