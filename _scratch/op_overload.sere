class Vec:
    @frozen x: i32
    @frozen y: i32

    def __init__(self, x: i32, y: i32):
        self.x = x
        self.y = y

    def __add__(self, other: Vec) -> Vec:
        return Vec(self.x + other.x, self.y + other.y)

    def __sub__(self, other: Vec) -> Vec:
        return Vec(self.x - other.x, self.y - other.y)

    def __mul__(self, factor: i32) -> Vec:
        return Vec(self.x * factor, self.y * factor)

    def __eq__(self, other: Vec) -> bool:
        return self.x == other.x and self.y == other.y

    def __lt__(self, other: Vec) -> bool:
        return self.x < other.x

    def __le__(self, other: Vec) -> bool:
        return self.x <= other.x

    def __gt__(self, other: Vec) -> bool:
        return self.x > other.x

    def __ge__(self, other: Vec) -> bool:
        return self.x >= other.x

    def __str__(self) -> str:
        return "Vec(" + self.x + ", " + self.y + ")"

class Money:
    @frozen cents: i32

    def __init__(self, cents: i32):
        self.cents = cents

    def __add__(self, other: Money) -> Money:
        return Money(self.cents + other.cents)

    def __eq__(self, other: Money) -> bool:
        return self.cents == other.cents

    def __str__(self) -> str:
        return f"{self.cents}c"

class Object:
    @frozen part: str

    def __init__(self, part: str):
        self.part = part

    def __add__(self, other: Object) -> Object:
        return Object(self.part + other.part)

    def __eq__(self, other: Object) -> bool:
        return self.part == other.part

    def __str__(self) -> str:
        return self.part

class Offset:
    @frozen dx: i32

    def __init__(self, dx: i32):
        self.dx = dx

    # Reflected: only reachable as `value + Offset`, never `Offset + value`.
    def __radd__(self, other: i32) -> i32:
        return other + self.dx

    def __str__(self) -> str:
        return "Offset(" + self.dx + ")"

def main(argv: list[str]) -> i32:
    # --- string arithmetic ---
    s = "Num: "
    s += "Hello"
    assert s == "Num: Hello"
    s = s + "! " + 5
    assert s == "Num: Hello! 5"
    print(s)
    s += 7
    print(s)
    s = 1.5 + ": " + True + ": " + "end"
    print(s)
    assert "Hello" * 5 == "HelloHelloHelloHelloHello"
    assert 3 * "ab" == "ababab"
    print("Hi" * 3)

    # --- list arithmetic ---
    xs = [0] * 10
    assert len(xs) == 10
    assert xs[0] == 0 and xs[9] == 0
    print(xs)
    ys = [1, 2] * 3
    assert len(ys) == 6
    print(ys)
    zs = 2 * [7]
    print(zs)
    ys += [9]
    assert len(ys) == 7
    print(ys)

    # --- operator overloading ---
    a = Vec(1, 2)
    b = Vec(3, 4)
    print(a + b)
    print(b - a)
    print(a * 3)
    print("eq fresh = " + (a == Vec(1, 2)))
    print("ne = " + (a != b))
    print("lt = " + (a < b))
    print("le = " + (a <= Vec(1, 2)))
    print("gt = " + (b > a))
    print("ge = " + (b >= a))
    assert a == Vec(1, 2)
    assert a != b
    assert a < b
    assert b > a
    assert a <= Vec(1, 2)
    assert b >= a
    c = Vec(0, 0)
    c += a
    print(c)
    assert c == a

    m = Money(150)
    m += Money(75)
    print(m)
    assert m == Money(225)

    o1 = Object("Hello ")
    o2 = Object("World")
    print(o1 + o2)
    assert o1 + o2 == Object("Hello World")
    assert o1 != o2

    # --- reflected operators ---
    off = Offset(10)
    assert 5 + off == 15
    print("5 + off = " + (5 + off))

    # --- zero / empty repeats ---
    assert len([1] * 0) == 0
    assert len("abc" * 0) == 0
    assert len([1] * -2) == 0
    print("empty repeats ok")
    return 0
