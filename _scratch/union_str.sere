class Person:
    @private name: str

    def __init__(self, name: str) -> None:
        self.name = name

    def get_name(self) -> str:
        return self.name


def show(value: Person | str) -> None:
    if value is str:
        print("str branch:")
        print(value)
        print(len(value))
        echo = value
        print(echo)
    else:
        print("object branch:")
        print(value.get_name())


def main(argv: list[str]) -> None:
    show("Bob")
    show(Person("Alice"))
