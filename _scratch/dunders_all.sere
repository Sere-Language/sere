class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __len__(self) -> i64:
        return 2

    def __str__(self) -> str:
        return f"Vec({self.x}, {self.y})"

    def __eq__(self, other: Vec) -> bool:
        return self.x == other.x and self.y == other.y

    def __add__(self, other: Vec) -> Vec:
        return Vec(self.x + other.x, self.y + other.y)

    def __getitem__(self, index: i32) -> i32:
        if index == 0:
            return self.x
        return self.y

    def __contains__(self, value: i32) -> bool:
        return value == self.x or value == self.y

    def __bool__(self) -> bool:
        return self.x != 0 or self.y != 0


def show(value: Vec | str) -> None:
    if value is str:
        print("str:")
        print(value)
    else:
        print("vec:")
        print(value)
        print(len(value))


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    b = Vec(3, 4)
    print("len:")
    print(len(a))
    print("str:")
    print(a)
    print("fstring:")
    print(f"{a}")
    print("eq:")
    print(a == b)
    print(a == Vec(1, 2))
    print("add:")
    print(a + b)
    print("getitem:")
    print(a[0])
    print(a[1])
    print("contains:")
    print(2 in a)
    print(9 in a)
    print("bool:")
    print(not a)
    print(not Vec(0, 0))
    print("list:")
    print([a, b])
    print("union:")
    show("hello")
    show(a)
