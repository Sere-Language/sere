class Vec:
    @private x: i32
    @private y: i32

    def __init__(self, x: i32, y: i32) -> None:
        self.x = x
        self.y = y

    def __eq__(self, other: Vec) -> bool:
        return self.x == other.x and self.y == other.y


def main(argv: list[str]) -> None:
    a = Vec(1, 2)
    b = Vec(3, 4)
    print("eq:")
    print(a == b)
    print(a == Vec(1, 2))
