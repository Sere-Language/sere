def main() -> i32:
    inner: dict[str, Any] = dict[str, Any]()
    inner["k"] = "v"
    inner["n"] = 2
    outer: dict[str, Any] = dict[str, Any]()
    outer["child"] = inner
    outer["list"] = [1, 2, 3]
    outer["flag"] = True
    outer["nothing"] = None
    print(outer)
    print(typeof(outer["child"]))
    print(typeof(outer["list"]))
    print(typeof(outer["flag"]))
    print(typeof(outer["nothing"]))
    child: Any = outer["child"]
    print(child)
    if isinstance(child, dict[str, Any]):
        print("is-dict")
    other: Any = outer["list"]
    if isinstance(other, list[Any]):
        print("is-list")
    if isinstance(other, list[i32]):
        print("is-list-i32")
    print(other)
    return 0
