class Person:
    @private name: str
    @private age: i32

    def __init__(self, name: str, age: i32) -> None:
        self.name = name
        self.age = age

    def get_name(self) -> str:
        return self.name


class Mayor(Person):
    @private city: str

    def __init__(self, name: str, age: i32, city: str) -> None:
        super().__init__(name, age)
        self.city = city


def as_union(person: Person | str) -> None:
    print("entered as_union")


def main(argv: list[str]) -> None:
    person = Person("Alice", 25)
    mayor = Mayor("Bob", 45, "Springfield")
    print("t1: union param with Person")
    as_union(person)
    print("t2: union param with str")
    as_union("Bob")
    print("t3: union param with Mayor")
    as_union(mayor)
    print("done")
