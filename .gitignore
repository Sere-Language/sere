# Build trees
/build/
/out/
/dist/
/cmake-build-*/

# Local convenience copies of the compiler (except the readme and PATH helpers)
/bin/*
!/bin/README.md
!/bin/sere-path.ps1
!/bin/sere-path.cmd
!/bin/sere-path.sh

# Local CMake overrides (bootstrap may generate this)
CMakeUserPresets.json

# In-source CMake from `cmake .` — always use presets into build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
DartConfiguration.tcl
/Testing/
/generated/
*.vcxproj
*.vcxproj.filters
*.sln
*.dir/

# Toolchains extracted into the repo by mistake
/toolchains/
/third_party/llvm/

# Compilers / clangd
.cache/
compile_commands.json
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
!examples/**
*.obj
*.o
*.a

# Scratch IR / objects at the repo root
/*.ll
/*.s
/.sere-lib/

# Packaged editor
/editors/vscode/*.vsix

# IDE
.vs/
.idea/
*.user
*.suo

# Release zip payload: ship the compiler, never commit LLVM trees
/releases/**/toolchains/
!/releases/**/*.exe
!/releases/**/*.lib
!/releases/**/*.dll
!/releases/**/*.vsix
releases/

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Python leftover caches (stdlib tests later)
__pycache__/
*.pyc
.venv/
