# Build trees
/build/
/out/
/dist/
/cmake-build-*/

# Local convenience copies of the compiler (except the readme)
/bin/*
!/bin/README.md

# Local CMake overrides (bootstrap may generate this)
CMakeUserPresets.json
CMakeCache.txt
/CMakeFiles/

# Toolchains extracted into the repo by mistake
/toolchains/
/third_party/llvm/

