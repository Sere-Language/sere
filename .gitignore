.cache/
compile_commands.json
*.pdb
*.ilk
*.exp
*.lib
*.dll
*.exe
!examples/**
*.obj
*.o
*.a

# Scratch IR at the repo root
/*.ll

# Packaged editor
/editors/vscode/*.vsix

# IDE
.vs/
.idea/
*.user
*.suo

# OS
Thumbs.db
Desktop.ini
.DS_Store

# Python leftover caches (stdlib tests later)
__pycache__/
*.pyc
.venv/
