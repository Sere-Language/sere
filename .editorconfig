root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,h,cpp,hpp,h.in}]
indent_style = space
indent_size = 2

[*.{cmake,CMakeLists.txt}]
indent_style = space
indent_size = 2

[*.{json,yml,yaml}]
indent_style = space
indent_size = 2

[*.{ps1,psm1}]
indent_style = space
indent_size = 2

[*.sere]
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false
