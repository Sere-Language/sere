enum Color:
    Red
    Green = 2
    Blue

enum Message:
    Quit
    Move(x: i32, y: i32)
    Write(str)

    def is_quit(self) -> bool:
        match self:
            case Message.Quit:
                return True
            case _:
                return False

def main() -> i32:
    tone: Color = Color.Green
    assert tone is Color.Green
    assert tone.name == "Green"
    assert tone.value == 2
    assert i32(tone) == 2
    names: list[str] = Color.variants()
    assert len(names) == 3
    moved: Message = Message.Move(1, 2)
    match moved:
        case Message.Move(x, y):
            assert x == 1
            assert y == 2
        case _:
            assert False
    assert Message.Quit.is_quit()
    print(Color.__name__, tone.name)
    return 0
