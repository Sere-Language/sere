import gl

def main() -> i32:
    print(gl.available())
    mask: i32 = gl.color_depth()
    print(gl.Capability.DepthTest.value, mask, gl.Primitive.Triangles.value)
    print(gl.ShaderKind.Vertex.value, gl.ShaderKind.Fragment.value)
    print(gl.BufferTarget.Array.value, gl.Usage.StaticDraw.value)
    print(gl.TextureFormat.RGBA.value, gl.Filter.Linear.value)
    print(gl.Key.Escape.value, gl.Mouse.Left.value)
    print(gl.GlError.NoError.value, gl.FramebufferStatus.Complete.value)
    print(gl.WindowFlag.Vsync.value, gl.CursorMode.Disabled.value, gl.Action.Press.value)
    print(gl.Mod.Shift.value, gl.Mod.Control.value, gl.BlendEquation.Add.value)
    print(gl.StencilOp.Keep.value, gl.HintMode.Nicest.value, gl.Hint.LineSmooth.value)
    print(gl.LogicOp.Copy.value, gl.DrawBuffer.Empty.value)
    print(gl.screen_width(), gl.screen_height(), gl.default_window_flags())
    color = gl.Color(0.1, 0.2, 0.3, 1.0)
    print(color.r, color.g, color.b, color.a)
    faded = color.with_alpha(0.5)
    print(faded.a, faded.r8())
    mixed = color.lerp(gl.rgb(1.0, 1.0, 1.0), 0.25)
    print(mixed.r)
    packed: i32 = color.to_u32()
    restored = gl.color_u32(packed)
    inverted = color.invert().clamp01()
    print(packed, restored.r8(), inverted.gray())
    return 0
