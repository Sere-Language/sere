import qt6

def main() -> i32:
    print(qt6.available())
    print(qt6.styles())
    if not qt6.available():
        return 0
    app = qt6.Application()
    app.set_name("Sere")
    app.set_org("Sere")
    app.set_font(qt6.font("Segoe UI", 13))
    app.apply_dark()
    app.set_accent(qt6.accent())
    win = qt6.Window("Sere Studio")
    win.resize(1100, 720)
    win.center()
    file_menu = win.menu("File")
    open_act = file_menu.add("Open", "Ctrl+O")
    file_menu.add_separator()
    quit_act = file_menu.add("Quit", "Ctrl+Q")
    bar = win.toolbar("Main")
    qt6.toolbar_add_action(bar, open_act)
    split = qt6.Splitter(win, qt6.Orientation.Horizontal)
    side = qt6.pane(win)
    side.set_object_name("sidebar")
    side.set_fixed_size(220, 640)
    nav = qt6.VBox(side)
    nav.set_margins(12, 12, 12, 12)
    nav.set_spacing(8)
    title = qt6.Label(side, "Sere")
    title.set_font(qt6.bold("Segoe UI", 18))
    open_btn = qt6.Button(side, "New project")
    open_btn.set_class("primary")
    ghost = qt6.Button(side, "Open file")
    ghost.set_class("ghost")
    nav.add(title)
    nav.add(open_btn)
    nav.add(ghost)
    nav.add_stretch(1)
    tabs = qt6.TabWidget(win)
    tabs.set_document_mode(True)
    tabs.set_movable(True)
    editor_page = qt6.pane(win)
    form = qt6.Form(editor_page)
    name = qt6.LineEdit(editor_page, "")
    name.set_placeholder("Project name")
    name.set_completer("Studio\nPlayer\nRenderer")
    notes = qt6.RichText(editor_page, "<b>Notes</b>")
    notes.set_markdown("# Scene\nWrite markup here.")
    form.add_row("Name", name)
    form.add_row("Notes", notes)
    table_page = qt6.pane(win)
    table = qt6.TableWidget(table_page, 4, 3)
    table.set_header(0, "Clip")
    table.set_header(1, "In")
    table.set_header(2, "Out")
    table.stretch_last(True)
    table.set(0, 0, "Intro")
    grid = qt6.VBox(table_page)
    grid.add(table)
    tabs.add(editor_page, "Inspector")
    tabs.add(table_page, "Timeline")
    split.add(side)
    split.add(tabs)
    split.set_sizes(220, 860)
    win.set_central(split)
    win.show_status("Ready", 2000)
    win.show()
    app.process()
    clicked = open_btn.clicked()
    opened = open_act.triggered()
    leaving = quit_act.triggered()
    print(clicked, opened, leaving, name.text(), table.cell(0, 0))
    return 0
