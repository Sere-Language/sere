def enumerate[T](items: list[T], start: i64 = 0) -> list[(i64, T)]:
    """Return indexed pairs from a list."""
    result: list[(i64, T)] = []
    index: i64 = start
    for item in items:
        result.append((index, item))
        index += 1
    return result

def main() -> i32:
    li = ["Bob", "Joe", "Joanne"]
    for i, v in enumerate(li):
        print(i, v)
    for i, v in enumerate(li, 10):
        print(i, v)
    return 0
