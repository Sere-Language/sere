def main() -> i32:
    hello: str = "Hello"
    quoted: str = 'Hello'
    block: str = """Hello"""
    assert hello[0] == "H"
    assert hello[-1] == "o"
    assert hello[1:4] == "ell"
    assert len(hello) == 5
    assert "ell" in hello
    assert hello + "!" == "Hello!"
    assert hello * 2 == "HelloHello"
    assert quoted == hello
    assert block == hello
    first: str = hello[0]
    print(first)
    return 0
