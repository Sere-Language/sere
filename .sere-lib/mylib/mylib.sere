
@public class Person:
    @public name: str 
    @public age: Int

    def __init__(self, name: str, age: Int) -> void:
        self.name = name
        self.age = age
        
    def say_hello(self) -> void:
        print(f"Hello, my name is {self.name} and I am {self.age} years old")

    def say_goodbye(self) -> void:
        print(f"Goodbye, my name is {self.name} and I am {self.age} years old")

@private def this_is_private() -> void:
    print("This is a private function")

@public def this_is_public() -> void:
    print("This is a public function")
