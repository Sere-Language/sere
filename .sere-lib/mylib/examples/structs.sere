struct Point:
    x: i32
    y: i32

    def length_sq(self) -> i32:
        return self.x * self.x + self.y * self.y

def main() -> i32:
    p: Point = Point(1, 2)
    q: Point = p
    q.x = 9
    assert p.x == 1
    assert q.x == 9
    assert p.length_sq() == 5
    print(__name__, Point.__name__)
    return 0
