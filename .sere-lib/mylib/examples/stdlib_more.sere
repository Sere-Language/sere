import bit
import encoding
import env
import hash
import random
import string
import sys

def main() -> i32:
    random.seed(1)
    n: i32 = random.between(0, 10)
    digest: i64 = hash.fnv1a("sere")
    mixed: i64 = hash.combine(digest, 1)
    host: str = sys.platform()
    cpus: i32 = sys.cpu_count()
    encoded: str = encoding.b64encode("hi")
    decoded: str = encoding.b64decode(encoded)
    flagged: i32 = bit.set(0, 3)
    found: i64 = string.find("hello", "ll")
    parts: list[str] = string.split("a,b", ",")
    swapped: str = string.replace("ab12", "ab", "xy")
    home: bool = env.is_set("PATH")
    print(n, mixed, host, cpus, encoded, decoded, flagged, found, swapped, home)
    print(sys.version(), sys.arch(), len(parts), bit.get(flagged, 3))
    return 0
