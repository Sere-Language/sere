import arrays
import bytes
import math
import matrix
import ml
from bytes import Buffer
from matrix import Mat4
from vec import Vec2, Vec3, vec3i

def main() -> i32:
    a: Vec3 = vec3i(1, 0, 0)
    b: Vec3 = vec3i(0, 1, 0)
    crossed: Vec3 = a.cross(b)
    origin: Vec2 = Vec2(1, 2)
    scaled: Vec2 = Vec2(1.0, 2.5).scale(0.5)
    eye: list[f64] = arrays.full(3, 0.0)
    eye[2] = 5.0
    center: list[f64] = arrays.zeros(3)
    up: list[f64] = [0.0, 1.0, 0.0]
    cam: Mat4 = matrix.look_at(eye, center, up)
    proj: Mat4 = matrix.perspective(math.radians(60.0), 16.0 / 9.0, 1.0 / 10.0, 100.0)
    world: Mat4 = matrix.mul(proj, cam)
    logits: list[f64] = [1.0, 2.0, 3.0]
    probs: list[f64] = ml.softmax(logits)
    buf: Buffer = Buffer(8)
    buf.set(0, 255 as byte)
    bytes.write_u32_le(buf.data, 1, 305419896 as u32)
    hexed: str = buf.hex()
    print(origin.x, scaled.y, crossed.z, world.get(0, 0), arrays.argmax(probs), buf.get(0) as i32, hexed)
    return 0
