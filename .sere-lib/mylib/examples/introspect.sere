from inspect import label

type Number = i32 | i64

class Box:
    @public value: i32

    def __init__(self, value: i32) -> void:
        self.value = value

    def add(self, n: i32) -> i32:
        return self.value + n

def scale(value: i32) -> i32:
    return value * 2

def main() -> i32:
    values: list[i32] = [1, 2, 3, 4]
    tail: list[i32] = values[1:]
    head: list[i32] = values[:2]
    mid: list[i32] = values[1:3]
    copy: list[i32] = values[:]
    small: i32 = 3
    wide: i64 = 10
    mixed: bool = small < wide
    total: i64 = small + wide
    n: Number = 7
    name: str = small.__name__
    kind: str = typeof(small)
    typed: bool = isinstance[i32](small)
    also: bool = isinstance(small, i32)
    info: str = inspect(scale)
    members: list[str] = dir(Box)
    print(label("main"), name, kind, info, Box.__name__)
    print(__name__, __file__, __sere_version__)
    assert __name__ == "__main__"
    assert len(__file__) > 0
    print(Box.__module__, Box.__qualname__)
    print(len(tail), len(head), len(mid), len(copy), mixed, total, n as i32, typed, also, len(members))
    return 0
