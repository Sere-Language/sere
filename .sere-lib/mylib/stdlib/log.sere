# Stderr logging. Import with: import log

import io

def write(level: str, text: str) -> void:
    io.eprint("[")
    io.eprint(level)
    io.eprint("] ")
    io.eprint(text)
    io.eprint_nl()

def debug(text: str) -> void:
    write("debug", text)

def info(text: str) -> void:
    write("info", text)

def warn(text: str) -> void:
    write("warn", text)

def error(text: str) -> void:
    write("error", text)
