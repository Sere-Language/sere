# Machine-learning primitives on packed f64 arrays. Import with: import ml

extern "C" "sere_ml_relu"
def relu(values: list[f64]) -> list[f64]

extern "C" "sere_ml_leaky_relu"
def leaky_relu(values: list[f64], alpha: f64) -> list[f64]

extern "C" "sere_ml_sigmoid"
def sigmoid(values: list[f64]) -> list[f64]

extern "C" "sere_ml_tanh"
def tanh(values: list[f64]) -> list[f64]

extern "C" "sere_ml_softmax"
def softmax(values: list[f64]) -> list[f64]

extern "C" "sere_ml_log_softmax"
def log_softmax(values: list[f64]) -> list[f64]

extern "C" "sere_ml_mse"
def mse(pred: list[f64], target: list[f64]) -> f64

extern "C" "sere_ml_mae"
def mae(pred: list[f64], target: list[f64]) -> f64

extern "C" "sere_ml_bce"
def binary_cross_entropy(pred: list[f64], target: list[f64]) -> f64

extern "C" "sere_ml_linear"
def linear(inputs: list[f64], weights: list[f64], bias: f64) -> f64

extern "C" "sere_math_exp"
def _exp(value: f64) -> f64

extern "C" "sere_math_tanh"
def _tanh(value: f64) -> f64

def relu_scalar(value: f64) -> f64:
    if value < 0 as f64:
        return 0 as f64
    return value

def leaky_relu_scalar(value: f64, alpha: f64) -> f64:
    if value < 0 as f64:
        return value * alpha
    return value

def sigmoid_scalar(value: f64) -> f64:
    return 1 as f64 / (1 as f64 + _exp(0 as f64 - value))

def tanh_scalar(value: f64) -> f64:
    return _tanh(value)
