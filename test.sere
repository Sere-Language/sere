import fs

def main() -> i32:
    x: f32 = 3.13
    y: i32 = 3
    print(x)
    print(y)
    print(3.13)

    vowels = "aeiou"
    print("Vowel identifier!")
    in_str = input("Input your sentence or word: ")
    in_list = in_str.split('')
    found = list[str]()

    for c in in_list:
        if c in vowels:
            found.append(c)

    print(f"Found {len(found)} vowels")
    print(f"Vowels found: {found}")
    with fs.open("output.txt", "w") as f:
        f.write(f"Found {len(found)} vowels\n")
        f.write(f"Vowels found: {found}\n")


    return 0
