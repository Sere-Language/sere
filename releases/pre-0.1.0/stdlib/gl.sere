class Color:
    r: f64
    g: f64
    b: f64
    a: f64

    def apply(self) -> void:
        clear_color(self.r, self.g, self.b, self.a)

    def use3(self) -> void:
        color3(self.r, self.g, self.b)

    def use4(self) -> void:
        color4(self.r, self.g, self.b, self.a)

class Window:
    ptr: Ptr[i8]
    title: str

    def __init__(self, title: str, width: i32, height: i32) -> void:
        self.title = title
        self.ptr = _window_new(title, width, height)

    def poll(self) -> bool:
        return _window_poll(self.ptr) as bool

    def swap(self) -> void:
        _window_swap(self.ptr)

    def make_current(self) -> void:
        _window_make_current(self.ptr)

    def width(self) -> i32:
        return _window_width(self.ptr)

    def height(self) -> i32:
        return _window_height(self.ptr)

    def aspect(self) -> f64:
        h: i32 = self.height()
        if h == 0:
            return 1 as f64
        return (self.width() as f64) / (h as f64)

    def set_title(self, title: str) -> void:
        self.title = title
        _window_set_title(self.ptr, title)

    def get_title(self) -> str:
        return _window_title(self.ptr)

    def set_vsync(self, enabled: bool) -> void:
        _window_set_vsync(self.ptr, enabled as i32)

    def show_cursor(self, show: bool) -> void:
        _window_show_cursor(self.ptr, show as i32)

    def set_size(self, width: i32, height: i32) -> void:
        _window_set_size(self.ptr, width, height)

    def time(self) -> f64:
        return _window_time(self.ptr)

    def dt(self) -> f64:
        return _window_dt(self.ptr)

    def key(self, code: Key) -> bool:
        return _window_key(self.ptr, code.value) as bool

    def key_code(self, vk: i32) -> bool:
        return _window_key(self.ptr, vk) as bool

    def mouse_x(self) -> i32:
        return _window_mouse_x(self.ptr)

    def mouse_y(self) -> i32:
        return _window_mouse_y(self.ptr)

    def button(self, which: Mouse) -> bool:
        return _window_mouse_button(self.ptr, which.value) as bool

    def wheel(self) -> i32:
        return _window_wheel(self.ptr)

    def fit_viewport(self) -> void:
        viewport(0, 0, self.width(), self.height())

    def destroy(self) -> void:
        _window_destroy(self.ptr)

class Shader:
    id: i32
    kind: ShaderKind
    compiled: i32

    def __init__(self, kind: ShaderKind, source: str) -> void:
        self.kind = kind
        self.id = _create_shader(kind.value)
        _shader_source(self.id, source)
        self.compiled = _compile_shader(self.id)

    def ok(self) -> bool:
        if self.id == 0:
            return False
        return self.compiled != 0

    def log(self) -> str:
        return shader_log(self.id)

    def destroy(self) -> void:
        delete_shader(self.id)
        self.id = 0
        self.compiled = 0

class Program:
    id: i32
    linked: i32

    def __init__(self, vertex: Shader, fragment: Shader) -> void:
        self.id = _create_program()
        attach_shader(self.id, vertex.id)
        attach_shader(self.id, fragment.id)
        self.linked = _link_program(self.id)

    def use(self) -> void:
        use_program(self.id)

    def ok(self) -> bool:
        if self.id == 0:
            return False
        return self.linked != 0

    def log(self) -> str:
        return program_log(self.id)

    def loc(self, name: str) -> i32:
        return uniform_location(self.id, name)

    def attrib(self, name: str) -> i32:
        return attrib_location(self.id, name)

    def bind_name(self, index: i32, name: str) -> void:
        bind_attrib(self.id, index, name)

    def set_f(self, name: str, x: f64) -> void:
        uniform1f(self.loc(name), x)

    def set_f2(self, name: str, x: f64, y: f64) -> void:
        uniform2f(self.loc(name), x, y)

    def set_f3(self, name: str, x: f64, y: f64, z: f64) -> void:
        uniform3f(self.loc(name), x, y, z)

    def set_f4(self, name: str, x: f64, y: f64, z: f64, w: f64) -> void:
        uniform4f(self.loc(name), x, y, z, w)

    def set_i(self, name: str, x: i32) -> void:
        uniform1i(self.loc(name), x)

    def set_vec(self, name: str, values: list[f64]) -> void:
        uniform_vec(self.loc(name), values)

    def set_mat4(self, name: str, values: list[f64]) -> void:
        uniform_mat4(self.loc(name), values)

    def destroy(self) -> void:
        delete_program(self.id)
        self.id = 0
        self.linked = 0

class GpuBuffer:
    id: i32
    target: i32

    def __init__(self, target: BufferTarget) -> void:
        self.target = target.value
        self.id = gen_buffer()

    def bind(self) -> void:
        bind_buffer(self.target, self.id)

    def data_f64(self, values: list[f64], usage: Usage) -> void:
        self.bind()
        buffer_data_f64(self.target, values, usage.value)

    def data_i32(self, values: list[i32], usage: Usage) -> void:
        self.bind()
        buffer_data_i32(self.target, values, usage.value)

    def data_bytes(self, values: list[byte], usage: Usage) -> void:
        self.bind()
        buffer_data_bytes(self.target, values, usage.value)

    def sub_f64(self, offset_bytes: i64, values: list[f64]) -> void:
        self.bind()
        buffer_sub_f64(self.target, offset_bytes, values)

    def destroy(self) -> void:
        delete_buffer(self.id)
        self.id = 0

class VertexArray:
    id: i32

    def __init__(self) -> void:
        self.id = gen_vao()

    def bind(self) -> void:
        bind_vao(self.id)

    def unbind(self) -> void:
        bind_vao(0)

    def attrib(self, index: i32, size: i32, stride_bytes: i32, offset_bytes: i64) -> void:
        enable_attrib(index)
        attrib_pointer(index, size, DataType.F32.value, 0, stride_bytes, offset_bytes)

    def attrib_typed(self, index: i32, size: i32, gltype: DataType, normalized: bool, stride_bytes: i32, offset_bytes: i64) -> void:
        enable_attrib(index)
        attrib_pointer(index, size, gltype.value, normalized as i32, stride_bytes, offset_bytes)

    def destroy(self) -> void:
        delete_vao(self.id)
        self.id = 0

class Texture:
    id: i32
    width: i32
    height: i32
    target: i32

    def __init__(self, width: i32, height: i32) -> void:
        self.id = gen_texture()
        self.width = width
        self.height = height
        self.target = TextureTarget.Texture2D.value
        self.bind_unit(0)
        tex_param(self.target, TexParam.MinFilter.value, Filter.Linear.value)
        tex_param(self.target, TexParam.MagFilter.value, Filter.Linear.value)
        tex_param(self.target, TexParam.WrapS.value, Wrap.ClampToEdge.value)
        tex_param(self.target, TexParam.WrapT.value, Wrap.ClampToEdge.value)

    def bind_unit(self, unit: i32) -> void:
        active_texture(TextureUnit.T0.value + unit)
        bind_texture(self.target, self.id)

    def bind(self) -> void:
        self.bind_unit(0)

    def filter(self, min_filter: Filter, mag_filter: Filter) -> void:
        self.bind()
        tex_param(self.target, TexParam.MinFilter.value, min_filter.value)
        tex_param(self.target, TexParam.MagFilter.value, mag_filter.value)

    def wrap(self, s: Wrap, t: Wrap) -> void:
        self.bind()
        tex_param(self.target, TexParam.WrapS.value, s.value)
        tex_param(self.target, TexParam.WrapT.value, t.value)

    def upload(self, pixels: list[byte]) -> void:
        self.bind()
        tex_image2d(self.target, 0, TextureFormat.RGBA.value, self.width, self.height, TextureFormat.RGBA.value, DataType.U8.value, pixels)

    def upload_rgb(self, pixels: list[byte]) -> void:
        self.bind()
        tex_image2d(self.target, 0, TextureFormat.RGB.value, self.width, self.height, TextureFormat.RGB.value, DataType.U8.value, pixels)

    def allocate(self, format: TextureFormat) -> void:
        self.bind()
        tex_storage(self.target, format.value, self.width, self.height, format.value)

    def mipmaps(self) -> void:
        self.bind()
        generate_mipmap(self.target)

    def destroy(self) -> void:
        delete_texture(self.id)
        self.id = 0

class Renderbuffer:
    id: i32
    width: i32
    height: i32

    def __init__(self, width: i32, height: i32, internal: TextureFormat) -> void:
        self.id = gen_renderbuffer()
        self.width = width
        self.height = height
        bind_renderbuffer(FramebufferTarget.Renderbuffer.value, self.id)
        renderbuffer_storage(FramebufferTarget.Renderbuffer.value, internal.value, width, height)

    def bind(self) -> void:
        bind_renderbuffer(FramebufferTarget.Renderbuffer.value, self.id)

    def destroy(self) -> void:
        delete_renderbuffer(self.id)
        self.id = 0

class Framebuffer:
    id: i32
    width: i32
    height: i32

    def __init__(self, width: i32, height: i32) -> void:
        self.id = gen_framebuffer()
        self.width = width
        self.height = height

    def bind(self) -> void:
        bind_framebuffer(FramebufferTarget.Framebuffer.value, self.id)

    def unbind(self) -> void:
        bind_framebuffer(FramebufferTarget.Framebuffer.value, 0)

    def color(self, texture: Texture) -> void:
        self.bind()
        framebuffer_texture2d(FramebufferTarget.Framebuffer.value, Attachment.Color0.value, texture.target, texture.id, 0)

    def depth_texture(self, texture: Texture) -> void:
        self.bind()
        framebuffer_texture2d(FramebufferTarget.Framebuffer.value, Attachment.Depth.value, texture.target, texture.id, 0)

    def depth(self, buffer: Renderbuffer) -> void:
        self.bind()
        framebuffer_renderbuffer(FramebufferTarget.Framebuffer.value, Attachment.Depth.value, FramebufferTarget.Renderbuffer.value, buffer.id)

    def ok(self) -> bool:
        self.bind()
        return check_framebuffer(FramebufferTarget.Framebuffer.value) == FramebufferStatus.Complete.value

    def status(self) -> i32:
        self.bind()
        return check_framebuffer(FramebufferTarget.Framebuffer.value)

    def destroy(self) -> void:
        delete_framebuffer(self.id)
        self.id = 0

class Mesh:
    vao: VertexArray
    vbo: GpuBuffer
    ibo: GpuBuffer
    count: i32
    index_count: i32
    stride: i32
    indexed: i32

    def __init__(self, vertices: list[f64], floats_per_vertex: i32) -> void:
        self.vao = VertexArray()
        self.vbo = GpuBuffer(BufferTarget.Array)
        self.ibo = GpuBuffer(BufferTarget.Element)
        self.stride = floats_per_vertex * 4
        n: i64 = len(vertices)
        if floats_per_vertex <= 0:
            self.count = 0
        else:
            self.count = (n as i32) // floats_per_vertex
        self.index_count = 0
        self.indexed = 0
        self.vao.bind()
        self.vbo.data_f64(vertices, Usage.StaticDraw)
        if floats_per_vertex <= 4:
            self.vao.attrib(0, floats_per_vertex, self.stride, 0 as i64)

    def layout(self, index: i32, size: i32, offset_floats: i32) -> void:
        self.vao.bind()
        self.vbo.bind()
        self.vao.attrib(index, size, self.stride, (offset_floats * 4) as i64)

    def indices(self, values: list[i32]) -> void:
        self.vao.bind()
        self.ibo.data_i32(values, Usage.StaticDraw)
        self.index_count = len(values) as i32
        self.indexed = 1

    def draw(self, mode: Primitive) -> void:
        self.vao.bind()
        if self.indexed != 0:
            draw_elements(mode.value, self.index_count, DataType.U32.value, 0 as i64)
        else:
            draw_arrays(mode.value, 0, self.count)

    def destroy(self) -> void:
        self.vao.destroy()
        self.vbo.destroy()
        self.ibo.destroy()

def available() -> bool:
    return _available() as bool

def color_depth() -> i32:
    return ClearMask.Color.value + ClearMask.Depth.value

def color_depth_stencil() -> i32:
    return ClearMask.Color.value + ClearMask.Depth.value + ClearMask.Stencil.value

def enable_cap(cap: Capability) -> void:
    enable(cap.value)

def disable_cap(cap: Capability) -> void:
    disable(cap.value)

def set_blend(src: BlendFactor, dst: BlendFactor) -> void:
    enable(Capability.Blend.value)
    blend_func(src.value, dst.value)

def set_depth(func: DepthFn) -> void:
    enable(Capability.DepthTest.value)
    depth_func(func.value)

def depth_write(enabled: bool) -> void:
    _depth_mask(enabled as i32)

def color_write(r: bool, g: bool, b: bool, a: bool) -> void:
    _color_mask(r as i32, g as i32, b as i32, a as i32)

def set_cull(face: Face) -> void:
    enable(Capability.CullFace.value)
    cull_face(face.value)

def wireframe(on: bool) -> void:
    if on:
        polygon_mode(Face.FrontAndBack.value, Polygon.Line.value)
    else:
        polygon_mode(Face.FrontAndBack.value, Polygon.Filled.value)

def vendor() -> str:
    return get_string(Info.Vendor.value)

def renderer() -> str:
    return get_string(Info.Renderer.value)

def version() -> str:
    return get_string(Info.Version.value)

def shading_language() -> str:
    return get_string(Info.ShadingLanguage.value)

def ok() -> bool:
    return get_error() == GlError.NoError.value

def capture(x: i32, y: i32, width: i32, height: i32) -> list[byte]:
    return read_pixels(x, y, width, height, TextureFormat.RGBA.value, DataType.U8.value)

def program(vertex_src: str, fragment_src: str) -> Program:
    vs = Shader(ShaderKind.Vertex, vertex_src)
    fs = Shader(ShaderKind.Fragment, fragment_src)
    return Program(vs, fs)

def texture_color(width: i32, height: i32, format: TextureFormat) -> Texture:
    tex = Texture(width, height)
    tex.allocate(format)
    return tex
