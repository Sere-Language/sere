# OpenGL 2.1+ with a native window. Import with: import gl
# Windows hosts get a real WGL context. Other hosts: available() == False.
# Pair with `matrix` for camera / MVP uniforms (list[f64], 16 values, row-major).
#
#   win = gl.Window("Sere GL", 800, 600)
#   prog = gl.program(vert, frag)
#   mesh = gl.Mesh(vertices, 3)
#   while win.poll():
#       if win.key(gl.Key.Escape):
#           break
#       gl.clear_color(0.08, 0.09, 0.12, 1.0)
#       gl.clear(gl.color_depth())
#       win.fit_viewport()
#       prog.use()
#       mesh.draw(gl.Primitive.Triangles)
#       win.swap()

