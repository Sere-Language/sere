# Qt 6 Widgets. Import with: import qt6
# Linked automatically when this module is imported.
# If Qt6 was not present at compiler build, available() is False and calls no-op.
#
#   app = qt6.Application()
#   app.apply_dark()
#   win = qt6.Window("Sere")
#   root = qt6.VBox(win)
#   label = qt6.Label(win, "Hello")
#   root.add(label)
#   win.show()
#   return app.exec()
#
# Styles: app.set_style("Fusion"), app.set_stylesheet(qss), widget.set_stylesheet(qss),
# widget.set_object_name("sidebar") and widget.set_class("primary") for QSS selectors,
# dark_theme().apply(app), qss_theme(...), accent_theme(color), effects, and animations.

