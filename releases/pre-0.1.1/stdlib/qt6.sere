class Menu:
    ptr: Ptr[i8]

    def add_menu(self, title: str) -> Menu:
        child: Menu = Menu()
        child.ptr = _menu_add(self.ptr, title)
        return child

    def add(self, text: str, shortcut: str) -> Action:
        return action_from(_menu_action(self.ptr, text, shortcut))

    def add_separator(self) -> void:
        _menu_separator(self.ptr)

    def popup(self, x: i32, y: i32) -> void:
        _menu_popup(self.ptr, x, y)

class Action:
    ptr: Ptr[i8]

    def triggered(self) -> bool:
        return _take(self.ptr, Event.Triggered.value) as bool

    def set_checkable(self, on: bool) -> void:
        _action_checkable(self.ptr, on as i32)

    def checked(self) -> bool:
        return _action_checked(self.ptr) as bool

    def set_enabled(self, on: bool) -> void:
        _action_enabled(self.ptr, on as i32)

    def set_text(self, text: str) -> void:
        _action_text(self.ptr, text)

    def set_shortcut(self, seq: str) -> void:
        _action_shortcut(self.ptr, seq)

