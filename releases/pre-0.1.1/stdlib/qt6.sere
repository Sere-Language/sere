enum Event:
    Clicked = 1
    Toggled = 2
    Text = 3
    Return = 4
    Value = 5
    Index = 6
    Timeout = 7
    Row = 8
    Tab = 9
    Triggered = 10
    Changed = 11
    Cell = 12

enum Alignment:
    Left = 1
    Right = 2
    HCenter = 4
    Justify = 8
    Top = 32
    VCenter = 128
    Center = 132

enum Orientation:
    Horizontal = 0
    Vertical = 1

enum EchoMode:
    Normal = 0
    NoEcho = 1
    Password = 2

enum Cursor:
    Arrow = 0
    IBeam = 1
    Wait = 3
    Cross = 2
    PointingHand = 13
    SizeAll = 9
    Forbidden = 10

enum Weight:
    Thin = 100
    Light = 300
    Normal = 400
    Medium = 500
    DemiBold = 600
    Bold = 700
    Black = 900

enum PaletteRole:
    WindowText = 0
    Button = 1
    Light = 2
    Mid = 4
    Text = 6
    BrightText = 7
    ButtonText = 8
    Base = 9
    Window = 10
    Highlight = 12
    HighlightedText = 13
    ToolTipBase = 14
    ToolTipText = 15
    PlaceholderText = 20

enum SizePolicy:
    Fixed = 0
    Minimum = 1
    Maximum = 4
    Preferred = 5
    Expanding = 7
    Ignored = 13

enum FrameShape:
    NoFrame = 0
    Box = 1
    Panel = 2
    Styled = 6
    HLine = 4
    VLine = 5

enum DockArea:
    Left = 1
    Right = 2
    Top = 4
    Bottom = 8

enum MessageKind:
    About = 0
    Info = 1
    Warn = 2
    Error = 3
    Question = 4

enum ButtonKind:
    Push = 0
    Check = 1
    Radio = 2
    Tool = 3

enum Attr:
    NoSystemBackground = 9
    TransparentForMouse = 51
    DeleteOnClose = 55
    Hover = 74
    QuitOnClose = 76
    AcceptDrops = 78
    StyledBackground = 93
    Translucent = 120

enum WinState:
    Normal = 0
    Minimized = 1
    Maximized = 2
    FullScreen = 3

enum FocusPolicy:
    NoFocus = 0
    Tab = 1
    Click = 2
    Strong = 11
    Wheel = 15

enum ContextPolicy:
    NoMenu = 0
    Default = 1
    Actions = 2
    Custom = 3
    Prevent = 4

enum TabPos:
    North = 0
    South = 1
    West = 2
    East = 3

enum Ticks:
    NoTicks = 0
    Both = 1
    Above = 2
    Below = 3

enum ButtonRole:
    Invalid = -1
    Accept = 0
    Reject = 1
    Destructive = 2
    Action = 3
    Help = 4
    Yes = 5
    No = 6
    Apply = 8
    Reset = 7

enum StdButton:
    Ok = 1024
    Save = 2048
    Cancel = 4194304
    Close = 2097152
    Discard = 8388608
    Apply = 33554432
    Reset = 67108864
    Help = 16777216
    Yes = 16384
    No = 65536

enum Modality:
    NonModal = 0
    Window = 1
    Application = 2

class Color:
    r: i32
    g: i32
    b: i32
    a: i32

    def __init__(self, r: i32, g: i32, b: i32, a: i32) -> void:
        self.r = r
        self.g = g
        self.b = b
        self.a = a

    def qss(self) -> str:
        return "rgba(" + str(self.r) + ", " + str(self.g) + ", " + str(self.b) + ", " + str(self.a) + ")"

class Font:
    family: str
    size: i32
    weight: i32
    italic: i32

    def __init__(self, family: str, size: i32, weight: i32, italic: i32) -> void:
        self.family = family
        self.size = size
        self.weight = weight
        self.italic = italic

class Widget:
    ptr: Ptr[i8]

    def resize(self, width: i32, height: i32) -> void:
        _resize(self.ptr, width, height)

    def move(self, x: i32, y: i32) -> void:
        _move(self.ptr, x, y)

    def x(self) -> i32:
        return _x(self.ptr)

    def y(self) -> i32:
        return _y(self.ptr)

    def width(self) -> i32:
        return _width(self.ptr)

    def height(self) -> i32:
        return _height(self.ptr)

    def show(self) -> void:
        _show(self.ptr)

    def hide(self) -> void:
        _hide(self.ptr)

    def close(self) -> void:
        _close(self.ptr)

    def raise_front(self) -> void:
        _raise(self.ptr)

    def lower_back(self) -> void:
        _lower(self.ptr)

    def update(self) -> void:
        _update(self.ptr)

    def focus(self) -> void:
        _focus(self.ptr)

    def set_title(self, title: str) -> void:
        _set_title(self.ptr, title)

    def title(self) -> str:
        return _title(self.ptr)

    def set_enabled(self, enabled: bool) -> void:
        _set_enabled(self.ptr, enabled as i32)

    def set_visible(self, visible: bool) -> void:
        _set_visible(self.ptr, visible as i32)

    def set_stylesheet(self, qss: str) -> void:
        _set_qss(self.ptr, qss)

    def stylesheet(self) -> str:
        return _qss(self.ptr)

    def set_object_name(self, name: str) -> void:
        _set_object_name(self.ptr, name)

    def set_property(self, key: str, value: str) -> void:
        _set_property(self.ptr, key, value)

    def set_tooltip(self, text: str) -> void:
        _set_tooltip(self.ptr, text)

    def set_cursor(self, shape: Cursor) -> void:
        _set_cursor(self.ptr, shape.value)

    def set_font(self, font: Font) -> void:
        _set_font(self.ptr, font.family, font.size, font.weight, font.italic)

    def set_color(self, role: PaletteRole, color: Color) -> void:
        _set_palette_color(self.ptr, role.value, color.r, color.g, color.b, color.a)

    def set_min_size(self, width: i32, height: i32) -> void:
        _set_min_size(self.ptr, width, height)

    def set_max_size(self, width: i32, height: i32) -> void:
        _set_max_size(self.ptr, width, height)

    def set_fixed_size(self, width: i32, height: i32) -> void:
        _set_fixed_size(self.ptr, width, height)

    def set_margins(self, left: i32, top: i32, right: i32, bottom: i32) -> void:
        _set_margins(self.ptr, left, top, right, bottom)

    def set_size_policy(self, horizontal: SizePolicy, vertical: SizePolicy) -> void:
        _set_size_policy(self.ptr, horizontal.value, vertical.value)

    def set_icon(self, path: str) -> void:
        _set_icon(self.ptr, path)

    def set_window_icon(self, path: str) -> void:
        _set_window_icon(self.ptr, path)

    def set_flags(self, flags: i32) -> void:
        _set_flags(self.ptr, flags)

    def set_modality(self, modality: i32) -> void:
        _set_modality(self.ptr, modality)

    def take(self, kind: Event) -> bool:
        return _take(self.ptr, kind.value) as bool

    def last_int(self) -> i32:
        return _last_int(self.ptr)

    def last_text(self) -> str:
        return _last_text(self.ptr)

    def set_layout(self, layout: Layout) -> void:
        _set_layout(self.ptr, layout.ptr)

    def set_parent(self, parent: Widget) -> void:
        _set_parent(self.ptr, parent.ptr)

    def set_attr(self, attr: Attr, on: bool) -> void:
        _set_attr(self.ptr, attr.value, on as i32)

    def set_class(self, name: str) -> void:
        _set_property(self.ptr, "class", name)

    def add_stylesheet(self, qss: str) -> void:
        _set_qss(self.ptr, _qss(self.ptr) + "\n" + qss)

    def set_opacity(self, value: f64) -> void:
        _set_opacity(self.ptr, value)

    def enabled(self) -> bool:
        return _enabled(self.ptr) as bool

    def visible(self) -> bool:
        return _visible(self.ptr) as bool

    def set_state(self, state: WinState) -> void:
        _set_state(self.ptr, state.value)

    def state(self) -> i32:
        return _state(self.ptr)

    def center(self) -> void:
        _center(self.ptr)

    def adjust(self) -> void:
        _adjust(self.ptr)

    def activate(self) -> void:
        _activate(self.ptr)

    def set_status_tip(self, text: str) -> void:
        _set_status_tip(self.ptr, text)

    def set_whats_this(self, text: str) -> void:
        _set_whats_this(self.ptr, text)

    def set_focus_policy(self, policy: FocusPolicy) -> void:
        _set_focus_policy(self.ptr, policy.value)

    def set_context_policy(self, policy: ContextPolicy) -> void:
        _set_context_policy(self.ptr, policy.value)

    def set_accept_drops(self, on: bool) -> void:
        _set_accept_drops(self.ptr, on as i32)

    def set_mouse_tracking(self, on: bool) -> void:
        _set_mouse_tracking(self.ptr, on as i32)

    def set_effect_opacity(self, value: f64) -> void:
        _effect_opacity(self.ptr, value)

    def set_blur(self, radius: f64) -> void:
        _effect_blur(self.ptr, radius)

    def set_shadow(self, dx: i32, dy: i32, blur: i32, color: Color) -> void:
        _effect_shadow(self.ptr, dx, dy, blur, color.r, color.g, color.b, color.a)

    def set_colorize(self, color: Color, strength: f64) -> void:
        _effect_colorize(self.ptr, color.r, color.g, color.b, strength)

    def clear_effect(self) -> void:
        _effect_clear(self.ptr)

    def fade(self, from_value: f64, to_value: f64, ms: i32) -> void:
        _anim_opacity(self.ptr, from_value, to_value, ms)

    def animate_to(self, x: i32, y: i32, width: i32, height: i32, ms: i32) -> void:
        _anim_move(self.ptr, x, y, width, height, ms)

    def maximize(self) -> void:
        _set_state(self.ptr, WinState.Maximized.value)

    def minimize(self) -> void:
        _set_state(self.ptr, WinState.Minimized.value)

    def fullscreen(self) -> void:
        _set_state(self.ptr, WinState.FullScreen.value)

    def restore(self) -> void:
        _set_state(self.ptr, WinState.Normal.value)

class Application:
    ptr: Ptr[i8]

    def __init__(self) -> void:
        self.ptr = _app_new()

    def exec(self) -> i32:
        return _app_exec(self.ptr)

    def process(self) -> void:
        _app_process(self.ptr)

    def quit(self) -> void:
        _app_quit(self.ptr)

    def set_name(self, name: str) -> void:
        _app_set_name(self.ptr, name)

    def set_org(self, name: str) -> void:
        _app_set_org(self.ptr, name)

    def set_style(self, name: str) -> void:
        _app_set_style(self.ptr, name)

    def set_stylesheet(self, qss: str) -> void:
        _app_set_qss(self.ptr, qss)

    def stylesheet(self) -> str:
        return _app_qss(self.ptr)

    def set_font(self, font: Font) -> void:
        _app_set_font(self.ptr, font.family, font.size, font.weight, font.italic)

    def apply_dark(self) -> void:
        _app_set_style(self.ptr, "Fusion")
        _app_palette_dark(self.ptr)
        _app_set_qss(self.ptr, dark_qss())

    def apply_light(self) -> void:
        _app_set_style(self.ptr, "Fusion")
        _app_palette_light(self.ptr)
        _app_set_qss(self.ptr, light_qss())

    def apply_theme(self, theme: Theme) -> void:
        theme.apply(self)

    def set_accent(self, color: Color) -> void:
        _app_palette_accent(self.ptr, color.r, color.g, color.b)

    def add_stylesheet(self, qss: str) -> void:
        _app_set_qss(self.ptr, _app_qss(self.ptr) + "\n" + qss)

    def apply_accent(self, color: Color) -> void:
        _app_palette_accent(self.ptr, color.r, color.g, color.b)

    def apply_theme(self, theme: Theme) -> void:
        theme.apply(self)

    def add_stylesheet(self, qss: str) -> void:
        _app_set_qss(self.ptr, _app_qss(self.ptr) + "\n" + qss)

class Window(Widget):
    def __init__(self, title: str) -> void:
        self.ptr = _window_new(title)

    def central(self) -> Ptr[i8]:
        return _window_central(self.ptr)

    def set_central(self, widget: Widget) -> void:
        _window_set_central(self.ptr, widget.ptr)

    def menu_bar(self) -> Ptr[i8]:
        return _menu_bar(self.ptr)

    def status_bar(self) -> Ptr[i8]:
        return _status_bar(self.ptr)

    def show_status(self, text: str, ms: i32) -> void:
        _status_message(_status_bar(self.ptr), text, ms)

    def add_toolbar(self, title: str) -> Ptr[i8]:
        return _tool_bar(self.ptr, title)

    def add_dock(self, widget: Widget, area: DockArea) -> void:
        _add_dock(self.ptr, widget.ptr, area.value)

    def set_dock_nesting(self, on: bool) -> void:
        _dock_nesting(self.ptr, on as i32)

    def menu(self, title: str) -> Menu:
        return menu_from(_menu_bar(self.ptr), title)

    def toolbar(self, title: str) -> Widget:
        return wrap(_tool_bar(self.ptr, title))

class Dialog(Widget):
    def __init__(self, parent: Widget, title: str) -> void:
        self.ptr = _dialog_new(parent.ptr, title)

    def exec(self) -> i32:
        return _dialog_exec(self.ptr)

    def accept(self) -> void:
        _dialog_accept(self.ptr)

    def reject(self) -> void:
        _dialog_reject(self.ptr)

class Label(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _label_new(parent.ptr, text)

    def set_text(self, text: str) -> void:
        _label_set_text(self.ptr, text)

    def set_alignment(self, align: Alignment) -> void:
        _label_set_align(self.ptr, align.value)

    def set_wrap(self, wrap: bool) -> void:
        _label_set_wrap(self.ptr, wrap as i32)

    def set_pixmap(self, path: str) -> void:
        _label_set_pixmap(self.ptr, path)

    def set_html_links(self, on: bool) -> void:
        _label_open_links(self.ptr, on as i32)

    def set_rich(self, on: bool) -> void:
        _label_open_links(self.ptr, on as i32)

class Button(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _button_new(parent.ptr, text, ButtonKind.Push.value)

    def set_text(self, text: str) -> void:
        _button_set_text(self.ptr, text)

    def set_checkable(self, on: bool) -> void:
        _button_set_checkable(self.ptr, on as i32)

    def set_checked(self, on: bool) -> void:
        _button_set_checked(self.ptr, on as i32)

    def checked(self) -> bool:
        return _button_checked(self.ptr) as bool

    def clicked(self) -> bool:
        return _take(self.ptr, Event.Clicked.value) as bool

class CheckBox(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _button_new(parent.ptr, text, ButtonKind.Check.value)

    def set_text(self, text: str) -> void:
        _button_set_text(self.ptr, text)

    def set_checked(self, on: bool) -> void:
        _button_set_checked(self.ptr, on as i32)

    def checked(self) -> bool:
        return _button_checked(self.ptr) as bool

    def toggled(self) -> bool:
        return _take(self.ptr, Event.Toggled.value) as bool

class Radio(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _button_new(parent.ptr, text, ButtonKind.Radio.value)

    def set_text(self, text: str) -> void:
        _button_set_text(self.ptr, text)

    def set_checked(self, on: bool) -> void:
        _button_set_checked(self.ptr, on as i32)

    def checked(self) -> bool:
        return _button_checked(self.ptr) as bool

class ToolButton(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _button_new(parent.ptr, text, ButtonKind.Tool.value)

    def set_text(self, text: str) -> void:
        _button_set_text(self.ptr, text)

    def clicked(self) -> bool:
        return _take(self.ptr, Event.Clicked.value) as bool

class LineEdit(Widget):
    def __init__(self, parent: Widget, text: str) -> void:
        self.ptr = _line_new(parent.ptr, text)

    def set_text(self, text: str) -> void:
        _line_set_text(self.ptr, text)

    def text(self) -> str:
        return _line_text(self.ptr)

    def set_placeholder(self, text: str) -> void:
        _line_placeholder(self.ptr, text)

    def set_password(self) -> void:
        _line_echo(self.ptr, EchoMode.Password.value)

    def set_read_only(self, on: bool) -> void:
        _line_read_only(self.ptr, on as i32)

    def edited(self) -> bool:
        return _take(self.ptr, Event.Text.value) as bool

    def submitted(self) -> bool:
        return _take(self.ptr, Event.Return.value) as bool

    def set_max_length(self, n: i32) -> void:
        _line_max_len(self.ptr, n)

    def select_all(self) -> void:
        _line_select_all(self.ptr)

    def clear(self) -> void:
        _line_clear(self.ptr)

    def set_completer(self, items: str) -> void:
        _line_completer(self.ptr, items)

    def set_echo(self, mode: EchoMode) -> void:
        _line_echo(self.ptr, mode.value)

class TextEdit(Widget):
