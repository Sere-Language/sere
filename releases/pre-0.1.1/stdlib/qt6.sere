    def set_standard(self, buttons: i32) -> void:
        _buttonbox_std(self.ptr, buttons)

class Theme:
    name: str
    qss: str
    dark: i32

    def apply(self, app: Application) -> void:
        app.set_style("Fusion")
        app.set_stylesheet(self.qss)
        if self.dark != 0:
            _app_palette_dark(app.ptr)
        else:
            _app_palette_light(app.ptr)

def available() -> bool:
    return _available() as bool

def black() -> Color:
    return Color(0, 0, 0, 255)

def white() -> Color:
    return Color(255, 255, 255, 255)

def red() -> Color:
    return Color(200, 40, 40, 255)

def accent() -> Color:
    return Color(88, 101, 242, 255)

def panel() -> Color:
    return Color(32, 32, 36, 255)

def wrap(ptr: Ptr[i8]) -> Widget:
    widget: Widget = Widget()
    widget.ptr = ptr
    return widget

def pane(parent: Widget) -> Widget:
    widget: Widget = Widget()
    widget.ptr = _widget_new(parent.ptr)
    return widget

def menu_from(bar: Ptr[i8], title: str) -> Menu:
    menu: Menu = Menu()
    menu.ptr = _menu_add(bar, title)
    return menu

def action_from(ptr: Ptr[i8]) -> Action:
    action: Action = Action()
    action.ptr = ptr
    return action

def open_file(parent: Widget, caption: str, filter: str) -> str:
    return _file_open(parent.ptr, caption, filter)

def save_file(parent: Widget, caption: str, filter: str) -> str:
    return _file_save(parent.ptr, caption, filter)

def open_dir(parent: Widget, caption: str) -> str:
    return _dir_open(parent.ptr, caption)

def message(parent: Widget, kind: MessageKind, title: str, text: str) -> i32:
    return _message(parent.ptr, kind.value, title, text)

def ask_text(parent: Widget, title: str, label: str) -> str:
    return _input_text(parent.ptr, title, label)

def toolbar_add(bar: Ptr[i8], action: Ptr[i8]) -> void:
    _toolbar_add(bar, action)

def toolbar_add_action(bar: Widget, action: Action) -> void:
    _toolbar_add(bar.ptr, action.ptr)

def inner_vbox() -> Layout:
    layout: Layout = Layout()
    layout.ptr = _vbox_bare()
    return layout

def inner_hbox() -> Layout:
    layout: Layout = Layout()
    layout.ptr = _hbox_bare()
    return layout

def rgb(r: i32, g: i32, b: i32) -> Color:
    return Color(r, g, b, 255)

def font(family: str, size: i32) -> Font:
    return Font(family, size, Weight.Normal.value, 0)

def bold(family: str, size: i32) -> Font:
    return Font(family, size, Weight.Bold.value, 0)

def pick_color(parent: Widget, color: Color) -> i32:
    return _color_pick(parent.ptr, color.r, color.g, color.b)

def pick_font(parent: Widget) -> str:
    return _font_pick(parent.ptr)

def unpack_rgb(packed: i32) -> Color:
    return Color((packed / 65536) % 256, (packed / 256) % 256, packed % 256, 255)

def dark_qss() -> str:
    return """
QWidget { background: #202024; color: #e6e6ea; font-size: 13px; }
QMainWindow, QDialog, QMdiArea, QWizard { background: #202024; }
QToolTip { background: #2a2a31; color: #e6e6ea; border: 1px solid #3d3d46; padding: 6px; border-radius: 6px; }
QMenuBar { background: #1a1a1e; color: #e6e6ea; }
QMenuBar::item:selected { background: #3d3d46; }
QMenu { background: #25252b; color: #e6e6ea; border: 1px solid #3d3d46; padding: 4px; }
QMenu::item { padding: 6px 18px; border-radius: 4px; }
QMenu::item:selected { background: #5865f2; }
QMenu::separator { height: 1px; background: #3d3d46; margin: 4px 8px; }
QStatusBar { background: #1a1a1e; color: #9a9aa3; }
QToolBar { background: #1a1a1e; border: none; spacing: 6px; padding: 4px; }
QPushButton, QToolButton, QCommandLinkButton {
  background: #32323a; color: #e6e6ea; border: 1px solid #3d3d46;
  border-radius: 6px; padding: 6px 12px;
}
QPushButton:hover, QToolButton:hover { background: #3d3d46; border-color: #5865f2; }
QPushButton:pressed { background: #5865f2; }
QPushButton:disabled { color: #6a6a73; }
QPushButton:checked, QToolButton:checked { background: #5865f2; border-color: #5865f2; }
QPushButton[class="primary"] { background: #5865f2; border-color: #5865f2; color: #ffffff; }
QPushButton[class="primary"]:hover { background: #6b76f4; }
QPushButton[class="danger"] { background: #c84040; border-color: #c84040; color: #ffffff; }
QPushButton[class="ghost"] { background: transparent; border: 1px solid #3d3d46; }
QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser, QSpinBox, QDoubleSpinBox, QComboBox, QDateEdit, QTimeEdit, QFontComboBox {
  background: #141418; color: #e6e6ea; border: 1px solid #3d3d46;
  border-radius: 6px; padding: 6px 8px; selection-background-color: #5865f2;
}
QLineEdit:focus, QTextEdit:focus, QComboBox:focus, QPlainTextEdit:focus { border: 1px solid #5865f2; }
QLineEdit:disabled, QTextEdit:disabled { color: #6a6a73; }
QCheckBox, QRadioButton { spacing: 8px; }
QCheckBox::indicator, QRadioButton::indicator {
  width: 16px; height: 16px; border: 1px solid #3d3d46; background: #141418; border-radius: 4px;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background: #5865f2; border-color: #5865f2; }
QSlider::groove:horizontal { height: 6px; background: #3d3d46; border-radius: 3px; }
QSlider::handle:horizontal { width: 14px; margin: -5px 0; background: #5865f2; border-radius: 7px; }
QSlider::groove:vertical { width: 6px; background: #3d3d46; border-radius: 3px; }
QSlider::handle:vertical { height: 14px; margin: 0 -5px; background: #5865f2; border-radius: 7px; }
QProgressBar { background: #141418; border: 1px solid #3d3d46; border-radius: 6px; text-align: center; color: #e6e6ea; }
QProgressBar::chunk { background: #5865f2; border-radius: 5px; }
QTabWidget::pane { border: 1px solid #3d3d46; background: #202024; }
QTabBar::tab { background: #1a1a1e; color: #9a9aa3; padding: 8px 14px; border-top-left-radius: 6px; border-top-right-radius: 6px; }
QTabBar::tab:selected { background: #32323a; color: #e6e6ea; }
QTabBar::tab:hover { color: #e6e6ea; }
QHeaderView::section { background: #1a1a1e; color: #9a9aa3; border: none; padding: 6px; }
QTableView, QListView, QTreeView, QColumnView {
  background: #141418; alternate-background-color: #1c1c22; border: 1px solid #3d3d46;
  selection-background-color: #5865f2; outline: none;
}
QTableView::item:hover, QListView::item:hover, QTreeView::item:hover { background: #2a2a31; }
QScrollBar:vertical { width: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:vertical { background: #3d3d46; border-radius: 5px; min-height: 24px; }
QScrollBar:horizontal { height: 10px; background: transparent; margin: 2px; }
QScrollBar::handle:horizontal { background: #3d3d46; border-radius: 5px; min-width: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; }
QGroupBox { border: 1px solid #3d3d46; border-radius: 8px; margin-top: 12px; padding: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9a9aa3; }
QSplitter::handle { background: #3d3d46; }
QDockWidget { titlebar-close-icon: none; }
QDockWidget::title { background: #1a1a1e; padding: 6px; }
QFrame#sidebar { background: #1a1a1e; border: none; }
QToolBox { background: #202024; }
QToolBox::tab { background: #1a1a1e; border-radius: 6px; padding: 8px; }
QToolBox::tab:selected { background: #32323a; }
QCalendarWidget QWidget { background: #141418; }
QCalendarWidget QAbstractItemView:enabled { selection-background-color: #5865f2; }
QLCDNumber { color: #5865f2; background: #141418; border: 1px solid #3d3d46; border-radius: 6px; }
QDialogButtonBox QPushButton { min-width: 88px; }
QAbstractSpinBox::up-button, QAbstractSpinBox::down-button { background: #32323a; border: none; }
QComboBox::drop-down { border: none; width: 24px; }
QComboBox QAbstractItemView { background: #25252b; selection-background-color: #5865f2; }
"""

def light_qss() -> str:
    return """
QWidget { background: #f4f4f7; color: #1b1b1f; font-size: 13px; }
QMainWindow, QDialog, QMdiArea { background: #f4f4f7; }
QToolTip { background: #ffffff; color: #1b1b1f; border: 1px solid #d0d0d8; padding: 6px; border-radius: 6px; }
QMenuBar { background: #ffffff; }
QMenu { background: #ffffff; border: 1px solid #d0d0d8; }
QMenu::item:selected { background: #5865f2; color: #ffffff; }
QPushButton, QToolButton {
  background: #ffffff; border: 1px solid #d0d0d8; border-radius: 6px; padding: 6px 12px;
}
QPushButton:hover { border-color: #5865f2; }
QPushButton[class="primary"] { background: #5865f2; color: #ffffff; border-color: #5865f2; }
QPushButton[class="danger"] { background: #c84040; color: #ffffff; border-color: #c84040; }
QLineEdit, QTextEdit, QPlainTextEdit, QTextBrowser, QComboBox, QSpinBox, QDateEdit, QTimeEdit, QFontComboBox {
  background: #ffffff; border: 1px solid #d0d0d8; border-radius: 6px; padding: 6px 8px;
  selection-background-color: #5865f2;
}
QLineEdit:focus, QComboBox:focus { border: 1px solid #5865f2; }
QProgressBar { background: #ffffff; border: 1px solid #d0d0d8; border-radius: 6px; text-align: center; }
QProgressBar::chunk { background: #5865f2; border-radius: 5px; }
QTabBar::tab { background: #ececf0; padding: 8px 14px; border-top-left-radius: 6px; border-top-right-radius: 6px; }
QTabBar::tab:selected { background: #ffffff; }
QHeaderView::section { background: #ececf0; border: none; padding: 6px; }
QTableView, QListView, QTreeView { background: #ffffff; alternate-background-color: #f4f4f7; border: 1px solid #d0d0d8; }
QScrollBar::handle:vertical, QScrollBar::handle:horizontal { background: #c8c8d0; border-radius: 5px; }
QGroupBox { border: 1px solid #d0d0d8; border-radius: 8px; margin-top: 12px; padding: 8px; }
QSplitter::handle { background: #d0d0d8; }
QFrame#sidebar { background: #ffffff; }
QSlider::handle:horizontal, QSlider::handle:vertical { background: #5865f2; border-radius: 7px; }
"""

def qss_theme(bg: Color, fg: Color, muted: Color, panel: Color, field: Color, accent_color: Color) -> str:
    a: str = accent_color.qss()
    return "QWidget { background: " + bg.qss() + "; color: " + fg.qss() + "; font-size: 13px; }\nQMainWindow, QDialog { background: " + bg.qss() + "; }\nQPushButton { background: " + panel.qss() + "; color: " + fg.qss() + "; border: 1px solid " + muted.qss() + "; border-radius: 6px; padding: 6px 12px; }\nQPushButton:hover { border-color: " + a + "; }\nQLineEdit, QTextEdit, QComboBox { background: " + field.qss() + "; color: " + fg.qss() + "; border: 1px solid " + muted.qss() + "; border-radius: 6px; padding: 6px 8px; selection-background-color: " + a + "; }\nQProgressBar::chunk { background: " + a + "; }\nQSlider::handle:horizontal { background: " + a + "; }\n"

def accent_theme(color: Color) -> Theme:
    theme: Theme = Theme()
    theme.name = "accent"
    theme.qss = qss_theme(panel(), white(), Color(61, 61, 70, 255), Color(50, 50, 58, 255), Color(20, 20, 24, 255), color)
    theme.dark = 1
    return theme

def dark_theme() -> Theme:
    theme: Theme = Theme()
    theme.name = "dark"
    theme.qss = dark_qss()
    theme.dark = 1
    return theme

def light_theme() -> Theme:
    theme: Theme = Theme()
    theme.name = "light"
    theme.qss = light_qss()
    theme.dark = 0
    return theme
