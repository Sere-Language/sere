# Host and process info. Import with: import sys
# Compile-time flags (preprocessor):
#   if __windows__: ...
#   if cfg!(linux): ...
# Runtime: sys.platform(), sys.family, sys.is_windows()

extern "C" "sere_sys_platform"
def platform() -> str

extern "C" "sere_sys_arch"
def arch() -> str

extern "C" "sere_sys_version"
def version() -> str

extern "C" "sere_sys_pid"
def pid() -> i32

extern "C" "sere_sys_cpu_count"
def cpu_count() -> i32

enum Family:
    Windows
    Linux
    Macos
    Unknown

enum Arch:
    X86_64
    Arm64
    Unknown

def is_windows() -> bool:
    return platform() == "windows"

def is_macos() -> bool:
    return platform() == "macos"

def is_linux() -> bool:
    return platform() == "linux"

def is_unix() -> bool:
    return is_linux() or is_macos()

def family() -> Family:
    if is_windows():
        return Family.Windows
    if is_macos():
        return Family.Macos
    if is_linux():
        return Family.Linux
    return Family.Unknown

def cpu() -> Arch:
    kind: str = arch()
    if kind == "x86_64":
        return Arch.X86_64
    if kind == "arm64":
        return Arch.Arm64
    return Arch.Unknown
