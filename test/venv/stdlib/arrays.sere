# Packed f64 arrays: zeros, stats, dot, matmul. Import with: import arrays

extern "C" "sere_f64_full"
def full(length: i64, fill: f64) -> list[f64]

extern "C" "sere_f64_copy"
def copy(values: list[f64]) -> list[f64]

extern "C" "sere_f64_reverse"
def reverse(values: list[f64]) -> list[f64]

extern "C" "sere_f64_concat"
def concat(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_add"
def add(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_sub"
def sub(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_mul"
def mul(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_div"
def div(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_scale"
def scale(values: list[f64], factor: f64) -> list[f64]

extern "C" "sere_f64_abs"
def abs(values: list[f64]) -> list[f64] # type: ignore

extern "C" "sere_f64_clip"
def clip(values: list[f64], low: f64, high: f64) -> list[f64]

extern "C" "sere_f64_linspace"
def linspace(start: f64, stop: f64, count: i64) -> list[f64]

extern "C" "sere_f64_sum"
def sum(values: list[f64]) -> f64

extern "C" "sere_f64_mean"
def mean(values: list[f64]) -> f64

extern "C" "sere_f64_var"
def var(values: list[f64]) -> f64

extern "C" "sere_f64_min"
def vmin(values: list[f64]) -> f64

extern "C" "sere_f64_max"
def vmax(values: list[f64]) -> f64

extern "C" "sere_f64_argmin"
def argmin(values: list[f64]) -> i64

extern "C" "sere_f64_argmax"
def argmax(values: list[f64]) -> i64

extern "C" "sere_f64_dot"
def dot(left: list[f64], right: list[f64]) -> f64

extern "C" "sere_f64_outer"
def outer(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_f64_normalize"
def normalize(values: list[f64]) -> list[f64]

extern "C" "sere_f64_cross3"
def cross(left: list[f64], right: list[f64]) -> list[f64]

extern "C" "sere_mat_mul"
def matmul(left: list[f64], left_rows: i64, left_cols: i64, right: list[f64], right_rows: i64, right_cols: i64) -> list[f64]

extern "C" "sere_mat_transpose"
def transpose(values: list[f64], rows: i64, cols: i64) -> list[f64]

extern "C" "sere_mat_identity"
def eye(n: i64) -> list[f64]

def zeros(length: i64) -> list[f64]:
    return full(length, 0 as f64)

def ones(length: i64) -> list[f64]:
    return full(length, 1 as f64)

def zeros2(rows: i64, cols: i64) -> list[f64]:
    return zeros(rows * cols)

def ones2(rows: i64, cols: i64) -> list[f64]:
    return ones(rows * cols)

def std(values: list[f64]) -> f64:
    return var(values) ** (1 as f64 / 2 as f64)
