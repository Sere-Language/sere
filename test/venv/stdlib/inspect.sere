# Introspection helpers. Import with: import inspect
# Module introspection when this file is imported: inspect.__name__ == "inspect"
# Builtins always available without this file:
#   typeof(value) -> str
#   isinstance[T](value) / isinstance(value, T) -> bool
#   dir(value) / dir() -> list[str]
#   inspect(value) -> str
#   value.__name__  value.__type__  value.__module__  value.__qualname__
#   __name__  __file__  __package__  __doc__  __debug__  __sere_version__

def label(name: str) -> str:
    return name

def describe(name: str, kind: str) -> str:
    return f"{kind} {name}"
