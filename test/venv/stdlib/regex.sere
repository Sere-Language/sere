# Regular expressions. Backtick literals have type regex.
#   import regex
#   if regex.is_match(`\d+`, "ab12"):
#       print(regex.find(`[A-Z]+`, "id ID"))

extern "C" "sere_re_is_match"
def _is_match(pattern: regex, text: str) -> i32

extern "C" "sere_re_find"
def find(pattern: regex, text: str) -> str

extern "C" "sere_re_replace"
def replace(pattern: regex, text: str, repl: str) -> str

def is_match(pattern: regex, text: str) -> bool:
    return _is_match(pattern, text) as bool
