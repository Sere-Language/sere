{
  "name": "sere",
  "displayName": "Sere",
  "description": "Language support for Sere: diagnostics, hover, completion, macros, exceptions, and a restartable language server.",
  "version": "0.2.0",
  "publisher": "sere",
  "private": true,
  "license": "UNLICENSED",
  "icon": "icon.ico",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sere-Language/sere.git"
  },
  "homepage": "https://github.com/Sere-Language/sere",
  "bugs": {
    "url": "https://github.com/Sere-Language/sere/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "sere",
    "language",
    "lsp",
    "compiler",
    "python-superset"
  ],
  "activationEvents": [
    "onLanguage:sere",
    "workspaceContains:**/*.sere",
    "workspaceContains:sere.toml"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sere",
        "aliases": [
          "Sere",
          "sere"
        ],
        "extensions": [
          ".sere"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.ico",
          "dark": "./icon.ico"
        }
      }
    ],
    "grammars": [
      {
        "language": "sere",
        "scopeName": "source.sere",
        "path": "./syntaxes/sere.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sere]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on",
        "editor.parameterHints.enabled": true,
        "editor.parameterHints.cycle": true,
        "editor.codeLens": true,
        "editor.suggest.showSnippets": false,
        "editor.snippetSuggestions": "none",
        "editor.acceptSuggestionOnEnter": "off"
      }
    },
    "semanticTokenTypes": [
      {
        "id": "struct",
        "description": "Struct type names",
        "superType": "class"
      },
      {
        "id": "macro",
        "description": "Macro names",
        "superType": "function"
      },
      {
        "id": "decorator",
        "description": "Decorators such as @public",
        "superType": "function"
      },
      {
        "id": "modifier",
        "description": "Modifiers such as static, const, and extern",
        "superType": "keyword"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sere",
        "scopes": {
          "keyword": ["keyword.control"],
          "modifier": ["storage.modifier", "keyword.control"],
          "macro": ["entity.name.function", "keyword.control.directive"],
          "decorator": ["entity.name.function.decorator", "entity.name.function"],
          "class": ["entity.name.type.class"],
          "struct": ["entity.name.type.class", "entity.name.type"],
          "enum": ["entity.name.type.enum", "entity.name.type.class"],
          "enumMember": ["variable.other.enummember", "variable.other.constant"],
          "property": ["variable.other.property", "variable.other.member"],
          "type": ["entity.name.type", "support.type"],
          "function": ["entity.name.function"],
          "method": ["entity.name.function.member", "entity.name.function"],
          "parameter": ["variable.parameter"],
          "variable": ["variable.other"],
          "regexp": ["string.regexp"],
          "operator": ["keyword.operator"],
          "string": ["string"],
          "number": ["constant.numeric"],
          "namespace": ["entity.name.namespace"]
        }
      }
    ],
    "configuration": {
      "title": "Sere",
      "properties": {
        "sere.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to `sere`. Empty uses an activated `SERE_VENV_BIN`, then `venv/bin` from the nearest `sere.toml`. The language server prefers the CMake build-tree compiler so it does not lock `./bin/sere.exe`. CLI commands prefer workspace `bin/`."
        },
        "sere.stdlibPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to the Sere standard library (must contain `prelude.sere`). Empty uses a usable `SERE_STDLIB`, then the nearest project `venv/stdlib`, then `stdlib/` next to `sere` or the workspace."
        },
        "sere.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show reference counts above functions, classes, enums, and macros."
        }
      }
    },
    "commands": [
      {
        "command": "sere.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Sere"
      },
      {
        "command": "sere.compileCurrentFile",
        "title": "Compile Current File",
        "category": "Sere"
      },
      {
        "command": "sere.buildProject",
        "title": "Build Project",
        "category": "Sere"
      },
      {
        "command": "sere.runProject",
        "title": "Run Project",
        "category": "Sere"
      },
      {
        "command": "sere.refreshBin",
        "title": "Refresh ./bin Compiler",
        "category": "Sere"
      },
      {
        "command": "sere.openSettings",
        "title": "Open Settings",
        "category": "Sere"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sere.restartLanguageServer"
        },
        {
          "command": "sere.compileCurrentFile"
        },
        {
          "command": "sere.buildProject"
        },
        {
          "command": "sere.runProject"
        },
        {
          "command": "sere.refreshBin"
        },
        {
          "command": "sere.openSettings"
        }
      ]
    }
  }
}
