{
  "name": "sere",
  "displayName": "Sere",
  "description": "Language support for Sere: diagnostics, hover, completion, macros, exceptions, smarter IntelliSense, and a clickable main() Run CodeLens.",
  "version": "0.2.7",
  "publisher": "sere",
  "private": true,
  "license": "UNLICENSED",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sere-Language/sere.git"
  },
  "homepage": "https://github.com/Sere-Language/sere",
  "bugs": {
    "url": "https://github.com/Sere-Language/sere/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Formatters"
  ],
  "keywords": [
    "sere",
    "language",
    "lsp",
    "compiler",
    "python-superset"
  ],
  "activationEvents": [
    "onLanguage:sere",
    "workspaceContains:**/*.sere",
    "workspaceContains:sere.toml"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sere",
        "aliases": [
          "Sere",
          "sere"
        ],
        "extensions": [
          ".sere"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icon.png",
          "dark": "./icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "sere",
        "scopeName": "source.sere",
        "path": "./syntaxes/sere.tmLanguage.json"
      }
    ],
    "configurationDefaults": {
      "[sere]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on",
        "editor.parameterHints.enabled": true,
        "editor.parameterHints.cycle": true,
        "editor.codeLens": true,
        "editor.suggest.showSnippets": false,
        "editor.snippetSuggestions": "none",
        "editor.wordBasedSuggestions": "off",
        "editor.acceptSuggestionOnEnter": "off"
      }
    },
    "semanticTokenTypes": [
      {
        "id": "struct",
        "description": "Struct type names",
        "superType": "class"
      },
      {
        "id": "macro",
        "description": "Macro names",
        "superType": "function"
      },
      {
        "id": "decorator",
        "description": "Decorators such as @public",
        "superType": "function"
      },
      {
        "id": "modifier",
        "description": "Modifiers such as static, const, and extern",
        "superType": "keyword"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sere",
        "scopes": {
          "keyword": [
            "keyword.control"
          ],
          "modifier": [
            "storage.modifier",
            "keyword.control"
          ],
          "macro": [
            "entity.name.function",
            "keyword.control.directive"
          ],
          "decorator": [
            "entity.name.function.decorator",
            "entity.name.function"
          ],
          "class": [
            "entity.name.type.class"
          ],
          "struct": [
            "entity.name.type.class",
            "entity.name.type"
          ],
          "enum": [
            "entity.name.type.enum",
            "entity.name.type.class"
          ],
          "enumMember": [
            "variable.other.enummember",
            "variable.other.constant"
          ],
          "property": [
            "variable.other.property",
            "variable.other.member"
          ],
          "type": [
            "entity.name.type",
            "support.type"
          ],
          "function": [
            "entity.name.function"
          ],
          "method": [
            "entity.name.function.member",
            "entity.name.function"
          ],
          "parameter": [
            "variable.parameter"
          ],
          "variable": [
            "variable.other"
          ],
          "regexp": [
            "string.regexp"
          ],
          "operator": [
            "keyword.operator"
          ],
          "string": [
            "string"
          ],
          "number": [
            "constant.numeric"
          ],
          "namespace": [
            "entity.name.namespace"
          ]
        }
      }
    ],
    "configuration": {
      "title": "Sere",
      "properties": {
        "sere.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to `sere`. Empty auto-discovers a compiler. Use **Sere: Set Active Compiler** to pick one. Stdlib then comes from `stdlib/` next to that executable."
        },
        "sere.stdlibPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Folder that contains `prelude.sere`. Use **Sere: Set Stdlib Folder** to pick one. Empty uses workspace `stdlib/` or the folder next to the active compiler."
        },
        "sere.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show reference counts above functions, classes, enums, and macros, and a clickable Run lens on the project entry function."
        }
      }
    },
    "commands": [
      {
        "command": "sere.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Sere"
      },
      {
        "command": "sere.compileCurrentFile",
        "title": "Compile Current File",
        "category": "Sere"
      },
      {
        "command": "sere.buildProject",
        "title": "Build Project",
        "category": "Sere"
      },
      {
        "command": "sere.runProject",
        "title": "Run Project",
        "category": "Sere"
      },
      {
        "command": "sere.runMain",
        "title": "Run Main",
        "category": "Sere"
      },
      {
        "command": "sere.refreshBin",
        "title": "Refresh ./bin Compiler",
        "category": "Sere"
      },
      {
        "command": "sere.setActiveCompiler",
        "title": "Set Active Compiler",
        "category": "Sere"
      },
      {
        "command": "sere.setStdlibPath",
        "title": "Set Stdlib Folder",
        "category": "Sere"
      },
      {
        "command": "sere.openSettings",
        "title": "Open Settings",
        "category": "Sere"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sere.restartLanguageServer"
        },
        {
          "command": "sere.compileCurrentFile"
        },
        {
          "command": "sere.buildProject"
        },
        {
          "command": "sere.runProject"
        },
        {
          "command": "sere.runMain"
        },
        {
          "command": "sere.refreshBin"
        },
        {
          "command": "sere.setActiveCompiler"
        },
        {
          "command": "sere.setStdlibPath"
        },
        {
          "command": "sere.openSettings"
        }
      ]
    }
  }
}
