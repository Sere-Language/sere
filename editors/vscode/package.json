{
  "name": "sere",
  "displayName": "Sere",
  "description": "Sere language support: diagnostics with exception codes, hover, completion, rename, go to definition, folding, formatting, semantic tokens, macros, and a restartable language server.",
  "version": "0.1.1",
  "publisher": "sere",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {},
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "sere",
    "language",
    "lsp",
    "compiler"
  ],
  "activationEvents": [
    "onLanguage:sere",
    "workspaceContains:**/*.sere",
    "onStartupFinished"
  ],
  "main": "./extension.js",
  "contributes": {
    "languages": [
      {
        "id": "sere",
        "aliases": [
          "Sere",
          "sere"
        ],
        "extensions": [
          ".sere"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "sere",
        "scopeName": "source.sere",
        "path": "./syntaxes/sere.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "sere",
        "path": "./snippets/sere.json"
      }
    ],
    "configurationDefaults": {
      "[sere]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.inlayHints.enabled": "on",
        "editor.parameterHints.enabled": true,
        "editor.parameterHints.cycle": true,
        "editor.codeLens": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "struct",
        "description": "Struct type names",
        "superType": "class"
      },
      {
        "id": "macro",
        "description": "Macro names",
        "superType": "function"
      },
      {
        "id": "decorator",
        "description": "Decorators such as @public",
        "superType": "function"
      },
      {
        "id": "modifier",
        "description": "Modifiers such as static, const, and extern",
        "superType": "keyword"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "sere",
        "scopes": {
          "keyword": ["keyword.control"],
          "modifier": ["storage.modifier", "keyword.control"],
          "macro": ["entity.name.function", "keyword.control.directive"],
          "decorator": ["entity.name.function.decorator", "entity.name.function"],
          "class": ["entity.name.type.class"],
          "struct": ["entity.name.type.class", "entity.name.type"],
          "enum": ["entity.name.type.enum", "entity.name.type.class"],
          "enumMember": ["variable.other.enummember", "variable.other.constant"],
          "property": ["variable.other.property", "variable.other.member"],
          "type": ["entity.name.type", "support.type"],
          "function": ["entity.name.function"],
          "method": ["entity.name.function.member", "entity.name.function"],
          "parameter": ["variable.parameter"],
          "variable": ["variable.other"],
          "regexp": ["string.regexp"],
          "operator": ["keyword.operator"],
          "string": ["string"],
          "number": ["constant.numeric"],
          "namespace": ["entity.name.namespace"]
        }
      }
    ],
    "configuration": {
      "title": "Sere",
      "properties": {
        "sere.compilerPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to `sere`. Empty uses an activated `SERE_VENV_BIN`, then `venv/bin` from the nearest `sere.toml`, then workspace `bin/`, then PATH. The language server is `sere --lsp`."
        },
        "sere.stdlibPath": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Path to the Sere standard library. Empty uses the nearest `sere.toml` project's `venv/stdlib` (or an activated `SERE_STDLIB`), then workspace `stdlib/`."
        },
        "sere.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show reference counts above functions, classes, enums, and macros."
        }
      }
    },
    "commands": [
      {
        "command": "sere.restartLanguageServer",
        "title": "Restart Language Server",
        "category": "Sere"
      },
      {
        "command": "sere.compileCurrentFile",
        "title": "Compile Current File",
        "category": "Sere"
      },
      {
        "command": "sere.openSettings",
        "title": "Open Settings",
        "category": "Sere"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sere.restartLanguageServer"
        },
        {
          "command": "sere.compileCurrentFile"
        },
        {
          "command": "sere.openSettings"
        }
      ]
    }
  }
}
