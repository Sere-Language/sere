{
  "Main": {
    "prefix": "main",
    "body": ["def main() -> i32:", "    ${0:return 0}"],
    "description": "Program entry point"
  },
  "Function": {
    "prefix": "def",
    "body": ["def ${1:name}(${2}) -> ${3:void}:", "    ${0:pass}"],
    "description": "Function definition"
  },
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    def __init__(self${2}) -> void:",
      "        ${0:pass}"
    ],
    "description": "Class with __init__"
  },
  "Struct": {
    "prefix": "struct",
    "body": ["struct ${1:Name}:", "    ${2:field}: ${3:i32}"],
    "description": "Struct definition"
  },
  "Enum": {
    "prefix": "enum",
    "body": ["enum ${1:Name}:", "    ${2:Variant}"],
    "description": "Enum definition"
  },
  "Type alias": {
    "prefix": "type",
    "body": ["type ${1:Name} = ${2:i32}"],
    "description": "Type alias or union"
  },
  "For loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:items}:", "    ${0:pass}"],
    "description": "for-in loop"
  },
  "While loop": {
    "prefix": "while",
    "body": ["while ${1:condition}:", "    ${0:pass}"],
    "description": "while loop"
  },
  "If": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "    ${0:pass}"],
    "description": "if statement"
  },
  "Try/except": {
    "prefix": "try",
    "body": [
      "try:",
      "    ${1:pass}",
      "except ${2:TypeError} as ${3:e}:",
      "    ${0:print(e.message)}"
    ],
    "description": "try / except TypeError as e"
  },
  "Raise": {
    "prefix": "raise",
    "body": ["raise ${1:TypeError}(\"${2:message}\")"],
    "description": "Raise a builtin exception"
  },
  "Exception class": {
    "prefix": "exc",
    "body": ["class ${1:Boom}(${2:Exception}):", "    pass"],
    "description": "Custom exception subclass"
  },
  "Match": {
    "prefix": "match",
    "body": ["match ${1:value}:", "    case ${2:_}:", "        ${0:pass}"],
    "description": "match statement"
  },
  "Macro": {
    "prefix": "macro",
    "body": ["macro ${1:name}(${2:x}):", "    quote:", "        ${0:$x}"],
    "description": "Quote macro"
  },
  "Import": {
    "prefix": "import",
    "body": ["from ${1:math} import ${2:sqrt}"],
    "description": "from-import"
  },
  "Unique pointer": {
    "prefix": "unique",
    "body": ["unique[${1:i32}](${2:value})"],
    "description": "Unique[T] allocation"
  },
  "Shared pointer": {
    "prefix": "shared",
    "body": ["shared[${1:i32}](${2:value})"],
    "description": "Shared[T] allocation"
  },
  "Raw pointer": {
    "prefix": "alloc",
    "body": ["alloc[${1:i32}]()"],
    "description": "Ptr[T] allocation"
  },
  "Parse": {
    "prefix": "parse",
    "body": ["parse[${1:i32}](${2:text})"],
    "description": "Parse a string as T"
  },
  "Try parse": {
    "prefix": "try_parse",
    "body": ["try_parse[${1:i32}](${2:text})"],
    "description": "Parse a string as T | None"
  },
  "Type ignore": {
    "prefix": "ignore",
    "body": ["# type[${1:NameError}]: ignore"],
    "description": "Suppress a diagnostic"
  }
}
