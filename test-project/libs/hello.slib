"""Drop-in Sere library. Pack with `sere pack`, then copy dist/hello.slib into another project's libs/ folder and `import hello`.
"""

def greet(name: str) -> void:
    print(f"Hello, {name}!")

def hello_world() -> void:
    print("Hello, world!")
