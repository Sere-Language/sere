def mydecorator(func: Function[[i32, i32], i32]) -> Function[[i32, i32], i32]:
    def wrapper(left: i32, right: i32) -> i32:
        return func(left, right)
    return wrapper

def make(label: str) -> Function[[Function[[i32, i32], i32]], Function[[i32, i32], i32]]:
    print("make:", label)
    return mydecorator

@make("mul")
def combine(left: i32, right: i32) -> i32:
    return left * 10 + right

def main() -> i32:
    return combine(4, 3)
