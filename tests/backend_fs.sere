import fs

def main() -> i32:
    text = input("Input: ")
    found = list[str]()
    for c in text.split(""):
        if c in "aeiou":
            found.append(c)
    print(f"Found {len(found)} vowels")
    print(found)
    with fs.open("output.txt", "w") as f:
        f.write(f"Vowels: {found}")
    with fs.open("output.txt") as f:
        print(f.read())
    data: list[i8] = []
    with fs.open("output.txt", "rb") as f:
        print(f.read_bytes(0))
        data = f.read_bytes(6)
        print(data)
    with fs.open("bytes.bin", "wb") as f:
        print(f.write_bytes(data))
    with fs.open("bytes.bin", "rb") as f:
        print(f.read_bytes())
    values = array[i8](4, 5, 6)
    values[1] = 9
    print(values)
    print(range(5, 0, -2))
    print(2 as bool)
    print(256 as bool)
    return 0
