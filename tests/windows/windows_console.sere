import windows
import os


def main() -> i32:
    # Resolve the standard handle without requiring an attached console.
    handle = windows.stdout_handle()
    assert os.pid() > 0

    # A pipe is not a console; these calls must fail without changing the terminal.
    pipe = windows.create_pipe()
    invalid = pipe.write
    assert not windows.set_console_mode(invalid, windows.ENABLE_VIRTUAL_TERMINAL_PROCESSING)
    assert not windows.console_clear(invalid)
    assert windows.console_write(invalid, "Hello world!") == -1
    assert windows.close_handle(pipe.read)
    assert windows.close_handle(pipe.write)
    return 0
