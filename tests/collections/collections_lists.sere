def main() -> i32:
    # Lists: literal, append, len, index read/write, slices, membership, del,
    # concat, repeat, and elementwise equality.
    xs: list[i32] = [1, 2, 3]
    xs.append(4)
    xs[0] = 10
    assert len(xs) == 4
    assert xs[0] == 10
    assert xs[3] == 4
    assert xs[1:3] == [2, 3]
    assert 2 in xs
    assert 99 not in xs
    assert xs + [5] == [10, 2, 3, 4, 5]
    assert [0] * 3 == [0, 0, 0]
    del xs[3]
    assert xs == [10, 2, 3]
    assert xs[:2] == [10, 2]
    assert xs[1:] == [2, 3]
    assert xs[-2:] == [2, 3]

    yet: list[i32]
    yet = [7, 8]
    assert yet == [7, 8]

    print("collections lists ok", len(xs), xs[1], xs[-2:])
    return 0