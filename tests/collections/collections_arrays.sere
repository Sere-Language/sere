def main() -> i32:
    # Arrays: constructor with elements, len, index read/write, negative
    # indexing, and membership.
    arr: array[i32] = array[i32](1, 2, 3)
    assert len(arr) == 3
    assert arr[2] == 3
    arr[1] = 20
    assert arr[1] == 20
    assert arr[0] == 1
    assert arr[-1] == 3
    assert 20 in arr
    assert 99 not in arr

    chars: array[str] = array[str]("a", "b")
    chars[1] = "z"
    assert len(chars) == 2
    assert chars[1] == "z"

    zeros: array[i64] = array[i64](0, 0, 0, 0)
    zeros[0] = 5
    assert len(zeros) == 4
    assert zeros[0] == 5

    print("collections arrays ok", arr[1], arr[-1], chars[1], zeros[3])
    return 0