def main() -> i32:
    # Dicts: literal, index read/write, overwrite, len, membership, and del.
    ages: dict[str, i32] = {"ada": 36}
    ages["ada"] = 37
    assert ages["ada"] == 37
    assert len(ages) == 1
    ages["bob"] = 7
    assert len(ages) == 2
    assert ages["bob"] == 7
    assert "ada" in ages
    assert "carol" not in ages
    del ages["ada"]
    assert "ada" not in ages
    assert len(ages) == 1

    empty: dict[str, i32] = dict[str, i32]()
    empty["linus"] = 55
    assert empty["linus"] == 55
    assert len(empty) == 1
    empty["joy"] = 66
    empty["joy"] = 67
    assert empty["joy"] == 67
    assert len(empty) == 2

    counts: dict[i32, str] = {1: "one", 10: "ten"}
    counts[3] = "three"
    assert counts[10] == "ten"
    assert counts[3] == "three"
    assert len(counts) == 3
    assert 1 in counts
    assert 99 not in counts
    del counts[10]
    assert 10 not in counts

    print("collections dicts ok", ages["bob"], empty["joy"], counts[1])
    return 0