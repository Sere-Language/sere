class Stack[T]:
    items: list[T]

    def __init__(self) -> void:
        self.items = []

    def push(self, value: T) -> void:
        self.items.append(value)

    def pop(self) -> T:
        return self.items.pop(-1)

    def map[U](self, f: Callable[[T], U]) -> list[U]:
        result: list[U] = []
        for item in self.items:
            result.append(f(item))
        return result

    def filter_into[U](self, f: Callable[[T], bool], convert: Callable[[T], U]) -> list[U]:
        result: list[U] = []
        for item in self.items:
            if f(item):
                result.append(convert(item))
        return result

    def join_with(self, separator: str) -> str:
        return separator.join(self.items)

def bump(value: i32) -> i32:
    return value + 1

def stringify[T: i32 | str](value: T) -> str:
    return "#" + str(value)

def is_even(value: i32) -> bool:
    return value % 2 == 0

def main() -> i32:
    numbers: Stack[i32] = Stack[i32]()
    numbers.push(1)
    numbers.push(2)
    numbers.push(3)

    # A method-level parameter U is inferred from the callable's return type.
    bumped: list[i32] = numbers.map(bump)
    assert bumped == [2, 3, 4]

    text: list[str] = numbers.map(stringify)
    assert text == ["#1", "#2", "#3"]

    evens: list[i32] = numbers.filter_into(is_even, bump)
    assert evens == [3]

    # A method that uses the class parameter without a new one.
    assert numbers.join_with("-") == "1-2-3"
    assert numbers.pop() == 3
    assert numbers.join_with(",") == "1,2"

    words: Stack[str] = Stack[str]()
    words.push("a")
    words.push("b")
    assert words.map(stringify) == ["#a", "#b"]

    # A lambda is accepted where the callable type is expected.
    doubled: list[i32] = numbers.map(lambda (value: i32) -> i32: value * 2)
    assert doubled == [2, 4]

    print("generic methods ok", len(bumped), text[2], len(doubled))
    return 0
