class Tagged:
    type: str

    def __init__(self, value: str) -> void:
        self.type = value

    def label(self) -> str:
        return self.type

def main() -> i32:
    tagged: Tagged = Tagged("kind")
    assert tagged.type == "kind"
    assert tagged.label() == "kind"

    message: str = "Hello world!"
    bytes: list[byte] = b"Hello world!"
    assert bytes.len() == 12
    assert bytes.decode() == message
    assert message.encode().decode() == message

    x: i32 = 1; y: i32 = 2; x += y
    assert x == 3
    print("syntax and bytes ok")
    return 0
