def main() -> i32:
    # lists: append, index read/write, slicing, len, membership, concat, repeat
    xs: list[i32] = [1, 2, 3]
    xs.append(4)
    xs[0] = 10
    assert len(xs) == 4
    assert xs[0] == 10
    assert xs[3] == 4
    assert xs[1:3] == [2, 3]
    assert 2 in xs
    assert 99 not in xs
    assert xs + [5] == [10, 2, 3, 4, 5]
    assert [0] * 3 == [0, 0, 0]
    del xs[3]
    assert xs == [10, 2, 3]

    # arrays
    arr: array[i32] = array[i32](1, 2, 3)
    assert arr[2] == 3
    assert len(arr) == 3

    # dicts
    ages: dict[str, i32] = {"ada": 36}
    ages["ada"] = 37
    assert ages["ada"] == 37
    assert len(ages) == 1
    assert "ada" in ages
    assert "bob" not in ages
    empty: dict[str, i32] = dict[str, i32]()
    empty["linus"] = 55
    assert empty["linus"] == 55
    del empty["linus"]
    assert len(empty) == 0

    # tuples and unpacking
    pair = (1, 2)
    a, b = pair
    assert a == 1
    assert b == 2
    c, d = 3, 4
    assert c == 3
    assert d == 4

    # strings: index, slice, len, membership, concat, repeat, compare
    hello: str = "Hello"
    assert hello[0] == "H"
    assert hello[-1] == "o"
    assert hello[1:4] == "ell"
    assert len(hello) == 5
    assert "ell" in hello
    assert hello + "!" == "Hello!"
    assert hello * 2 == "HelloHello"
    assert hello == "Hello"
    assert hello < "World"

    print("collections ok", len(xs), arr[2], ages["ada"], b, d, hello[1:4], len(hello))
    return 0
