enum Color:
    Red
    Green = 2
    Blue

enum Message:
    Quit
    Move(x: i32, y: i32)
    Write(str)

    def is_quit(self) -> bool:
        match self:
            case Message.Quit:
                return True
            case _:
                return False

@flags
enum Perm:
    Read = 1
    Write = 2
    Exec = 4

def main() -> i32:
    tone: Color = Color.Green
    assert tone is Color.Green
    assert tone.name == "Green"
    assert tone.value == 2
    assert i32(tone) == 2
    names: list[str] = Color.variants()
    assert len(names) == 3
    assert names[0] == "Red"
    assert Color.__name__ == "Color"

    moved: Message = Message.Move(1, 2)
    assert not Message.Quit.is_quit()
    assert not moved.is_quit()
    match moved:
        case Message.Move(x, y):
            assert x == 1
            assert y == 2
        case _:
            assert False

    written: Message = Message.Write("payload")
    match written:
        case Message.Write(text):
            assert text == "payload"
        case _:
            assert False

    mask: Perm = Perm.Read
    assert Perm.Read in mask
    assert Perm.Write not in mask
    combined: Perm = Perm.Read | Perm.Write
    assert Perm.Read in combined
    assert Perm.Write in combined

    print("enums ok", tone.name, i32(tone), names[2], written)
    return 0
