def bump(value: Ptr[i32]) -> void:
    *value = *value + 1

def main() -> i32:
    owned: Unique[i32] = unique[i32](42)
    *owned = 43
    assert load(owned) == 43

    shared_ptr: Shared[i32]
    shared_ptr = shared[i32](7)
    assert load(shared_ptr) == 7

    raw: Ptr[i32] = alloc[i32]()
    store(raw, 7)
    *raw = 8
    assert load(raw) == 8
    free(raw)

    local: i32 = 10
    stack: Ptr[i32] = &local
    *stack = 11
    assert local == 11

    bump(&local)
    assert local == 12

    print("pointers ok", load(owned), load(shared_ptr), local)
    return 0
