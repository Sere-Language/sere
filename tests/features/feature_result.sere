def double(value: i32) -> i32:
    return value * 2

def error_length(error: str) -> i32:
    return i32(len(error))

def stringify(value: i32) -> str:
    return str(value)

def next_result(value: i32) -> Result[str, str]:
    return Result.Ok(str(value))

def recover(error: str) -> Result[i32, i32]:
    return Result.Ok(i32(len(error)))

def main() -> i32:
    good: Result[i32, str] = Result.Ok(21)
    bad: Result[i32, str] = Result.Err("bad")
    assert good.is_ok()
    assert not good.is_err()
    assert bad.is_err()
    assert not bad.is_ok()
    assert good.unwrap() == 21
    assert good.expect("value") == 21
    assert i32(good.ok()) == 21
    assert bad.ok() is None
    assert good.err() is None
    assert str(bad.err()) == "bad"
    assert good.unwrap_or(7) == 21
    assert bad.unwrap_or(7) == 7
    assert good.unwrap_or_else(error_length) == 21
    assert bad.unwrap_or_else(error_length) == 3
    assert good.map(stringify).unwrap() == "21"
    assert bad.map(stringify).contains_err("bad")
    assert good.map_err(error_length).unwrap() == 21
    assert bad.map_err(error_length).contains_err(3)
    assert good.map_or(7, double) == 42
    assert bad.map_or(7, double) == 7
    assert good.map_or_else(error_length, double) == 42
    assert bad.map_or_else(error_length, double) == 3
    other: Result[str, str] = Result.Ok("other")
    other_bad: Result[str, str] = Result.Err("other error")
    assert good.and_(other).unwrap() == "other"
    assert good.and_(other_bad).contains_err("other error")
    assert bad.and_(other).contains_err("bad")
    assert bad.and_(other_bad).contains_err("bad")
    assert good.and_then(next_result).unwrap() == "21"
    assert bad.and_then(next_result).contains_err("bad")
    fallback: Result[i32, i32] = Result.Ok(9)
    fallback_bad: Result[i32, i32] = Result.Err(404)
    assert good.or_(fallback).unwrap() == 21
    assert good.or_(fallback_bad).unwrap() == 21
    assert bad.or_(fallback).unwrap() == 9
    assert bad.or_(fallback_bad).contains_err(404)
    assert good.or_else(recover).unwrap() == 21
    assert bad.or_else(recover).unwrap() == 3
    assert good.contains(21)
    assert not good.contains(22)
    assert not bad.contains(21)
    assert bad.contains_err("bad")
    assert not bad.contains_err("wrong")
    assert not good.contains_err("bad")
    caught: i32 = 0
    try:
        bad.unwrap()
    except ResultError as error:
        assert error.message == "bad"
        caught += 1
    try:
        bad.expect("failed")
    except ResultError as error:
        assert error.message == "failed: bad"
        caught += 1
    numeric: Result[str, i32] = Result.Err(404)
    try:
        numeric.unwrap()
    except ResultError as error:
        assert error.message == "404"
        caught += 1
    assert caught == 3
    print("result ok")
    return 0
