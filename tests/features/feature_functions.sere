def add(a: i32, b: i32) -> i32:
    return a + b

def scale(value: i32, factor: i32 = 2) -> i32:
    return value * factor

def apply(cb: Callable[[i32, i32], i32], x: i32, y: i32) -> i32:
    return cb(x, y)

def twice(cb: Callable[i32], n: i32) -> i32:
    return cb(n) + cb(n)

def call_fn(cb: Function[[i32, i32], i32], x: i32, y: i32) -> i32:
    return cb(x, y)

class Point:
    @public
    x: i32
    @public
    y: i32

    def __init__(self, x: i32, y: i32) -> void:
        self.x = x
        self.y = y

def make(cls: Class[Point], x: i32, y: i32) -> Point:
    return cls(x, y)

class Adder:
    @public
    base: i32

    def __init__(self, base: i32) -> void:
        self.base = base

    def add_base(self, n: i32) -> i32:
        return self.base + n

    def run(self, n: i32) -> i32:
        return self.add_base(n)

def mydecorator(func: Function[[i32, i32], i32]) -> Function[[i32, i32], i32]:
    def wrapper(left: i32, right: i32) -> i32:
        return func(left, right)
    return wrapper

@mydecorator
def combine(left: i32, right: i32 = 2) -> i32:
    return left * 10 + right

def main() -> i32:
    assert scale(3) == 6
    assert scale(3, 5) == 15
    assert combine(4, 3) == 43
    assert combine(right=5, left=6) == 65

    n = apply(add, 1, 2)
    assert n == 3
    inc = lambda (x: i32) -> i32: x + 1
    assert twice(inc, 3) == 8
    assert call_fn(add, 5, 6) == 11

    point = make(Point, 7, 8)
    assert point.x == 7
    assert point.y == 8

    adder = Adder(10)
    assert adder.run(5) == 15
    stored: Callable[[i32], i32] = adder.add_base
    assert stored(2) == 12

    print("functions ok", n, twice(inc, 3), point.x, point.y, adder.run(5), stored(2))
    return 0
