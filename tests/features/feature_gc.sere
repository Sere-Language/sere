from heap import Arena, Pool
import gc
import heap

def main() -> i32:
    installed: bool = gc.use("none")
    raw: Ptr[i8] = gc.alloc_bytes(16)
    heap.set(raw, 7, 16)
    used: i64 = gc.bytes_in_use()
    assert used >= 16
    gc.free_bytes(raw)

    sweep: bool = gc.use("mark_sweep")
    live: Ptr[i32] = alloc[i32]()
    store(live, 42)
    gc.add_root(live as Ptr[i8])
    junk: Ptr[i32] = alloc[i32]()
    store(junk, 1)
    gc.collect()
    assert load(live) == 42
    gc.remove_root(live as Ptr[i8])
    free(live)

    arena_on: bool = gc.use("arena")
    bump: Ptr[i8] = gc.alloc_bytes(32)
    assert bump != None
    gc.collect()

    scratch: Arena = Arena(4096)
    block: Ptr[i8] = scratch.alloc(8)
    assert block != None
    heap.zero(block, 8)
    scratch.destroy()

    pool: Pool = Pool(16, 4)
    slot: Ptr[i8] = pool.alloc()
    assert slot != None
    pool.release(slot)
    pool.destroy()

    assert installed
    assert sweep
    assert arena_on
    assert gc.collections() >= 0

    print("gc ok", used >= 16, gc.collections() >= 0)
    return 0
