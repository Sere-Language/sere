
class Counter:
    value: i32
    label: str

    def __init__(self, value: i32) -> void:
        self.value = value
        self.label = "counter"

def read(counter: Counter) -> i32:
    return counter.value

def main() -> i32:
    counter: Counter = Counter(1)

    # Address of a field, then write through the pointer.
    field: Ptr[i32] = &counter.value
    *field = 9
    assert counter.value == 9
    assert read(counter) == 9

    # A raw pointer to a class value.
    handle: Ptr[Counter] = &counter
    (*handle).value = 12
    assert counter.value == 12
    assert read(*handle) == 12

    # Unique-owned class value, borrowed as a raw pointer.
    owned: Unique[Counter] = unique[Counter](Counter(5))
    assert load(owned).value == 5
    (*owned).value = 6
    assert load(owned).value == 6

    local: Ptr[i32] = &counter.value
    *local = *local + 1
    assert counter.value == 13

    print("pointer fields ok", counter.value, counter.label, read(counter))
    return 0
