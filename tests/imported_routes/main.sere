import router
static app: router.App = router.App(name=__name__)
@app.route("/", methods=router.Method.GET)
def index() -> str:
    return "Hello, world!"
@app.route("/post", router.Method.POST)
def post() -> str:
    return "posted"
@app.route(path="/default")
def default() -> str:
    return "default"
def main() -> i32:
    print(index())
    print(post())
    print(default())
    routes = app.get_routes()
    print(len(routes))
    get_route = routes["/"]
    post_route = routes["/post"]
    if get_route.methods != router.Method.GET:
        return 1
    if post_route.methods != router.Method.POST:
        return 2
    return 0
