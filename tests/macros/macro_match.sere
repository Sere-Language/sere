macro vec:
    match:
        ($($x:expr),*) => quote:
            [$($x:expr),*]

macro sum:
    match:
        ($($x:expr),*) => quote:
            add_all([$($x),*])

macro single(x):
    match:
        ($x:expr) => quote:
            ($x) + 1

def add_all(values: list[i32]) -> i32:
    total: i32 = 0
    for value in values:
        total += value
    return total

def main() -> i32:
    empty: list[i32] = vec!()
    assert len(empty) == 0

    one: list[i32] = vec!(7)
    assert len(one) == 1
    assert one[0] == 7

    many: list[i32] = vec!(1, 2, 3, 4)
    assert len(many) == 4
    assert many[3] == 4

    # Nested macro invocations inside a repeat group.
    mixed: list[i32] = vec!(single!(1), single!(single!(1)), 9)
    assert mixed == [2, 3, 9]

    assert sum!() == 0
    assert sum!(1, 2, 3) == 6
    assert sum!(many[0], many[1]) == 3

    print("macro match ok", len(many), add_all(many))
    return 0
