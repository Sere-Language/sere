def mark(tag: str) -> Function[[Function[[str], str]], Function[[str], str]]:
    def decorate(fn: Function[[str], str]) -> Function[[str], str]:
        def wrapper(value: str) -> str:
            return fn(value) + tag
        return wrapper
    return decorate

# The declaration is decorated bottom-up, so the closest one runs first:
# final = first(second(third(f))).
@mark("1")
@mark("2")
@mark("3")
def ordered(value: str) -> str:
    return value

def main() -> i32:
    assert ordered("f") == "f321"

    # A runtime decorator and a reserved modifier may share a declaration; the
    # modifier is handled by the checker and never wraps the value.
    print("decorator order ok", ordered("x"))
    return 0
