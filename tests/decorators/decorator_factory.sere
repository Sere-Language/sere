def prefix(tag: str) -> Function[[Function[[str], str]], Function[[str], str]]:
    def decorate(fn: Function[[str], str]) -> Function[[str], str]:
        def wrapper(value: str) -> str:
            return tag + fn(value)
        return wrapper
    return decorate

def scale_by(factor: i32) -> Function[[Function[[i32], i32]], Function[[i32], i32]]:
    def decorate(fn: Function[[i32], i32]) -> Function[[i32], i32]:
        def wrapper(value: i32) -> i32:
            return fn(value) * factor
        return wrapper
    return decorate

@prefix(">> ")
def shout(value: str) -> str:
    return value.upper()

@prefix("a")
@prefix("b")
def tagged(value: str) -> str:
    return value

@scale_by(3)
@scale_by(2)
def base(value: i32) -> i32:
    return value

def main() -> i32:
    # `@name(args)` evaluates the factory once, at module initialization.
    assert shout("hi") == ">> HI"
    assert tagged("x") == "abx"

    # Bottom-up: base(2) = ((2 * 2) * 3) = 12.
    assert base(2) == 12
    assert base(0) == 0

    print("decorator factory ok", shout("ok"), tagged("y"), base(1))
    return 0
