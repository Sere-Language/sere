def main() -> i32:
    xs: list[i32] = [1, 2, 3]
    xs.append(4)
    xs[0] = 10
    assert len(xs) == 4
    assert xs[0] == 10
    assert 2 in xs
    assert xs + [5] == [10, 2, 3, 4, 5]
    counts: dict[str, i32] = {"a": 1}
    counts["b"] = 2
    assert counts["b"] == 2
    assert "a" in counts
    grid: list[list[i32]] = [[1], [2, 3]]
    assert grid[1][1] == 3
    arr: array[i32] = array[i32](1, 2, 3)
    assert arr[2] == 3
    pair = (1, "two")
    left, right = pair
    assert left == 1
    assert right == "two"
    print("typing collections ok")
    return 0