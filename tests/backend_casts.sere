def widen(value: i32) -> i64:
    return value

def narrow(value: i64) -> i32:
    return value as i32

def real(value: i32) -> f64:
    return value

def integer(value: f64) -> i32:
    return value as i32

def main() -> i32:
    print(widen(-7))
    print(narrow(42))
    print(real(9))
    print(integer(3.5))
    return 0
