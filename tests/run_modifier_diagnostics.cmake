set(ENV{SERE_STDLIB} "${STDLIB}")
file(MAKE_DIRECTORY "${OUTPUT}")
function(reject name source expected)
  file(WRITE "${OUTPUT}/${name}.sere" "${source}\ndef main() -> i32:\n    return 0\n")
  execute_process(COMMAND "${COMPILER}" --emit-llvm "${OUTPUT}/${name}.sere"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(result STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}" OR
     "${out}${err}" MATCHES "compiler bug|LLVM ERROR")
    message(FATAL_ERROR "${name}: expected ${expected}:\n${out}${err}")
  endif()
endfunction()
set(getter "type @access:\n    get = @param\n")
reject(missing "${getter}class C:\n    @access x: i32\n" "requires a 'get' argument")
reject(standalone "class C:\n    @param x: i32\n" "only valid inside")
reject(reserved "type @param:\n    get = @public\n" "built-in")
reject(fallback "type @access:\n    get = @private or @public\n" "only @param")
reject(duplicate "${getter}class C:\n    @access[get = self.read, get = self.read] x: i32\n    def read(self) -> i32:\n        return 1\n" "duplicate 'get'")
reject(result "${getter}class C:\n    @access[get = self.read] x: i32\n    def read(self) -> str:\n        return \"bad\"\n" "must match the field type")
reject(value "type @access:\n    set = @param\nclass C:\n    @access[set = self.write] x: i32\n    def write(self, value: str) -> void:\n        pass\n" "must match the field type")
reject(setter_result "type @access:\n    set = @param\nclass C:\n    @access[set = self.write] x: i32\n    def write(self, value: i32) -> i32:\n        return value\n" "must return void")
