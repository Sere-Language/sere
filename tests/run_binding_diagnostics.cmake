set(ENV{SERE_STDLIB} "${STDLIB}")
file(MAKE_DIRECTORY "${OUTPUT}")
function(reject name source expected)
  set(path "${OUTPUT}/${name}.sere")
  file(WRITE "${path}" "${source}")
  execute_process(COMMAND "${COMPILER}" --emit-llvm "${path}" -o "${OUTPUT}/${name}.ll"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT 30)
  if(result STREQUAL "0" OR NOT "${out}${err}" MATCHES "${expected}")
    message(FATAL_ERROR "${name}: expected rejection matching ${expected}:\n${out}${err}")
  endif()
  if("${out}${err}" MATCHES "compiler bug|Incorrect number of arguments|LLVM ERROR")
    message(FATAL_ERROR "${name}: internal error: ${out}${err}")
  endif()
endfunction()
reject(arity "def main() -> i32:\n    a, b, c = (1, 2)\n    return 0\n" "tuple unpacking expects 3")
reject(nested "def main() -> i32:\n    a, (b, c) = (1, 2)\n    return 0\n" "tuple unpacking expects 2")
reject(loop "def main() -> i32:\n    for a, b, c in [(1, 2)]:\n        pass\n    return 0\n" "tuple unpacking expects 3")
reject(target "def main() -> i32:\n    a, 42 = (1, 2)\n    return 0\n" "target must be a name")
reject(infer "def create[T]() -> list[T]:\n    return []\ndef main() -> i32:\n    x = create()\n    return 0\n" "cannot infer type argument 'T'")
reject(conflict "def same[T](a: T, b: T) -> T:\n    return a\ndef main() -> i32:\n    x = same(1, \"s\")\n    return 0\n" "conflicting generic argument types")
reject(explicit "def identity[T](a: T) -> T:\n    return a\ndef main() -> i32:\n    x = identity[i32](\"s\")\n    return 0\n" "expected|cannot pass")
reject(missing "def f[T](a: T, b: i32) -> T:\n    return a\ndef main() -> i32:\n    x = f(1)\n    return 0\n" "missing|required|takes")
reject(extra "def f[T](a: T) -> T:\n    return a\ndef main() -> i32:\n    x = f(1, 2)\n    return 0\n" "too many|takes")
reject(reassign "def main() -> i32:\n    a: str = \"s\"\n    a, b = (1, 2)\n    return 0\n" "cannot unpack")
