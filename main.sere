import fs

class Person:
    """Person Class"""
    @private name: str
    @private age: i32

    def __init__(self, name: str, age: i32) -> None:
        self.name = name
        self.age = age

    def get_name(self) -> str:
        return self.name

    def get_age(self) -> i32:
        return self.age

    def __len__(self) -> i64:
        return self.age as i64

    def introduce(self) -> str:
        return f"Hello, my name is {self.name}, I am {self.age} years old."

    def __str__(self) -> str:
        return f"Person(name={self.name}, age={self.age})"

class Mayor(Person):
    @private city: str

    def __init__(self, name: str, age: i32, city: str) -> None:
        super().__init__(name, age)
        self.city = city


    def introduce(self) -> str:
        return f"Hello, my name is {self.name}, I am {self.age} years old, and I am the mayor of {self.city}."

def print_name(person: Person | str) -> None:
    if person is str:
        print(person)
    elif person is Mayor:
        print("This is the mayor!")
        print(person.get_name())
    else:
        print("This is a person!")
        print(person.get_name())

def main(argv: list[str]) -> None:
    print([1, 2, 3])
    print(argv)
    person = Person("Alice", 25)
    introduction = person.introduce()
    print(introduction)

    mayor = Mayor("Bob", 45, "Springfield")
    mayor_introduction = mayor.introduce()
    print(mayor_introduction)

    print(f"len: {len(person)}")
    print_name(mayor)
    print_name(person)
    print_name("Bob")
    print([person, mayor])
    ls = [person, mayor]
    print(ls)
