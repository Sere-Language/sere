def infer_type[T](value: T) -> void:
    if value is i32:
        print("int branch")
        print(value + 1)
    else:
        print("other branch")
        print(value)

def get_number() -> Iterator[i32]:
    yield 1
    yield 2
    yield 3
    yield 4

def main() -> i32:
    x: i32 = 0
    y: str = "hi"
    #infer_type[i32](x)
    #infer_type[str](y)
    #print((x as i64) + 10)
    for i in get_number():
        print(i)
    return 0
