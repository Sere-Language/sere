
enum Animal:
    Dog(name: str)
    Cat(name: str)

def print_output(func: Callable[[], str]) -> Callable[[], str]:
    result = func()
    print(result)
    return func

@print_output
def foo() -> str:
    return "Bar"
def main() -> i32:
    foo()
    pet = Animal.Dog("Buddy")
    match pet:
        case Animal.Dog(name):
            print(f"This is a dog named {name}.")
        case Animal.Cat(name):
            print(f"This is a cat named {name}.")
    return 0
