

enum Result[T]:
    Ok(T)
    Err(str)

    def unwrap(self) -> T:
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(message):
                raise Exception(message)

    def try_unwrap(self) -> T | None:
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(_):
                return None

    def is_ok(self) -> bool:
        match self:
            case Result.Ok(_):
                return True
            case Result.Err(_):
                return False

def greet(name: str) -> Result[str]:
    if name == "Jessica":
        return Result.Err("Cannot greet Jessica")
    return Result.Ok(f"Hello, {name}!")

def main() -> i32:
    greet1 = greet("John")
    greet1_str = greet1.unwrap()
    print(greet1_str)

    greet2 = greet("Jessica")
    greet2_str = greet2.try_unwrap()
    print(greet2_str))

    greet2.unwrap()

    return 0
