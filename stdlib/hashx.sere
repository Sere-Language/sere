extern "C" "sere_hash_basis"
def new_state() -> i64
"""Return the offset basis."""

extern "C" "sere_hash_update"
def fnv1a_update(state: i64, text: str) -> i64
"""Fold text into a state."""

FNV_PRIME: i64 = 1099511628211


class Hasher:
    """Minimal hasher."""

    state: i64

    def __init__(self, seed: i64 = 0):
        """Create a hasher."""
        if seed == 0:
            self.state = new_state()
        else:
            self.state = seed

    def write(self, text: str) -> Hasher:
        """Fold text."""
        self.state = fnv1a_update(self.state, text)
        return self

    def finish(self) -> i64:
        """Return the state."""
        return self.state
