# ---------------------------------------------------------------------------
# Platform identity
# ---------------------------------------------------------------------------

def platform() -> Platform:
    """Return the host operating-system family."""
    name: str = _platform_name()
    if name == "windows":
        return Platform.Windows
    if name == "linux":
        return Platform.Linux
    if name == "macos":
        return Platform.Macos
    return Platform.Unknown


def platform_code() -> i32:
    """Return the host family as a PLATFORM_* constant."""
    kind: Platform = platform()
    if kind == Platform.Windows:
        return PLATFORM_WINDOWS
    if kind == Platform.Linux:
        return PLATFORM_LINUX
    if kind == Platform.Macos:
        return PLATFORM_MACOS
    return PLATFORM_UNKNOWN


def is_windows() -> bool:
    """Return whether the host is Windows."""
    return _platform_name() == "windows"


def is_linux() -> bool:
    """Return whether the host is Linux."""
    return _platform_name() == "linux"


def is_macos() -> bool:
    """Return whether the host is macOS."""
    return _platform_name() == "macos"


def is_unix() -> bool:
    """Return whether the host is Unix-like."""
    return is_linux() or is_macos()


def endianness() -> Endianness:
    """Return the host byte order."""
    if _endianness_code() == 0:
        return Endianness.Little
    return Endianness.Big


def path_separator() -> str:
    """Return the directory separator for this platform."""
    if _separator_code() == 92:
        return "\\"
    return "/"


def separator() -> str:
    """Return the directory separator for this platform."""
    return path_separator()


def path_list_separator() -> str:
    """Return the separator used between PATH entries."""
    if _list_separator_code() == 59:
        return ";"
    return ":"


def cpu_count() -> i64:
    """Return the number of logical CPUs."""
    return _logical_cpu_count() as i64


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

def has_env(name: str) -> bool:
    """Return whether an environment variable is set (even when empty)."""
    return _env_has(name) != 0


def setenv(name: str, value: str) -> bool:
    """Set an environment variable."""
    return _env_set(name, value) != 0


def unsetenv(name: str) -> bool:
    """Remove an environment variable."""
    return _env_remove(name) != 0


def getenv_or(name: str, fallback: str) -> str:
    """Return an environment variable value, or fallback when unset."""
    if has_env(name):
        return getenv(name)
    return fallback


def env_items() -> list[EnvVar]:
    """Return the environment as decoded name/value pairs."""
    raw: list[str] = environ()
    result: list[EnvVar] = []
    for i in range(len(raw)):
        entry: str = raw[i]
        separator_index: i64 = string.find(entry, "=")
        if separator_index < 0:
            result.append(EnvVar(entry, ""))
        else:
            result.append(EnvVar(entry[0:separator_index], entry[separator_index + 1:]))
    return result


def env_lookup(name: str) -> str:
    """Return an environment value by scanning the decoded environment."""
    items: list[EnvVar] = env_items()
    for i in range(len(items)):
        if items[i].name == name:
            return items[i].value
    return ""

# ---------------------------------------------------------------------------
# Paths and directories
# ---------------------------------------------------------------------------

def is_absolute(path: str) -> bool:
    """Test whether a path is absolute."""
    return _is_absolute(path) != 0


def exists(path: str) -> bool:
    """Return whether a path exists."""
    return _fs_exists(path) != 0


def is_file(path: str) -> bool:
    """Return whether a path is a regular file."""
    return _fs_is_file(path) != 0


def is_dir(path: str) -> bool:
    """Return whether a path is a directory."""
    return _fs_is_dir(path) != 0


def is_symlink(path: str) -> bool:
    """Return whether a path is a symbolic link."""
    return _is_symlink(path) != 0


def chdir(path: str) -> bool:
    """Change the current working directory."""
    return _chdir(path) != 0


def listdir_sorted(path: str) -> list[str]:
    """Return a directory's entries in ascending order."""
    entries: list[str] = listdir(path)
    count: i64 = len(entries)
    passes: i64 = 0
    while passes < count:
        index: i64 = 0
        while index + 1 < count:
            if entries[index + 1] < entries[index]:
                temporary: str = entries[index]
                entries[index] = entries[index + 1]
                entries[index + 1] = temporary
            index = index + 1
        passes = passes + 1
    return entries


def mkdir(path: str) -> bool:
    """Create a directory."""
    return mkdir_mode(path, 0o777)


def mkdir_mode(path: str, mode: i32) -> bool:
    """Create a directory with the given permission bits."""
    return _mkdir_mode(path, mode) != 0


def makedirs(path: str) -> bool:
    """Create a directory and any missing parents; succeeds if it exists."""
    return _makedirs(path, 0o777, 1) != 0


def makedirs_mode(path: str, mode: i32) -> bool:
    """Create a directory tree with the given permission bits."""
    return _makedirs(path, mode, 1) != 0


def rmdir(path: str) -> bool:
    """Remove an empty directory."""
    return _rmdir(path) != 0


def remove(path: str) -> bool:
    """Remove a file, symlink, or empty directory."""
    return _fs_remove(path) != 0


def remove_tree(path: str) -> bool:
    """Recursively delete a directory tree without following symlinks."""
    return _remove_tree(path, 0) != 0


def walk(path: str) -> list[str]:
    """Return every file path beneath a directory, depth first."""
    found: list[str] = []
    walk_into(path, found)
    return found


def walk_into(path: str, out: list[str]) -> void:
    """Append every file beneath a directory to out."""
    entries: list[str] = listdir(path)
    for i in range(len(entries)):
        child: str = join_path(path, entries[i])
        if is_dir(child):
            walk_into(child, out)
        else:
            out.append(child)

# ---------------------------------------------------------------------------
# Files and metadata
# ---------------------------------------------------------------------------

def kind(path: str) -> i32:
    """Return the KIND_* code of a path."""
    return _stat_kind(path, 1)


def kind_of(path: str) -> FileKind:
    """Return the FileKind of a path."""
    code: i32 = _stat_kind(path, 1)
    if code == KIND_FILE:
        return FileKind.File
    if code == KIND_DIRECTORY:
        return FileKind.Directory
    if code == KIND_SYMLINK:
        return FileKind.Symlink
    return FileKind.Other


def file_size(path: str) -> i64:
    """Return a path's size in bytes, or 0 when unreadable."""
    return _stat_size(path, 1)


def stat(path: str) -> FileStat:
    """Return metadata for a path, following symbolic links."""
    return stat_impl(path, 1)


def lstat(path: str) -> FileStat:
    """Return metadata for a path without following symbolic links."""
    return stat_impl(path, 0)


def stat_impl(path: str, follow: i32) -> FileStat:
    """Build a FileStat from the native field accessors."""
    if _fs_exists(path) == 0 and not is_symlink(path):
        return FileStat(False, 0, 0, KIND_OTHER, 0, 0, 0, 0, 0, 0, 0, 0, 0)
    return FileStat(
        True,
        _stat_size(path, follow),
        _stat_mode(path, follow),
        _stat_kind(path, follow),
        _stat_inode(path, follow),
        _stat_device(path, follow),
        _stat_links(path, follow),
        _stat_uid(path, follow),
        _stat_gid(path, follow),
        _stat_atime_ns(path, follow),
        _stat_mtime_ns(path, follow),
        _stat_ctime_ns(path, follow),
        _stat_birth_ns(path, follow))


def rename(src: str, dst: str) -> bool:
    """Rename a path."""
    if _rename(src, dst) != 0:
        return True
    if is_windows():
        return replace(src, dst)
    return False


def replace(src: str, dst: str) -> bool:
    """Rename a path, replacing the destination when it exists."""
    return _replace(src, dst) != 0


def copy_file(src: str, dst: str, overwrite: bool = True) -> bool:
    """Copy a file's bytes."""
    flag: i32 = 0
    if overwrite:
        flag = 1
    return _copy_file(src, dst, flag) != 0


def copy(src: str, dst: str, overwrite: bool = True) -> bool:
    """Copy a file, or a whole directory tree, to dst."""
    if is_dir(src):
        return copy_tree(src, dst, overwrite)
    return copy_file(src, dst, overwrite)


def copy_tree(src: str, dst: str, overwrite: bool = True) -> bool:
    """Recursively copy a directory tree; symlinks are not followed."""
    if not is_dir(src):
        return False
    if not exists(dst):
        if not makedirs(dst):
            return False
    entries: list[str] = listdir(src)
    for i in range(len(entries)):
        from_path: str = join_path(src, entries[i])
        to_path: str = join_path(dst, entries[i])
        if is_symlink(from_path):
            continue
        if is_dir(from_path):
            if not copy_tree(from_path, to_path, overwrite):
                return False
        else:
            if not copy_file(from_path, to_path, overwrite):
                return False
    return True


def symlink(target: str, link: str) -> bool:
    """Create a symbolic link named link that points at target."""
    return _symlink(target, link) != 0


def hardlink(existing: str, link: str) -> bool:
    """Create a hard link to an existing file."""
    return _hardlink(existing, link) != 0


def chmod(path: str, mode: i32) -> bool:
    """Change a path's permission bits."""
    return _chmod(path, mode) != 0


def access(path: str, mode: i32) -> bool:
    """Test a path against F_OK/R_OK/W_OK/X_OK; OR modes for combinations."""
    return _access(path, mode) != 0


def is_readable(path: str) -> bool:
    """Return whether a path exists and is readable."""
    return _access(path, R_OK) != 0


def is_writable(path: str) -> bool:
    """Return whether a path exists and is writable."""
    return _access(path, W_OK) != 0


def is_executable(path: str) -> bool:
    """Return whether a path exists and is executable."""
    return _access(path, X_OK) != 0


def utime(path: str, access_ns: i64, modify_ns: i64) -> bool:
    """Set a path's access and modification times."""
    return _utime(path, access_ns, modify_ns) != 0


def touch(path: str) -> bool:
    """Create an empty file when missing, otherwise update its times."""
    stamp: i64 = time_ns()
    if exists(path):
        return _utime(path, stamp, stamp) != 0
    fd: i64 = open_fd(path, OPEN_WRITE + OPEN_CREATE)
    if fd < 0:
        return False
    return close_fd(fd)


def truncate(path: str, size: i64) -> bool:
    """Resize a file to the given length."""
    fd: i64 = open_fd(path, OPEN_WRITE)
    if fd < 0:
        return False
    ok: bool = tdtruncate(fd, size)
    return close_fd(fd) and ok


def tdtruncate(fd: i64, size: i64) -> bool:
    """Truncate an open file to a length."""
    return _truncate_fd(fd, size) != 0

# ---------------------------------------------------------------------------
# Descriptors
# ---------------------------------------------------------------------------

def open_fd(path: str, flags: i32, mode: i32 = 0o666) -> i64:
    """Open a raw file descriptor, or -1 on failure."""
    return _open_fd_raw(path, flags, mode)


def seek_fd(fd: i64, offset: i64, whence: i32 = 0) -> i64:
    """Reposition a descriptor and return the new offset."""
    return _seek_fd_raw(fd, offset, whence)


def close_fd(fd: i64) -> bool:
    """Close a raw file descriptor."""
    if fd < 0:
        return False
    return _close_fd(fd) != 0


def read_fd(fd: i64, size: i64 = 4096) -> list[i8]:
    """Read up to size bytes from a descriptor."""
    if fd < 0 or size <= 0:
        return []
    buffer: array[i8] = _byte_buffer(1, size)
    count: i64 = _read_fd(fd, &buffer[0], size)
    result: list[i8] = []
    if count > 0:
        for i in range(count):
            result.append(buffer[i])
    return result


def write_fd(fd: i64, data: list[i8]) -> i64:
    """Write a byte list to a descriptor and return the byte count."""
    if fd < 0 or len(data) == 0:
        return 0
    return _write_fd(fd, &data[0], len(data) as i64)


def read_all_fd(fd: i64, chunk: i64 = 65536) -> list[i8]:
    """Read a descriptor to end of file."""
    if fd < 0 or chunk <= 0:
        return []
    result: list[i8] = []
    while True:
        part: list[i8] = read_fd(fd, chunk)
        if len(part) == 0:
            break
        for i in range(len(part)):
            result.append(part[i])
        if len(part) < chunk:
            break
    return result


def read_bytes(path: str) -> list[i8]:
    """Read a whole file as a byte list, or [] on failure."""
    fd: i64 = open_fd(path, OPEN_READ)
    if fd < 0:
        return []
    size: i64 = file_size(path)
    result: list[i8] = []
    if size > 0:
        result = read_all_fd(fd, size)
    close_fd(fd)
    return result


def write_bytes(path: str, data: list[i8]) -> i64:
    """Write a byte list to a file, replacing its contents."""
    fd: i64 = open_fd(path, OPEN_WRITE + OPEN_CREATE + OPEN_TRUNCATE)
    if fd < 0:
        return -1
    written: i64 = write_fd(fd, data)
    close_fd(fd)
    return written


def fsync(fd: i64) -> bool:
    """Flush a descriptor's data and metadata to storage."""
    return _fsync_fd(fd) != 0


def fdatasync(fd: i64) -> bool:
    """Flush a descriptor's data to storage."""
    return _fdatasync_fd(fd) != 0


def isatty(fd: i64 = 1) -> bool:
    """Return whether a descriptor is a terminal."""
    return _fd_isatty(fd) != 0


def terminal_size(fd: i64 = 1) -> TerminalSize:
    """Return a terminal's size; zeroes when the size is unknown."""
    return TerminalSize(_terminal_columns(fd), _terminal_rows(fd))


class FileDescriptor:
    """A raw operating-system file descriptor."""

    _fd: i64
    _path: str

    def __init__(self, path: str, flags: i32, mode: i32 = 0o666):
        """Open a path and wrap its descriptor."""
        self._path = path
        self._fd = open_fd(path, flags, mode)

    def valid(self) -> bool:
        """Return whether the descriptor is open."""
        return self._fd >= 0

    def fileno(self) -> i64:
        """Return the underlying descriptor number."""
        return self._fd

    def read(self, size: i64 = 4096) -> list[i8]:
        """Read up to size bytes."""
        return read_fd(self._fd, size)

    def read_all(self) -> list[i8]:
        """Read to end of file."""
        return read_all_fd(self._fd)

    def write(self, data: list[i8]) -> i64:
        """Write bytes."""
        return write_fd(self._fd, data)

    def seek(self, offset: i64, whence: i32 = 0) -> i64:
        """Reposition the descriptor."""
        return seek_fd(self._fd, offset, whence)

    def tell(self) -> i64:
        """Return the current offset."""
        return tell_fd(self._fd)

    def size(self) -> i64:
        """Return the current file size."""
        return file_size(self._path)

    def truncate(self, size: i64) -> bool:
        """Truncate the file."""
        return tdtruncate(self._fd, size)

    def sync(self) -> bool:
        """Flush the file's data and metadata to storage."""
        return fsync(self._fd)

    def duplicate(self) -> i64:
        """Duplicate the descriptor."""
        return dup_fd(self._fd)

    def close(self) -> bool:
        """Close the descriptor."""
        if self._fd < 0:
            return False
        result: bool = close_fd(self._fd)
        self._fd = -1
        return result

    def __enter__(self) -> FileDescriptor:
        """Enter a context manager."""
        return self

    def __exit__(self) -> void:
        """Leave a context manager, closing the descriptor."""
        self.close()


def open_descriptor(path: str, flags: i32, mode: i32 = 0o666) -> FileDescriptor:
    """Open a path as a FileDescriptor."""
    return FileDescriptor(path, flags, mode)

# ---------------------------------------------------------------------------
# Pipes
# ---------------------------------------------------------------------------

class Pipe:
    """An anonymous pipe with a read end and a write end."""

    _handle: Handle
    read_fd: i64
    write_fd: i64

    def __init__(self):
        """Create a pipe."""
        self._handle = _pipe_new()
        if self._handle is None:
            self.read_fd = -1
            self.write_fd = -1
            return
        self.read_fd = _pipe_read_fd(self._handle)
        self.write_fd = _pipe_write_fd(self._handle)

    def ok(self) -> bool:
        """Return whether the pipe was created."""
        return self.read_fd >= 0 and self.write_fd >= 0

    def write(self, data: list[i8]) -> i64:
        """Write bytes into the pipe."""
        return write_fd(self.write_fd, data)

    def read(self, size: i64 = 4096) -> list[i8]:
        """Read up to size bytes from the pipe."""
        return read_fd(self.read_fd, size)

    def close(self) -> bool:
        """Close both ends and release the pipe."""
        if self._handle is None:
            return False
        result: bool = _pipe_close(self._handle) != 0
        self._handle = None
        self.read_fd = -1
        self.write_fd = -1
        return result

    def __repr__(self) -> str:
        """Describe the pipe."""
        if self._handle is None:
            return "<closed pipe>"
        return f"<pipe read={self.read_fd} write={self.write_fd}>"

# ---------------------------------------------------------------------------
# Filesystems
# ---------------------------------------------------------------------------

def filesystem(path: str) -> FilesystemInfo:
    """Return capacity information for the filesystem holding a path."""
    total: i64 = fs_total_bytes(path)
    if total <= 0:
        return FilesystemInfo(False, 0, 0, 0, 0)
    return FilesystemInfo(
        True,
        total,
        fs_free_bytes(path),
        fs_available_bytes(path),
        fs_block_size(path))


def disk_usage(path: str) -> FilesystemInfo:
    """Alias of filesystem(); capacity information for path's volume."""
    return filesystem(path)


def total_space(path: str = ".") -> i64:
    """Return the capacity of the filesystem holding path."""
    return fs_total_bytes(path)


def free_space(path: str = ".") -> i64:
    """Return the space available to this user on path's filesystem."""
    return fs_available_bytes(path)


def filesystem_root(path: str) -> str:
    """Return the root directory of the volume that holds path."""
    absolute: str = absolute_path(path)
    if len(absolute) == 0:
        return ""
    if is_windows():
        if len(absolute) >= 2:
            return absolute[0:2] + path_separator()
        return absolute
    return "/"

# ---------------------------------------------------------------------------
# Memory
# ---------------------------------------------------------------------------

def memory() -> MemoryInfo:
    """Return physical and virtual memory information."""
    total: i64 = memory_total()
    if total <= 0:
        return MemoryInfo(False, 0, 0, 0, 0)
    return MemoryInfo(
        True,
        total,
        memory_available(),
        memory_total_virtual(),
        memory_available_virtual())

# ---------------------------------------------------------------------------
# Processes and signals
# ---------------------------------------------------------------------------

def kill(pid_value: i64, signal_number: i32 = SIGTERM) -> bool:
    """Send a signal to a process."""
    if pid_value <= 0:
        return False
    return _kill(pid_value, signal_number) != 0


def terminate(pid_value: i64) -> bool:
    """Ask a process to terminate."""
    return kill(pid_value, SIGTERM)


def raise_signal(signal_number: i32) -> bool:
    """Raise a signal in the current process."""
    return _raise(signal_number) != 0

# ---------------------------------------------------------------------------
# Timing
# ---------------------------------------------------------------------------

def sleep_ns(nanoseconds: i64) -> void:
    """Suspend the current thread for a duration in nanoseconds."""
    _sleep_ns(nanoseconds)


def sleep_ms(milliseconds: i64) -> void:
    """Suspend the current thread for a duration in milliseconds."""
    if milliseconds <= 0:
        return
    _sleep_ns(milliseconds * 1000000)


def sleep(seconds: f64) -> void:
    """Suspend the current thread for a duration in seconds."""
    if seconds <= 0.0:
        return
    _sleep_ns((seconds * 1000000000.0) as i64)


def monotonic_ms() -> i64:
    """Return a monotonic clock reading in milliseconds."""
    return monotonic_ns() / 1000000


def time_ms() -> i64:
    """Return the wall-clock time in milliseconds since the epoch."""
    return time_ns() / 1000000


def time_seconds() -> f64:
    """Return the wall-clock time in seconds since the epoch."""
    return (time_ns() as f64) / 1000000000.0

# ---------------------------------------------------------------------------
# Randomness
# ---------------------------------------------------------------------------

def random_bytes(count: i64) -> list[i8]:
    """Return count cryptographically secure random bytes."""
    if count <= 0:
        return []
    buffer: array[i8] = _byte_buffer(1, count)
    if _random_bytes(&buffer[0], count) == 0:
        return []
    result: list[i8] = []
    for i in range(count):
        result.append(buffer[i])
    return result


def random_fill(buffer: array[i8]) -> bool:
    """Fill a byte array with cryptographically secure random data."""
    if len(buffer) == 0:
        return False
    return _random_bytes(&buffer[0], len(buffer) as i64) != 0


def random_i64() -> i64:
    """Return a random signed 64-bit integer."""
    raw: list[i8] = random_bytes(8)
    if len(raw) < 8:
        return 0
    value: i64 = 0
    for i in range(8):
        byte_value: i64 = raw[i] as i64
        if byte_value < 0:
            byte_value = byte_value + 256
        value = value + byte_value * shift_bits(i)
    return value


def shift_bits(index: i64) -> i64:
    """Return 256 raised to an index (little-endian byte placement)."""
    result: i64 = 1
    step: i64 = 0
    while step < index:
        result = result * 256
        step = step + 1
    return result

# ---------------------------------------------------------------------------
# Executables and dynamic libraries
# ---------------------------------------------------------------------------

def find_executable(name: str) -> str:
    """Resolve an executable name against PATH."""
    return which(name)


def command_exists(name: str) -> bool:
    """Return whether an executable can be found on PATH."""
    return which(name) != ""


class Library:
    """A loaded shared library."""

    _handle: Handle
    _path: str

    def __init__(self, path: str):
        """Load a shared library."""
        self._path = path
        self._handle = _library_open(path)

    def ok(self) -> bool:
        """Return whether the library loaded."""
        return self._handle is not None

    def symbol(self, name: str) -> Handle:
        """Return an exported symbol address, or None when missing."""
        if self._handle is None:
            return None
        return _library_symbol(self._handle, name)

    def has_symbol(self, name: str) -> bool:
        """Return whether the library exports a symbol."""
        return self.symbol(name) is not None

    def close(self) -> bool:
        """Unload the library."""
        if self._handle is None:
            return False
        result: bool = _library_close(self._handle) != 0
        self._handle = None
        return result

    def __enter__(self) -> Library:
        """Enter a context manager."""
        return self

    def __exit__(self) -> void:
        """Leave a context manager, unloading the library."""
        self.close()

    def __repr__(self) -> str:
        """Describe the library."""
        if self._handle is None:
            return f"<closed library '{self._path}'>"
        return f"<library '{self._path}'>"


def load_library(path: str) -> Library:
    """Load a shared library."""
    return Library(path)

# ---------------------------------------------------------------------------
# Host summary
# ---------------------------------------------------------------------------

def describe() -> str:
    """Return a one-line summary of the host and its resources."""
    info: MemoryInfo = memory()
    return _platform_name() + " " + arch() + " host=" + hostname() + " cpus=" + str(cpu_count()) + " memory=" + str(info.total)
