# Operating-system interface. Import with: import os
#
# A cross-platform OS foundation: platform identity, environment, paths,
# directories, files and metadata, permission bits, raw file descriptors,
# pipes, terminals, filesystem capacity, processes and signals, users,
# memory and CPU information, monotonic timing, secure randomness, and
# dynamic libraries.
#
# Conventions:
#   * Native work lives in C (runtime/sere_sys.c); the wrappers here are thin.
#   * Paths and text cross the boundary as UTF-8.
#   * Predicates (`is_dir`, `exists`, `access`) return bool.
#   * Operations that can fail return bool rather than throwing.
#   * Queries never return optionals; result structs carry an `ok` flag and
#     leave their remaining fields zeroed when the query failed. This keeps
#     call sites free of optional narrowing.
#   * Host differences are hidden behind `Platform`: `mkdir_mode` ignores
#     `mode` on Windows, `umask` returns 0 there, and `user_id`/`group_id`
#     report 0.

import string

# ---------------------------------------------------------------------------
# Core types
# ---------------------------------------------------------------------------

type Handle = Ptr[i8]

# ---------------------------------------------------------------------------
# Enums
# ---------------------------------------------------------------------------

enum Platform:
    """Operating-system families."""
    Windows
    Linux
    Macos
    Unknown


enum FileKind:
    """The kind of filesystem object a path names."""
    Other
    File
    Directory
    Symlink


enum Endianness:
    """Host byte order."""
    Little
    Big


# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

# Platform codes, matching os.Platform variant order.
const PLATFORM_WINDOWS: i32 = 0
const PLATFORM_LINUX: i32 = 1
const PLATFORM_MACOS: i32 = 2
const PLATFORM_UNKNOWN: i32 = 3

# File kinds reported by FileStat.kind and kind().
const KIND_OTHER: i32 = 0
const KIND_FILE: i32 = 1
const KIND_DIRECTORY: i32 = 2
const KIND_SYMLINK: i32 = 3

# Open flags for open_fd(); OR them together. The values are identical on
# every host and the native layer translates them to O_* or CreateFile flags.
const OPEN_READ: i32 = 1
const OPEN_WRITE: i32 = 2
const OPEN_CREATE: i32 = 4
const OPEN_TRUNCATE: i32 = 8
const OPEN_APPEND: i32 = 16
const OPEN_EXCLUSIVE: i32 = 32

# Access modes for access().
const F_OK: i32 = 0
const R_OK: i32 = 4
const W_OK: i32 = 2
const X_OK: i32 = 1

# Seek origins for seek_fd().
const SEEK_SET: i32 = 0
const SEEK_CUR: i32 = 1
const SEEK_END: i32 = 2

# Standard descriptor numbers.
const STDIN_FD: i64 = 0
const STDOUT_FD: i64 = 1
const STDERR_FD: i64 = 2

# Permission bits (POSIX numbering; Windows honours only the write bit).
const S_IRUSR: i32 = 0o400
const S_IWUSR: i32 = 0o200
const S_IXUSR: i32 = 0o100
const S_IRGRP: i32 = 0o040
const S_IWGRP: i32 = 0o020
const S_IXGRP: i32 = 0o010
const S_IROTH: i32 = 0o004
const S_IWOTH: i32 = 0o002
const S_IXOTH: i32 = 0o001
const S_IRWXU: i32 = 0o700

# Signal numbers for raise_signal() and kill().
const SIGHUP: i32 = 1
const SIGINT: i32 = 2
const SIGQUIT: i32 = 3
const SIGABRT: i32 = 6
const SIGKILL: i32 = 9
const SIGUSR1: i32 = 10
const SIGSEGV: i32 = 11
const SIGPIPE: i32 = 13
const SIGALRM: i32 = 14
const SIGTERM: i32 = 15

# ---------------------------------------------------------------------------
# Structs
# ---------------------------------------------------------------------------

struct FileStat:
    """Metadata for a filesystem object.

    `ok` is False when the path could not be read, in which case every other
    field is zero. `kind` is one of the KIND_* constants and `mode` is the raw
    POSIX permission bits (Windows reports 0444 or 0666). Timestamps are
    nanoseconds since the Unix epoch.
    """
    ok: bool
    size: i64
    mode: i32
    kind: i32
    inode: i64
    device: i64
    links: i64
    uid: i64
    gid: i64
    atime_ns: i64
    mtime_ns: i64
    ctime_ns: i64
    birth_ns: i64


struct TerminalSize:
    """Terminal dimensions in character cells; zeroes when unknown."""
    columns: i32
    rows: i32


struct MemoryInfo:
    """Physical and virtual memory, in bytes."""
    ok: bool
    total: i64
    available: i64
    total_virtual: i64
    available_virtual: i64


struct FilesystemInfo:
    """Capacity of the filesystem that holds a path, in bytes."""
    ok: bool
    total_bytes: i64
    free_bytes: i64
    available_bytes: i64
    block_size: i64


struct EnvVar:
    """One environment entry, split at the first '='."""
    name: str
    value: str


