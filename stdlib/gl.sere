enum Primitive:
    Points = 0
    Lines = 1
    LineLoop = 2
    LineStrip = 3
    Triangles = 4
    TriangleStrip = 5
    TriangleFan = 6
    LinesAdjacency = 10
    LineStripAdjacency = 11
    TrianglesAdjacency = 12
    TriangleStripAdjacency = 13
    Patches = 14

@flags
enum ClearMask:
    Depth = 256
    Stencil = 1024
    Color = 16384
    DEPTH_BUFFER_BIT = 256
    STENCIL_BUFFER_BIT = 1024
    COLOR_BUFFER_BIT = 16384

enum Buffer:
    Color = 16384
    Depth = 256
    Stencil = 1024
    COLOR_BUFFER_BIT = 16384
    DEPTH_BUFFER_BIT = 256
    STENCIL_BUFFER_BIT = 1024

enum ShaderKind:
    Fragment = 35632
    Vertex = 35633
    Geometry = 36313
    TessEvaluation = 36487
    TessControl = 36488
    Compute = 37305

enum Capability:
    Fog = 2912
    Lighting = 2896
    LineSmooth = 2848
    PointSmooth = 2832
    CullFace = 2884
    DepthTest = 2929
    StencilTest = 2960
    Dither = 3024
    Blend = 3042
    ColorMaterial = 2903
    ColorLogicOp = 3058
    ScissorTest = 3089
    Texture1D = 3552
    Texture2D = 3553
    TextureCubeMap = 34067
    PolygonOffsetPoint = 10753
    PolygonOffsetLine = 10754
    PolygonOffsetFill = 32823
    Multisample = 32925
    SampleAlphaToCoverage = 32926
    SampleCoverage = 32928
    DepthClamp = 34383
    ProgramPointSize = 34370
    RasterizerDiscard = 35977
    FramebufferSrgb = 36281
    ClipDistance0 = 12288
    ClipDistance1 = 12289
    ClipDistance2 = 12290
    ClipDistance3 = 12291

enum BlendFactor:
    Zero = 0
    One = 1
    SrcColor = 768
    OneMinusSrcColor = 769
    SrcAlpha = 770
    OneMinusSrcAlpha = 771
    DstAlpha = 772
    OneMinusDstAlpha = 773
    DstColor = 774
    OneMinusDstColor = 775
    SrcAlphaSaturate = 776
    ConstantColor = 32769
    OneMinusConstantColor = 32770
    ConstantAlpha = 32771
    OneMinusConstantAlpha = 32772
    Src1Color = 35065
    OneMinusSrc1Color = 35066
    Src1Alpha = 34185
    OneMinusSrc1Alpha = 35067

enum BlendEquation:
    Add = 32774
    Subtract = 32778
    ReverseSubtract = 32779
    Min = 32775
    Max = 32776

enum StencilOp:
    Zero = 0
    Invert = 5386
    Keep = 7680
    Replace = 7681
    Incr = 7682
    Decr = 7683
    IncrWrap = 34055
    DecrWrap = 34056

enum Hint:
    Perspective = 3152
    PointSmooth = 3153
    LineSmooth = 3154
    PolygonSmooth = 3155
    Fog = 3156
    GenerateMipmap = 33170
    TextureCompression = 34031
    FragmentShaderDerivative = 35723

enum HintMode:
