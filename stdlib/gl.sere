class Color:
    r: f64
    g: f64
    b: f64
    a: f64

    def apply(self) -> void:
        clear_color(self.r, self.g, self.b, self.a)

    def use3(self) -> void:
        color3(self.r, self.g, self.b)

    def use4(self) -> void:
        color4(self.r, self.g, self.b, self.a)

    def with_alpha(self, a: f64) -> Color:
        return Color(self.r, self.g, self.b, a)

    def scaled(self, s: f64) -> Color:
        return Color(self.r * s, self.g * s, self.b * s, self.a)

    def lerp(self, other: Color, t: f64) -> Color:
        u: f64 = 1.0 - t
        return Color(self.r * u + other.r * t, self.g * u + other.g * t, self.b * u + other.b * t, self.a * u + other.a * t)

    def r8(self) -> i32:
        return (self.r * 255.0) as i32

    def g8(self) -> i32:
        return (self.g * 255.0) as i32

    def b8(self) -> i32:
        return (self.b * 255.0) as i32

    def a8(self) -> i32:
        return (self.a * 255.0) as i32

    def clamp01(self) -> Color:
        r: f64 = self.r
        g: f64 = self.g
        b: f64 = self.b
        a: f64 = self.a
        if r < 0.0:
            r = 0.0
        if r > 1.0:
            r = 1.0
        if g < 0.0:
            g = 0.0
        if g > 1.0:
            g = 1.0
        if b < 0.0:
            b = 0.0
        if b > 1.0:
            b = 1.0
        if a < 0.0:
            a = 0.0
        if a > 1.0:
            a = 1.0
        return Color(r, g, b, a)

    def premul(self) -> Color:
        return Color(self.r * self.a, self.g * self.a, self.b * self.a, self.a)

    def invert(self) -> Color:
        return Color(1.0 - self.r, 1.0 - self.g, 1.0 - self.b, self.a)

    def gray(self) -> f64:
        return self.r * 0.2126 + self.g * 0.7152 + self.b * 0.0722

    def to_u32(self) -> i32:
        r: i32 = self.r8()
        g: i32 = self.g8()
        b: i32 = self.b8()
        a: i32 = self.a8()
        return ((a & 255) << 24) + ((r & 255) << 16) + ((g & 255) << 8) + (b & 255)

    def __str__(self) -> str:
        return f"Color({self.r}, {self.g}, {self.b}, {self.a})"

class Window:
    ptr: Ptr[i8]
    title: str

    def __init__(self, title: str, width: i32, height: i32, flags: i32 = 0) -> void:
        self.title = title
        self.ptr = _window_new_ex(title, width, height, flags)

    def __bool__(self) -> bool:
        return self.is_open()

    def ok(self) -> bool:
        return self.is_open()

    def poll_events(self) -> bool:
        return _window_poll(self.ptr) as bool

    def poll(self) -> bool:
        return self.poll_events()

    def wait(self) -> bool:
        return _window_wait(self.ptr) as bool

    def should_close(self) -> bool:
        return _window_should_close(self.ptr) as bool

    def set_should_close(self, value: bool) -> void:
        _window_set_should_close(self.ptr, value as i32)

    def set_flag(self, flag: WindowFlag, value: bool) -> void:
        if flag.value == WindowFlag.Visible.value:
            if value:
                self.show()
            else:
                self.hide()
        elif flag.value == WindowFlag.Resizable.value:
            self.set_resizable(value)
        elif flag.value == WindowFlag.Decorated.value:
            self.set_decorated(value)
        elif flag.value == WindowFlag.Maximized.value:
            if value:
                self.maximize()
            else:
                self.restore()
        elif flag.value == WindowFlag.Floating.value:
            self.set_floating(value)
        elif flag.value == WindowFlag.Focused.value:
            if value:
                self.focus()
        elif flag.value == WindowFlag.Fullscreen.value:
            self.set_fullscreen(value)
        elif flag.value == WindowFlag.Vsync.value:
            self.set_vsync(value)

    def flag(self, which: WindowFlag) -> bool:
        if which.value == WindowFlag.Visible.value:
            return self.visible()
        if which.value == WindowFlag.Resizable.value:
            return self.resizable()
        if which.value == WindowFlag.Decorated.value:
            return self.decorated()
        if which.value == WindowFlag.Maximized.value:
            return self.maximized()
        if which.value == WindowFlag.Floating.value:
            return self.floating()
        if which.value == WindowFlag.Focused.value:
            return self.focused()
        if which.value == WindowFlag.Fullscreen.value:
            return self.fullscreen()
        if which.value == WindowFlag.Vsync.value:
            return self.vsync()
        return False

    def close(self) -> void:
        _window_set_should_close(self.ptr, 1)

    def keep_open(self) -> void:
        _window_set_should_close(self.ptr, 0)

    def is_open(self) -> bool:
        return _window_is_open(self.ptr) as bool

    def swap_buffers(self) -> void:
        _window_swap(self.ptr)

    def flip(self) -> void:
        self.swap_buffers()

    def set_as_current(self) -> void:
        _window_make_current(self.ptr)

    def width(self) -> i32:
        return _window_width(self.ptr)

    def height(self) -> i32:
        return _window_height(self.ptr)

    def fb_width(self) -> i32:
        return _window_fb_width(self.ptr)

    def fb_height(self) -> i32:
        return _window_fb_height(self.ptr)

    def x(self) -> i32:
        return _window_x(self.ptr)

    def y(self) -> i32:
        return _window_y(self.ptr)

    def aspect(self) -> f64:
        h: i32 = self.height()
        if h == 0:
            return 1 as f64
        return (self.width() as f64) / (h as f64)

    def set_title(self, title: str) -> void:
        self.title = title
        _window_set_title(self.ptr, title)

    def get_title(self) -> str:
        return _window_title(self.ptr)

    def set_vsync(self, enabled: bool) -> void:
        _window_set_vsync(self.ptr, enabled as i32)

    def vsync(self) -> bool:
        return _window_vsync(self.ptr) as bool

    def show_cursor(self, show: bool) -> void:
        _window_show_cursor(self.ptr, show as i32)

    def set_cursor(self, mode: CursorMode) -> void:
        _window_set_cursor_mode(self.ptr, mode.value)

    def cursor(self) -> i32:
        return _window_cursor_mode(self.ptr)

    def cursor_normal(self) -> void:
        self.set_cursor(CursorMode.Normal)

    def cursor_hidden(self) -> void:
        self.set_cursor(CursorMode.Hidden)

    def cursor_disabled(self) -> void:
        self.set_cursor(CursorMode.Disabled)

    def cursor_captured(self) -> void:
        self.set_cursor(CursorMode.Captured)

    def set_cursor_pos(self, x: i32, y: i32) -> void:
        _window_set_cursor_pos(self.ptr, x, y)

    def set_size(self, width: i32, height: i32) -> void:
        _window_set_size(self.ptr, width, height)

    def set_pos(self, x: i32, y: i32) -> void:
        _window_set_pos(self.ptr, x, y)

    def set_min_size(self, width: i32, height: i32) -> void:
        _window_set_min_size(self.ptr, width, height)

    def set_max_size(self, width: i32, height: i32) -> void:
        _window_set_max_size(self.ptr, width, height)

    def center(self) -> void:
        self.set_pos((screen_width() - self.width()) // 2, (screen_height() - self.height()) // 2)

    def show(self) -> void:
        _window_show(self.ptr)

    def hide(self) -> void:
        _window_hide(self.ptr)

    def minimize(self) -> void:
        _window_minimize(self.ptr)

    def maximize(self) -> void:
        _window_maximize(self.ptr)

    def restore(self) -> void:
        _window_restore(self.ptr)

    def focus(self) -> void:
        _window_focus(self.ptr)

    def request_attention(self) -> void:
        _window_request_attention(self.ptr)

    def set_fullscreen(self, enabled: bool) -> void:
        _window_set_fullscreen(self.ptr, enabled as i32)

    def fullscreen(self) -> bool:
        return _window_fullscreen(self.ptr) as bool

    def set_resizable(self, enabled: bool) -> void:
        _window_set_resizable(self.ptr, enabled as i32)

    def set_decorated(self, enabled: bool) -> void:
        _window_set_decorated(self.ptr, enabled as i32)

    def set_floating(self, enabled: bool) -> void:
        _window_set_floating(self.ptr, enabled as i32)

    def set_flag(self, flag: WindowFlag, enabled: bool) -> void:
        v: i32 = flag.value
        if v == WindowFlag.Visible.value:
            if enabled:
                self.show()
            else:
                self.hide()
        elif v == WindowFlag.Resizable.value:
            self.set_resizable(enabled)
        elif v == WindowFlag.Decorated.value:
            self.set_decorated(enabled)
        elif v == WindowFlag.Maximized.value:
            if enabled:
                self.maximize()
            else:
                self.restore()
        elif v == WindowFlag.Floating.value:
            self.set_floating(enabled)
        elif v == WindowFlag.Focused.value:
            if enabled:
                self.focus()
        elif v == WindowFlag.Fullscreen.value:
            self.set_fullscreen(enabled)
        elif v == WindowFlag.Vsync.value:
            self.set_vsync(enabled)

    def has_flag(self, flag: WindowFlag) -> bool:
        v: i32 = flag.value
        if v == WindowFlag.Visible.value:
            return self.visible()
        if v == WindowFlag.Resizable.value:
            return self.resizable()
        if v == WindowFlag.Decorated.value:
            return self.decorated()
        if v == WindowFlag.Maximized.value:
            return self.maximized()
        if v == WindowFlag.Floating.value:
            return self.floating()
        if v == WindowFlag.Focused.value:
            return self.focused()
        if v == WindowFlag.Fullscreen.value:
            return self.fullscreen()
        if v == WindowFlag.Vsync.value:
            return self.vsync()
        return False

    def set_opacity(self, opacity: f64) -> void:
        _window_set_opacity(self.ptr, opacity)

    def resizable(self) -> bool:
        return _window_resizable(self.ptr) as bool

    def decorated(self) -> bool:
        return _window_decorated(self.ptr) as bool

    def floating(self) -> bool:
        return _window_floating(self.ptr) as bool

    def opacity(self) -> f64:
        return _window_opacity(self.ptr)

    def content_scale(self) -> f64:
        return _window_content_scale(self.ptr)

    def toggle_fullscreen(self) -> void:
        self.set_fullscreen(not self.fullscreen())

    def iconify(self) -> void:
        self.minimize()

    def flash(self) -> void:
        self.request_attention()

    def focused(self) -> bool:
        return _window_focused(self.ptr) as bool

    def minimized(self) -> bool:
        return _window_minimized(self.ptr) as bool

    def maximized(self) -> bool:
        return _window_maximized(self.ptr) as bool

    def visible(self) -> bool:
        return _window_visible(self.ptr) as bool

    def hovered(self) -> bool:
        return _window_hovered(self.ptr) as bool

    def resized(self) -> bool:
        return _window_resized(self.ptr) as bool

    def get_time(self) -> f64:
        return _window_time(self.ptr)

    def time(self) -> f64:
        return self.get_time()

    def dt(self) -> f64:
        return _window_dt(self.ptr)

    def key(self, code: Key) -> bool:
        return _window_key(self.ptr, code.value) as bool

    def key_code(self, vk: i32) -> bool:
        return _window_key(self.ptr, vk) as bool

    def key_pressed(self, code: Key) -> bool:
        return _window_key_pressed(self.ptr, code.value) as bool

    def key_released(self, code: Key) -> bool:
        return _window_key_released(self.ptr, code.value) as bool

    def mods(self) -> i32:
        return _window_mods(self.ptr)

    def shift(self) -> bool:
        return (self.mods() & Mod.Shift.value) != 0

    def ctrl(self) -> bool:
        return (self.mods() & Mod.Control.value) != 0

    def alt(self) -> bool:
        return (self.mods() & Mod.Alt.value) != 0

    def super_key(self) -> bool:
        return (self.mods() & Mod.Super.value) != 0

    def caps_lock(self) -> bool:
        return (self.mods() & Mod.CapsLock.value) != 0

    def num_lock(self) -> bool:
        return (self.mods() & Mod.NumLock.value) != 0

    def mod_down(self, which: Mod) -> bool:
        return (self.mods() & which.value) != 0

    def key_code_pressed(self, vk: i32) -> bool:
        return _window_key_pressed(self.ptr, vk) as bool

    def key_code_released(self, vk: i32) -> bool:
        return _window_key_released(self.ptr, vk) as bool

    def typed(self) -> i32:
        return _window_char(self.ptr)

    def mouse_x(self) -> i32:
        return _window_mouse_x(self.ptr)

    def mouse_y(self) -> i32:
        return _window_mouse_y(self.ptr)

    def mouse_dx(self) -> i32:
        return _window_mouse_dx(self.ptr)

    def mouse_dy(self) -> i32:
        return _window_mouse_dy(self.ptr)

    def button(self, which: Mouse) -> bool:
        return _window_mouse_button(self.ptr, which.value) as bool

    def button_pressed(self, which: Mouse) -> bool:
        return _window_mouse_button_pressed(self.ptr, which.value) as bool

    def button_released(self, which: Mouse) -> bool:
        return _window_mouse_button_released(self.ptr, which.value) as bool

    def left(self) -> bool:
        return self.button(Mouse.Left)

    def right(self) -> bool:
        return self.button(Mouse.Right)

    def middle(self) -> bool:
        return self.button(Mouse.Middle)

    def left_pressed(self) -> bool:
        return self.button_pressed(Mouse.Left)

    def right_pressed(self) -> bool:
        return self.button_pressed(Mouse.Right)

    def middle_pressed(self) -> bool:
        return self.button_pressed(Mouse.Middle)

    def wheel(self) -> i32:
        return _window_wheel(self.ptr)

    def get_fps(self) -> f64:
        delta: f64 = self.dt()
        if delta <= 0.0:
            return 0.0
        return 1.0 / delta

    def fps(self) -> f64:
        return self.get_fps()

    def clipboard(self) -> str:
        return _window_clipboard_get(self.ptr)

    def set_clipboard(self, text: str) -> void:
        _window_clipboard_set(self.ptr, text)

    def fit_viewport(self) -> void:
        viewport(0, 0, self.fb_width(), self.fb_height())

    def fit_scissor(self) -> void:
        scissor(0, 0, self.fb_width(), self.fb_height())

    def capture_frame(self) -> list[byte]:
        return read_pixels(0, 0, self.fb_width(), self.fb_height(), TextureFormat.RGBA.value, DataType.U8.value)

    def destroy(self) -> void:
        _window_destroy(self.ptr)

    def __str__(self) -> str:
        return f"Window({self.get_title()}, {self.width()}x{self.height()})"

class Shader:
    id: i32
    kind: ShaderKind
    compiled: i32
    source: str

    def __init__(self, kind: ShaderKind, source: str) -> void:
        self.kind = kind
        self.source = source
        self.id = _create_shader(kind.value)
        _shader_source(self.id, source)
        self.compiled = _compile_shader(self.id)

    def ok(self) -> bool:
        if self.id == 0:
            return False
        return self.compiled != 0

    def log(self) -> str:
        return shader_log(self.id)

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_shader(self.id)
        self.id = 0
        self.compiled = 0
        self.source = ""

    def __str__(self) -> str:
        return f"Shader({self.kind.value}, {self.id})"

class Program:
    id: i32
    linked: i32

    def __init__(self, vertex: Shader, fragment: Shader) -> void:
        self.id = _create_program()
        attach_shader(self.id, vertex.id)
        attach_shader(self.id, fragment.id)
        self.linked = _link_program(self.id)

    def use(self) -> void:
        use_program(self.id)

    def unuse(self) -> void:
        use_program(0)

    def attach(self, shader: Shader) -> void:
        attach_shader(self.id, shader.id)

    def detach(self, shader: Shader) -> void:
        detach_shader(self.id, shader.id)

    def link(self) -> bool:
        self.linked = _link_program(self.id)
        return self.ok()

    def ok(self) -> bool:
        if self.id == 0:
            return False
        return self.linked != 0

    def log(self) -> str:
        return program_log(self.id)

    def loc(self, name: str) -> i32:
        return uniform_location(self.id, name)

    def attrib(self, name: str) -> i32:
        return attrib_location(self.id, name)

    def bind_name(self, index: i32, name: str) -> void:
        bind_attrib(self.id, index, name)

    def set_f(self, name: str, x: f64) -> void:
        uniform1f(self.loc(name), x)

    def set_f2(self, name: str, x: f64, y: f64) -> void:
        uniform2f(self.loc(name), x, y)

    def set_f3(self, name: str, x: f64, y: f64, z: f64) -> void:
        uniform3f(self.loc(name), x, y, z)

    def set_f4(self, name: str, x: f64, y: f64, z: f64, w: f64) -> void:
        uniform4f(self.loc(name), x, y, z, w)

    def set_color(self, name: str, color: Color) -> void:
        uniform4f(self.loc(name), color.r, color.g, color.b, color.a)

    def set_bool(self, name: str, value: bool) -> void:
        uniform1i(self.loc(name), value as i32)

    def set_i(self, name: str, x: i32) -> void:
        uniform1i(self.loc(name), x)

    def set_tex(self, name: str, unit: i32) -> void:
        uniform1i(self.loc(name), unit)

    def set_i2(self, name: str, x: i32, y: i32) -> void:
        uniform2i(self.loc(name), x, y)

    def set_i3(self, name: str, x: i32, y: i32, z: i32) -> void:
        uniform3i(self.loc(name), x, y, z)

    def set_i4(self, name: str, x: i32, y: i32, z: i32, w: i32) -> void:
        uniform4i(self.loc(name), x, y, z, w)

    def set_vec(self, name: str, values: list[f64]) -> void:
        uniform_vec(self.loc(name), values)

    def set_mat3(self, name: str, values: list[f64]) -> void:
        uniform_mat3(self.loc(name), values)

    def set_mat4(self, name: str, values: list[f64]) -> void:
        uniform_mat4(self.loc(name), values)

    def validate(self) -> bool:
        return _validate_program(self.id) as bool

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_program(self.id)
        self.id = 0
        self.linked = 0

    def __str__(self) -> str:
        return f"Program({self.id})"

class GpuBuffer:
    id: i32
    target: i32

    def __init__(self, target: BufferTarget) -> void:
        self.target = target.value
        self.id = gen_buffer()

    def bind(self) -> void:
        bind_buffer(self.target, self.id)

    def unbind(self) -> void:
        bind_buffer(self.target, 0)

    def data_f64(self, values: list[f64], usage: Usage) -> void:
        self.bind()
        buffer_data_f64(self.target, values, usage.value)

    def data_i32(self, values: list[i32], usage: Usage) -> void:
        self.bind()
        buffer_data_i32(self.target, values, usage.value)

    def data_bytes(self, values: list[byte], usage: Usage) -> void:
        self.bind()
        buffer_data_bytes(self.target, values, usage.value)

    def sub_f64(self, offset_bytes: i64, values: list[f64]) -> void:
        self.bind()
        buffer_sub_f64(self.target, offset_bytes, values)

    def ok(self) -> bool:
        return self.id != 0

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_buffer(self.id)
        self.id = 0

class VertexArray:
    id: i32

    def __init__(self) -> void:
        self.id = gen_vao()

    def bind(self) -> void:
        bind_vao(self.id)

    def unbind(self) -> void:
        bind_vao(0)

    def attrib(self, index: i32, size: i32, stride_bytes: i32, offset_bytes: i64) -> void:
        enable_attrib(index)
        attrib_pointer(index, size, DataType.F32.value, 0, stride_bytes, offset_bytes)

    def attrib_typed(self, index: i32, size: i32, gltype: DataType, normalized: bool, stride_bytes: i32, offset_bytes: i64) -> void:
        enable_attrib(index)
        attrib_pointer(index, size, gltype.value, normalized as i32, stride_bytes, offset_bytes)

    def disable(self, index: i32) -> void:
        disable_attrib(index)

    def ok(self) -> bool:
        return self.id != 0

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_vao(self.id)
        self.id = 0

class Texture:
    id: i32
    width: i32
    height: i32
    target: i32

    def __init__(self, width: i32, height: i32) -> void:
        self.id = gen_texture()
        self.width = width
        self.height = height
        self.target = TextureTarget.Texture2D.value
        self.bind_unit(0)
        tex_param(self.target, TexParam.MinFilter.value, Filter.Linear.value)
        tex_param(self.target, TexParam.MagFilter.value, Filter.Linear.value)
        tex_param(self.target, TexParam.WrapS.value, Wrap.ClampToEdge.value)
        tex_param(self.target, TexParam.WrapT.value, Wrap.ClampToEdge.value)

    def bind_unit(self, unit: i32) -> void:
        active_texture(TextureUnit.T0.value + unit)
        bind_texture(self.target, self.id)

    def bind(self) -> void:
        self.bind_unit(0)

    def filter(self, min_filter: Filter, mag_filter: Filter) -> void:
        self.bind()
        tex_param(self.target, TexParam.MinFilter.value, min_filter.value)
        tex_param(self.target, TexParam.MagFilter.value, mag_filter.value)

    def wrap(self, s: Wrap, t: Wrap) -> void:
        self.bind()
        tex_param(self.target, TexParam.WrapS.value, s.value)
        tex_param(self.target, TexParam.WrapT.value, t.value)

    def wrap_r(self, r: Wrap) -> void:
        self.bind()
        tex_param(self.target, TexParam.WrapR.value, r.value)

    def unbind(self) -> void:
        bind_texture(self.target, 0)

    def upload_sub(self, x: i32, y: i32, width: i32, height: i32, pixels: list[byte]) -> void:
        self.bind()
        tex_sub_image2d(self.target, 0, x, y, width, height, TextureFormat.RGBA.value, DataType.U8.value, pixels)

    def resize(self, width: i32, height: i32, format: TextureFormat) -> void:
        self.width = width
        self.height = height
        self.allocate(format)

    def upload(self, pixels: list[byte]) -> void:
        self.bind()
        tex_image2d(self.target, 0, TextureFormat.RGBA.value, self.width, self.height, TextureFormat.RGBA.value, DataType.U8.value, pixels)

    def upload_rgb(self, pixels: list[byte]) -> void:
        self.bind()
        tex_image2d(self.target, 0, TextureFormat.RGB.value, self.width, self.height, TextureFormat.RGB.value, DataType.U8.value, pixels)

    def allocate(self, format: TextureFormat) -> void:
        self.bind()
        tex_storage(self.target, format.value, self.width, self.height, format.value)

    def mipmaps(self) -> void:
        self.bind()
        generate_mipmap(self.target)

    def upload_format(self, format: TextureFormat, pixels: list[byte]) -> void:
        self.bind()
        tex_image2d(self.target, 0, format.value, self.width, self.height, format.value, DataType.U8.value, pixels)

    def ok(self) -> bool:
        return self.id != 0

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_texture(self.id)
        self.id = 0

    def __str__(self) -> str:
        return f"Texture({self.width}x{self.height})"

class Renderbuffer:
    id: i32
    width: i32
    height: i32

    def __init__(self, width: i32, height: i32, internal: TextureFormat) -> void:
        self.id = gen_renderbuffer()
        self.width = width
        self.height = height
        bind_renderbuffer(FramebufferTarget.Renderbuffer.value, self.id)
        renderbuffer_storage(FramebufferTarget.Renderbuffer.value, internal.value, width, height)

    def bind(self) -> void:
        bind_renderbuffer(FramebufferTarget.Renderbuffer.value, self.id)

    def unbind(self) -> void:
        bind_renderbuffer(FramebufferTarget.Renderbuffer.value, 0)

    def resize(self, width: i32, height: i32, internal: TextureFormat) -> void:
        self.width = width
        self.height = height
        self.bind()
        renderbuffer_storage(FramebufferTarget.Renderbuffer.value, internal.value, width, height)

    def ok(self) -> bool:
        return self.id != 0

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        delete_renderbuffer(self.id)
        self.id = 0

class Framebuffer:
    id: i32
    width: i32
    height: i32

    def __init__(self, width: i32, height: i32) -> void:
        self.id = gen_framebuffer()
        self.width = width
        self.height = height

    def bind(self) -> void:
        bind_framebuffer(FramebufferTarget.Framebuffer.value, self.id)

    def unbind(self) -> void:
        bind_framebuffer(FramebufferTarget.Framebuffer.value, 0)

    def color(self, texture: Texture) -> void:
        self.color_at(0, texture)

    def color_at(self, index: i32, texture: Texture) -> void:
        self.bind()
        framebuffer_texture2d(FramebufferTarget.Framebuffer.value, Attachment.Color0.value + index, texture.target, texture.id, 0)

    def depth_texture(self, texture: Texture) -> void:
        self.bind()
        framebuffer_texture2d(FramebufferTarget.Framebuffer.value, Attachment.Depth.value, texture.target, texture.id, 0)

    def stencil_texture(self, texture: Texture) -> void:
        self.bind()
        framebuffer_texture2d(FramebufferTarget.Framebuffer.value, Attachment.Stencil.value, texture.target, texture.id, 0)

    def depth(self, buffer: Renderbuffer) -> void:
        self.bind()
        framebuffer_renderbuffer(FramebufferTarget.Framebuffer.value, Attachment.Depth.value, FramebufferTarget.Renderbuffer.value, buffer.id)

    def stencil(self, buffer: Renderbuffer) -> void:
        self.bind()
        framebuffer_renderbuffer(FramebufferTarget.Framebuffer.value, Attachment.Stencil.value, FramebufferTarget.Renderbuffer.value, buffer.id)

    def depth_stencil(self, buffer: Renderbuffer) -> void:
        self.bind()
        framebuffer_renderbuffer(FramebufferTarget.Framebuffer.value, Attachment.DepthStencil.value, FramebufferTarget.Renderbuffer.value, buffer.id)

    def viewport(self) -> void:
        viewport(0, 0, self.width, self.height)

    def capture(self) -> list[byte]:
        self.bind()
        return read_pixels(0, 0, self.width, self.height, TextureFormat.RGBA.value, DataType.U8.value)

    def blit_to(self, dest: Framebuffer, mask: i32, filter: Filter) -> void:
        bind_framebuffer(FramebufferTarget.Read.value, self.id)
        bind_framebuffer(FramebufferTarget.Draw.value, dest.id)
        blit_framebuffer(0, 0, self.width, self.height, 0, 0, dest.width, dest.height, mask, filter.value)

    def blit_screen(self, mask: i32, filter: Filter) -> void:
        bind_framebuffer(FramebufferTarget.Read.value, self.id)
        bind_framebuffer(FramebufferTarget.Draw.value, 0)
        blit_framebuffer(0, 0, self.width, self.height, 0, 0, self.width, self.height, mask, filter.value)

    def __bool__(self) -> bool:
        return self.ok()

    def ok(self) -> bool:
        self.bind()
        return check_framebuffer(FramebufferTarget.Framebuffer.value) == FramebufferStatus.Complete.value

    def status(self) -> i32:
        self.bind()
        return check_framebuffer(FramebufferTarget.Framebuffer.value)

    def destroy(self) -> void:
        delete_framebuffer(self.id)
        self.id = 0

    def __str__(self) -> str:
        return f"Framebuffer({self.width}x{self.height})"

class Mesh:
    vao: VertexArray
    vbo: GpuBuffer
    ibo: GpuBuffer
    count: i32
    index_count: i32
    stride: i32
    indexed: i32

    def __init__(self, vertices: list[f64], floats_per_vertex: i32) -> void:
        self.vao = VertexArray()
        self.vbo = GpuBuffer(BufferTarget.Array)
        self.ibo = GpuBuffer(BufferTarget.Element)
        self.stride = floats_per_vertex * 4
        n: i64 = len(vertices)
        if floats_per_vertex <= 0:
            self.count = 0
        else:
            self.count = (n as i32) // floats_per_vertex
        self.index_count = 0
        self.indexed = 0
        self.vao.bind()
        self.vbo.data_f64(vertices, Usage.StaticDraw)
        if floats_per_vertex <= 4:
            self.vao.attrib(0, floats_per_vertex, self.stride, 0 as i64)

    def layout(self, index: i32, size: i32, offset_floats: i32) -> void:
        self.vao.bind()
        self.vbo.bind()
        self.vao.attrib(index, size, self.stride, (offset_floats * 4) as i64)

    def indices(self, values: list[i32]) -> void:
        self.vao.bind()
        self.ibo.data_i32(values, Usage.StaticDraw)
        self.index_count = len(values) as i32
        self.indexed = 1

    def update(self, vertices: list[f64], usage: Usage) -> void:
        self.vao.bind()
        self.vbo.data_f64(vertices, usage)
        if self.stride > 0:
            self.count = (len(vertices) as i32) // (self.stride // 4)

    def unbind(self) -> void:
        self.vao.unbind()

    def draw(self, mode: Primitive) -> void:
        self.draw_range(mode, 0, self.count)

    def draw_range(self, mode: Primitive, first: i32, count: i32) -> void:
        self.vao.bind()
        if self.indexed != 0:
            draw_elements(mode.value, self.index_count, DataType.U32.value, 0 as i64)
        else:
            draw_arrays(mode.value, first, count)

    def draw_indexed(self, mode: Primitive) -> void:
        self.vao.bind()
        draw_elements(mode.value, self.index_count, DataType.U32.value, 0 as i64)

    def ok(self) -> bool:
        return self.vao.ok()

    def __bool__(self) -> bool:
        return self.ok()

    def destroy(self) -> void:
        self.vao.destroy()
        self.vbo.destroy()
        self.ibo.destroy()

def available() -> bool:
    return _available() as bool

def color_buffer() -> i32:
    return ClearMask.COLOR_BUFFER_BIT.value

def depth_buffer() -> i32:
    return ClearMask.DEPTH_BUFFER_BIT.value

def stencil_buffer() -> i32:
    return ClearMask.STENCIL_BUFFER_BIT.value

def color_depth() -> i32:
    return ClearMask.COLOR_BUFFER_BIT.value + ClearMask.DEPTH_BUFFER_BIT.value

def color_depth_stencil() -> i32:
    return ClearMask.Color.value + ClearMask.Depth.value + ClearMask.Stencil.value

def enable_cap(cap: Capability) -> void:
    enable(cap.value)

def disable_cap(cap: Capability) -> void:
    disable(cap.value)

def set_blend(src: BlendFactor, dst: BlendFactor) -> void:
    enable(Capability.Blend.value)
    blend_func(src.value, dst.value)

def set_blend_eq(mode: BlendEquation) -> void:
    enable(Capability.Blend.value)
    blend_equation(mode.value)

def set_depth(func: DepthFn) -> void:
    enable(Capability.DepthTest.value)
    depth_func(func.value)

def set_stencil(func: DepthFn, ref: i32, mask: i32, sfail: StencilOp, dpfail: StencilOp, dppass: StencilOp) -> void:
    enable(Capability.StencilTest.value)
    stencil_func(func.value, ref, mask)
    stencil_op(sfail.value, dpfail.value, dppass.value)

def enabled(cap: Capability) -> bool:
    return _is_enabled(cap.value) as bool

def depth_write(enabled: bool) -> void:
    _depth_mask(enabled as i32)

def color_write(r: bool, g: bool, b: bool, a: bool) -> void:
    _color_mask(r as i32, g as i32, b as i32, a as i32)

def set_cull(face: Face) -> void:
    enable(Capability.CullFace.value)
    cull_face(face.value)

def wireframe(on: bool) -> void:
    if on:
        polygon_mode(Face.FrontAndBack.value, Polygon.Line.value)
    else:
        polygon_mode(Face.FrontAndBack.value, Polygon.Filled.value)

def vendor() -> str:
    return get_string(Info.Vendor.value)

def renderer() -> str:
    return get_string(Info.Renderer.value)

def version() -> str:
    return get_string(Info.Version.value)

def shading_language() -> str:
    return get_string(Info.ShadingLanguage.value)

def ok() -> bool:
    return get_error() == GlError.NoError.value

def capture(x: i32, y: i32, width: i32, height: i32) -> list[byte]:
    return read_pixels(x, y, width, height, TextureFormat.RGBA.value, DataType.U8.value)

def program(vertex_src: str, fragment_src: str) -> Program:
    vs = Shader(ShaderKind.Vertex, vertex_src)
    fs = Shader(ShaderKind.Fragment, fragment_src)
    return Program(vs, fs)

def texture_color(width: i32, height: i32, format: TextureFormat) -> Texture:
    tex = Texture(width, height)
    tex.allocate(format)
    return tex

def default_window_flags() -> i32:
    return WindowFlag.Visible.value + WindowFlag.Resizable.value + WindowFlag.Decorated.value + WindowFlag.Focused.value + WindowFlag.Vsync.value

def rgb(r: f64, g: f64, b: f64) -> Color:
    return Color(r, g, b, 1.0)

def rgba(r: f64, g: f64, b: f64, a: f64) -> Color:
    return Color(r, g, b, a)

def rgb8(r: i32, g: i32, b: i32) -> Color:
    return Color((r as f64) / 255.0, (g as f64) / 255.0, (b as f64) / 255.0, 1.0)

def rgba8(r: i32, g: i32, b: i32, a: i32) -> Color:
    return Color((r as f64) / 255.0, (g as f64) / 255.0, (b as f64) / 255.0, (a as f64) / 255.0)

def color_u32(value: i32) -> Color:
    a: i32 = (value >> 24) & 255
    r: i32 = (value >> 16) & 255
    g: i32 = (value >> 8) & 255
    b: i32 = value & 255
    return rgba8(r, g, b, a)

def set_blend_separate(src_rgb: BlendFactor, dst_rgb: BlendFactor, src_a: BlendFactor, dst_a: BlendFactor) -> void:
    enable(Capability.Blend.value)
    blend_func_separate(src_rgb.value, dst_rgb.value, src_a.value, dst_a.value)

def set_hint(target: Hint, mode: HintMode) -> void:
    hint(target.value, mode.value)

def set_logic(op: LogicOp) -> void:
    enable(Capability.ColorLogicOp.value)
    logic_op(op.value)

def set_draw_buf(buf: DrawBuffer) -> void:
    draw_buffer(buf.value)

def set_read_buf(buf: DrawBuffer) -> void:
    read_buffer(buf.value)
