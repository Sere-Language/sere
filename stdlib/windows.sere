# Win32 API. Import with: import windows
#
# A low-level Windows platform layer: thin, typed wrappers over the Win32
# primitives other Sere libraries build on (console/terminal toolkits,
# process and pipe plumbing, synchronization, native windows). It is real on
# Windows and safe stubs elsewhere, so gate host-specific use with:
#
#   if __windows__:
#       windows.message_box("hi")
#
# Design rules:
#   * Native work lives in C (runtime/sere_win.c); Sere wrappers are thin.
#   * Strings cross the boundary as UTF-8 and use the W Win32 entry points.
#   * Pointer-sized Win32 values (WPARAM/LPARAM/LRESULT/HANDLE) are never
#     truncated into i32.
#   * Every wrapper returns a predictable failure (False/None/zero) instead of
#     crashing when the platform cannot satisfy it.

import bytes

# ---------------------------------------------------------------------------
# Fixed-width Win32 aliases (section 18). Sere targets 64-bit Windows, so the
# pointer-sized names are 64-bit.
# ---------------------------------------------------------------------------
type Handle = Ptr[i8]
type WindowHandle = Handle
type PseudoConsole = Handle
type DWORD = u32
type WORD = u16
type BYTE = u8
type BOOL = i32
type UINT = u32
type INT = i32
type LONG = i32
type ULONG = u32
type WPARAM = u64
type LPARAM = i64
type LRESULT = i64
type SIZE_T = u64
type HWND = WindowHandle

