# Enums
# ---------------------------------------------------------------------------

enum MessageBoxKind:
    """Win32 message-box button combinations."""
    Ok = 0
    OkCancel = 1
    AbortRetryIgnore = 2
    YesNoCancel = 3
    YesNo = 4
    RetryCancel = 5

enum MessageBoxIcon:
    """Win32 message-box icon flags."""
    None = 0 # type: ignore
    Error = 16
    Question = 32
    Warning = 48
    Info = 64

