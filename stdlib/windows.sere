# Window handles
# ---------------------------------------------------------------------------

extern "C" "sere_win_active_window"
def _active_window() -> Handle
"""Return the active window of the calling thread."""

extern "C" "sere_win_focus_window"
def _focus_window() -> Handle
"""Return the window with keyboard focus."""

extern "C" "sere_win_set_foreground_window"
def _set_foreground_window(window: WindowHandle) -> i32
"""Bring a window to the foreground."""

extern "C" "sere_win_bring_window_to_top"
def _bring_window_to_top(window: WindowHandle) -> i32
"""Raise a window to the top of the z-order."""

extern "C" "sere_win_show_window"
def _show_window(window: WindowHandle, command: i32) -> i32
"""Show or hide a window."""

extern "C" "sere_win_is_window"
def _is_window(window: WindowHandle) -> i32
"""Test whether a handle is a window."""

extern "C" "sere_win_is_window_visible"
def _is_window_visible(window: WindowHandle) -> i32
"""Test whether a window is visible."""

extern "C" "sere_win_is_iconic"
def _is_iconic(window: WindowHandle) -> i32
"""Test whether a window is minimized."""

extern "C" "sere_win_is_zoomed"
def _is_zoomed(window: WindowHandle) -> i32
"""Test whether a window is maximized."""

extern "C" "sere_win_set_window_text"
def _set_window_text(window: WindowHandle, data: str) -> i32
"""Set a window's title text."""

extern "C" "sere_win_get_window_rect"
def _get_window_rect(window: WindowHandle, out_fields: Ptr[i32], field_count: i32) -> i32
"""Read a window rectangle."""

extern "C" "sere_win_get_client_rect"
def _get_client_rect(window: WindowHandle, out_fields: Ptr[i32], field_count: i32) -> i32
"""Read a client rectangle."""

extern "C" "sere_win_move_window"
def _move_window(window: WindowHandle, x: i32, y: i32, width: i32, height: i32, repaint: i32) -> i32
"""Move and resize a window."""

extern "C" "sere_win_set_window_pos"
def _set_window_pos(window: WindowHandle, anchor: i32, x: i32, y: i32, width: i32, height: i32, flags: DWORD) -> i32
"""Reposition a window with SetWindowPos."""

extern "C" "sere_win_update_window"
def _update_window(window: WindowHandle) -> i32
"""Force a window repaint."""

extern "C" "sere_win_destroy_window"
def _destroy_window(window: WindowHandle) -> i32
"""Destroy a window."""

def window_valid(window: WindowHandle) -> bool:
    """Return whether a handle is a real window."""
    return _is_window(window) as bool

def window_visible(window: WindowHandle) -> bool:
    """Return whether a window is visible."""
    return _is_window_visible(window) as bool

def window_iconic(window: WindowHandle) -> bool:
    """Return whether a window is minimized."""
    return _is_iconic(window) as bool

def window_zoomed(window: WindowHandle) -> bool:
    """Return whether a window is maximized."""
    return _is_zoomed(window) as bool

def window_title(window: WindowHandle) -> str:
    """Return a window's title text (alias of window_text)."""
    return window_text(window)

def window_set_title(window: WindowHandle, title: str) -> bool:
    """Set a window's title text."""
    return _set_window_text(window, title) as bool

def _decode_rect(fields: list[i32]) -> Rect:
    return Rect(fields[0], fields[1], fields[2], fields[3])

def window_rect(window: WindowHandle) -> Rect:
    """Return a window's screen rectangle (zeroed on failure)."""
    fields: list[i32] = [0, 0, 0, 0]
    if _get_window_rect(window, &fields[0], 4) == 0:
        return Rect(0, 0, 0, 0)
    return _decode_rect(fields)

def window_client_rect(window: WindowHandle) -> Rect:
    """Return a window's client rectangle (zeroed on failure)."""
    fields: list[i32] = [0, 0, 0, 0]
    if _get_client_rect(window, &fields[0], 4) == 0:
        return Rect(0, 0, 0, 0)
    return _decode_rect(fields)

def window_move(window: WindowHandle, x: i32, y: i32, width: i32, height: i32, repaint: bool = True) -> bool:
    """Move and resize a window."""
    return _move_window(window, x, y, width, height, 1 if repaint else 0) as bool

def window_set_pos(window: WindowHandle, x: i32, y: i32, width: i32, height: i32, flags: DWORD = 0, anchor: i32 = ANCHOR_TOP) -> bool:
    """Reposition a window with SetWindowPos flags."""
    return _set_window_pos(window, anchor, x, y, width, height, flags) as bool

def window_show(window: WindowHandle, command: ShowWindowCommand = ShowWindowCommand.Show) -> bool:
    """Show or hide a window (returns its previous visibility)."""
    return _show_window(window, command.value) != 0

def window_update(window: WindowHandle) -> bool:
    """Force an immediate repaint."""
    return _update_window(window) as bool

def window_destroy(window: WindowHandle) -> bool:
    """Destroy a window."""
    return _destroy_window(window) as bool

def active_window() -> WindowHandle:
    """Return the active window of the calling thread."""
    return _active_window()

def focus_window() -> WindowHandle:
    """Return the window with keyboard focus."""
    return _focus_window()

def set_foreground_window(window: WindowHandle) -> bool:
    """Bring a window to the foreground."""
    return _set_foreground_window(window) as bool

def bring_window_to_top(window: WindowHandle) -> bool:
    """Raise a window to the top of the z-order."""
    return _bring_window_to_top(window) as bool

# ---------------------------------------------------------------------------
# Window class, creation, and messages
# ---------------------------------------------------------------------------

extern "C" "sere_win_register_window_class"
def _register_window_class(name: str, style: DWORD, wnd_proc: Ptr[i8], class_extra: i32, window_extra: i32, background: Ptr[i8]) -> DWORD
"""Register a window class (wnd_proc NULL selects DefWindowProcW)."""

extern "C" "sere_win_unregister_window_class"
def _unregister_window_class(name: str) -> i32
"""Unregister a window class."""

extern "C" "sere_win_create_window"
def _create_window(class_name: str, window_name: str, style: DWORD, ex_style: DWORD, x: i32, y: i32, width: i32, height: i32, parent: WindowHandle, menu: Handle) -> WindowHandle
"""Create a window."""

extern "C" "sere_win_def_window_proc"
def def_window_proc(window: WindowHandle, message: DWORD, wparam: WPARAM, lparam: LPARAM) -> LRESULT
"""Call DefWindowProcW for default message handling."""

extern "C" "sere_win_get_message"
def _get_message(out_fields: Ptr[i32], field_count: i32, out_window: Ptr[WindowHandle], out_wparam: Ptr[i64], out_lparam: Ptr[i64]) -> i32
"""Retrieve one message (blocking)."""

extern "C" "sere_win_peek_message"
def _peek_message(out_fields: Ptr[i32], field_count: i32, out_window: Ptr[WindowHandle], out_wparam: Ptr[i64], out_lparam: Ptr[i64], min_message: DWORD, max_message: DWORD, flags: DWORD) -> i32
"""Peek for a message (non-blocking)."""

extern "C" "sere_win_translate_message"
def _translate_message(fields: Ptr[i32], field_count: i32, window: WindowHandle, wparam: WPARAM, lparam: LPARAM) -> i32
"""Translate a message."""

extern "C" "sere_win_dispatch_message"
def _dispatch_message(fields: Ptr[i32], field_count: i32, window: WindowHandle, wparam: WPARAM, lparam: LPARAM) -> LRESULT
"""Dispatch a message to its window procedure."""

extern "C" "sere_win_post_quit_message"
def post_quit_message(exit_code: i32) -> void
"""Post WM_QUIT to the calling thread's message queue."""

def register_window_class(name: str, style: DWORD = 0, wnd_proc: Handle | None = None, class_extra: i32 = 0, window_extra: i32 = 0, background: Handle | None = None) -> DWORD:
    """Register a window class and return its atom (0 on failure).

    A custom Win32 WNDPROC must be a native function pointer. Sere cannot yet
    turn a `def` into one, so pass None (the default) to use DefWindowProcW and
    document. See the module notes on the callback limitation.
    """
    return _register_window_class(name, style, wnd_proc, class_extra, window_extra, background)

def unregister_window_class(name: str) -> bool:
    """Unregister a window class."""
    return _unregister_window_class(name) as bool

def create_window(class_name: str, window_name: str = "", style: DWORD = WS_OVERLAPPEDWINDOW, ex_style: DWORD = 0, x: i32 = 128, y: i32 = 128, width: i32 = 640, height: i32 = 480, parent: WindowHandle | None = None, menu: Handle | None = None) -> WindowHandle:
    """Create a window, or return None on failure."""
    return _create_window(class_name, window_name, style, ex_style, x, y, width, height, parent, menu)

def get_message() -> WindowMessageEvent | None:
    """Block for the next message; None after WM_QUIT or on error."""
    fields: list[i32] = [0, 0, 0, 0]
    window: WindowHandle = None
    wparam: i64 = 0
    lparam: i64 = 0
    status: i32 = _get_message(&fields[0], 4, &window, &wparam, &lparam)
    if status != MESSAGE_READY:
        return None
    return WindowMessageEvent(window, fields[0] as DWORD, wparam as WPARAM, lparam, fields[1] as DWORD, fields[2], fields[3])

def peek_message(flags: DWORD = PM_REMOVE, min_message: DWORD = 0, max_message: DWORD = 0) -> WindowMessageEvent | None:
    """Peek for a message without blocking; None when the queue is empty."""
    fields: list[i32] = [0, 0, 0, 0]
    window: WindowHandle = None
    wparam: i64 = 0
    lparam: i64 = 0
    if _peek_message(&fields[0], 4, &window, &wparam, &lparam, min_message, max_message, flags) == 0:
        return None
    return WindowMessageEvent(window, fields[0] as DWORD, wparam as WPARAM, lparam, fields[1] as DWORD, fields[2], fields[3])

def translate_message(event: WindowMessageEvent) -> bool:
    """Translate keyboard messages (fills the character queue)."""
    fields: list[i32] = [event.message as i32, event.time as i32, event.x, event.y]
    return _translate_message(&fields[0], 4, event.window, event.wparam, event.lparam) != 0

def dispatch_message(event: WindowMessageEvent) -> LRESULT:
    """Dispatch a message to the window's procedure (DefWindowProc by default)."""
    fields: list[i32] = [event.message as i32, event.time as i32, event.x, event.y]
    return _dispatch_message(&fields[0], 4, event.window, event.wparam, event.lparam)

def post_message(window: WindowHandle, message: DWORD, wparam: WPARAM = 0, lparam: LPARAM = 0) -> bool:
    """Post a message to a window's queue."""
    return _post_message(window, message, wparam, lparam) as bool

def send_message(window: WindowHandle, message: DWORD, wparam: WPARAM = 0, lparam: LPARAM = 0) -> LRESULT:
    """Send a message to a window and wait for its result."""
    return _send_message(window, message, wparam, lparam)

def run_message_loop_until(window: WindowHandle) -> bool:
    """Pump messages until WM_QUIT or until window is destroyed.

    Dispatches each message through dispatch_message (which reaches the class's
    WNDPROC). For a class registered without a custom WNDPROC that is
    DefWindowProcW, so closing the window destroys it and this returns once the
    window no longer exists.
    """
    while True:
        event = peek_message(PM_REMOVE)
        if event != None:
            if event.message == WM_QUIT:
                return True
            translate_message(event)
            dispatch_message(event)
        elif not window_valid(window):
            return True

def run_message_loop() -> bool:
    """Pump messages until WM_QUIT is received."""
    while True:
        event = get_message()
        if event == None:
            return True
        translate_message(event)
        dispatch_message(event)

# ---------------------------------------------------------------------------
# Pseudoconsole (ConPTY)
# ---------------------------------------------------------------------------

extern "C" "sere_win_conpty_available"
def _conpty_available() -> i32
"""Test whether the ConPTY entry points exist on this host."""

extern "C" "sere_win_pseudo_console_create"
def _pseudo_console_create(columns: i32, rows: i32, input_read: Handle, output_write: Handle) -> PseudoConsole
"""Create a pseudoconsole."""

extern "C" "sere_win_pseudo_console_resize"
def _pseudo_console_resize(pseudo: PseudoConsole, columns: i32, rows: i32) -> i32
"""Resize a pseudoconsole."""

extern "C" "sere_win_pseudo_console_close"
def _pseudo_console_close(pseudo: PseudoConsole) -> void
"""Close a pseudoconsole."""

def conpty_available() -> bool:
    """Return whether ConPTY is available on this host."""
    return _conpty_available() as bool

def pseudo_console_create(input_read: Handle, output_write: Handle, columns: i32 = 80, rows: i32 = 25) -> PseudoConsole:
    """Create a pseudoconsole over a pipe pair, or return None on failure."""
    return _pseudo_console_create(columns, rows, input_read, output_write)

def pseudo_console_resize(pseudo: PseudoConsole, columns: i32, rows: i32) -> bool:
    """Resize a pseudoconsole."""
    return _pseudo_console_resize(pseudo, columns, rows) as bool

def pseudo_console_close(pseudo: PseudoConsole) -> void:
    """Close a pseudoconsole and release its resources."""
    _pseudo_console_close(pseudo)
