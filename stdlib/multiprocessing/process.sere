"""`multiprocessing.Process` and the process registry.

Sere programs are compiled to a native executable, so there is no module to
re-import in a child. `spawn` therefore re-runs *this same executable* with a
bootstrap argument; the runtime detects that, resolves the target by the name
it was registered under, and runs it instead of user `main`. The practical
effect matches Python's spawn start method: only registered top-level targets
run in the child, and the child never re-executes the guarded `__main__` block.

Because a child cannot see the parent's memory, a target must be a free
function whose name was registered with `multiprocessing.expose` before the
program started running, and its arguments must be values the codec can carry.
Both restrictions are checked and reported rather than silently degraded.
"""

import string

import multiprocessing.reduction as reduction
from multiprocessing.exceptions import ProcessError, PicklingError

# ---------------------------------------------------------------------------
# Native entry points
# ---------------------------------------------------------------------------

extern "C" "sere_mp_spawn"
def _spawn(payload: list[byte], daemon: i32) -> Ptr[i8]
"""Start a copy of this executable in child mode."""

extern "C" "sere_mp_wait"
def _wait(handle: Ptr[i8], timeout_ms: i64) -> i32
"""Wait for a child; returns 0 on exit and 1 on timeout."""

extern "C" "sere_mp_is_alive"
def _is_alive(handle: Ptr[i8]) -> i32
"""Return 1 while the child is running."""

extern "C" "sere_mp_exit_code"
def _exit_code(handle: Ptr[i8]) -> i32
"""Return the child's exit status."""

extern "C" "sere_mp_pid"
def _pid(handle: Ptr[i8]) -> i64
"""Return the child's process id."""

extern "C" "sere_mp_self_pid"
def self_pid() -> i64
"""Return this process's id."""

extern "C" "sere_mp_terminate"
def _terminate(handle: Ptr[i8]) -> void
"""Ask the child to stop."""

extern "C" "sere_mp_kill"
def _kill(handle: Ptr[i8]) -> void
"""Force the child to stop."""

extern "C" "sere_mp_close"
def _close(handle: Ptr[i8]) -> void
"""Release the parent's handle to a child."""

extern "C" "sere_mp_sentinel_value"
def _sentinel_value(handle: Ptr[i8]) -> i64
"""A waitable value that becomes ready when the child exits."""

extern "C" "sere_mp_cpu_count"
def cpu_count() -> i32
"""Return the number of usable CPUs."""

extern "C" "sere_mp_authkey"
def _random_authkey() -> str
"""Return a fresh cryptographically random authentication key."""

# ---------------------------------------------------------------------------
# Module state
# ---------------------------------------------------------------------------

# Every process keeps its own registry: a child must not see its parent's
# children, and `active_children()` has to report only live processes.
static _children: list[Any] = []
static _next_index: i64 = 0
static _current: Any = None
static _current_ready: bool = False
static _authkey_cache: str = ""


def _next_name() -> str:
    """Return the next Python-style default process name."""
    _next_index = _next_index + 1
    return "Process-" + str(_next_index)


def current_authkey() -> str:
    """Return the authentication key shared by this process's family.

    Generated once per process from the platform's cryptographic random
    source, so it is not predictable from a process id or the clock.
    """
    if len(_authkey_cache) == 0:
        _authkey_cache = _random_authkey()
    return _authkey_cache


# ---------------------------------------------------------------------------
# Process
# ---------------------------------------------------------------------------


class Process:
    """A child process, modelled on `multiprocessing.Process`.

    ``Process(target=worker, args=[...])`` starts a real child process running
    the registered function ``worker``. Arguments are passed positionally, as in
    Python::

        def worker(name: str, count: i32) -> void:
            print(name, count)

        static _worker: bool = multiprocessing.expose("worker", worker)

    A target that takes a single ``list[Any]`` parameter instead receives the
    whole argument list and casts each element itself. Positional parameters may
    be integers, ``bool``, ``str``, ``list`` or ``dict``; a target that returns a
    value or takes a float or other aggregate parameter must use the
    ``list[Any]`` form.

    Subclassing works for the parent-side API, but overriding `run()` cannot
    change what a child executes: a child cannot reconstruct an arbitrary
    subclass instance. Register a `target` instead.
    """

    # Public, Python-named fields. Accessors are declared over the fields they
    # back, which is the Sere idiom; a property with no setter is read-only
    # from outside, like Python's.
    name: str
    daemon: bool
    pid: i64
    ident: i64
    authkey: str
    exitcode: Any
    _target: Any
    _args: list[Any]
    _handle: Ptr[i8]
    _started: bool
    _closed: bool

    def __init__(self,
                 group: Any = None,
                 target: Any = None,
                 name: str = "",
                 args: Any = None,
                 kwargs: Any = None,
                 daemon: Any = None) -> void:
        """Create a process object; nothing starts until `start()` is called."""
        if not isinstance(group, None):
            raise ProcessError("group must be None")
        if not isinstance(kwargs, None):
            raise ProcessError("keyword arguments for the target are not supported")
        self._target = target
        self._args = reduction.to_any_list(args)
        self.name = name
        if len(self.name) == 0:
            self.name = _next_name()
        if isinstance(daemon, None):
            self.daemon = False
        else:
            self.daemon = daemon as bool
        self._handle = None
        self.pid = -1
        self.ident = -1
        self.authkey = ""
        self.exitcode = None
        self._started = False
        self._closed = False

    # -- accessors -------------------------------------------------------

    @public name.get:
        return self.name

    @public name.set(value: str) -> void:
        self.name = value

    @public daemon.get:
        return self.daemon

    @public daemon.set(value: bool) -> void:
        if self._started:
            raise ProcessError("cannot change the daemon flag after start()")
        self.daemon = value

    @public pid.get:
        return self.pid

    @public ident.get:
        return self.ident

    @public authkey.get:
        return current_authkey()

    @public exitcode.get:
        if self._handle is None:
            return None
        if _is_alive(self._handle) == 1:
            return None
        return _exit_code(self._handle)

    # The pid/ident getters are read-only to callers, so the class updates the
    # backing fields through these helpers.
    def _set_identity(self, value: i64) -> void:
        """Set pid and ident together; callers only read them."""
        self.pid = value
        self.ident = value

    def sentinel(self) -> i64:
        """Return a waitable value that becomes ready when the child exits."""
        if self._handle is None:
            raise ValueError("process object has not been started")
        return _sentinel_value(self._handle)

    # -- lifecycle -------------------------------------------------------

    def start(self) -> void:
        """Start the child process. A process object can be started only once."""
        if self._closed:
            raise ValueError("process object is closed")
        if self._started:
            raise ProcessError("cannot start a process twice")
        name: str = reduction.target_name(self._target)
        if len(name) == 0:
            raise PicklingError("the target is not registered; declare it with " +
                                "multiprocessing.expose('name', fn) at the top level")
        payload: list[byte] = reduction.pack_call(name, self._args)
        handle: Ptr[i8] = _spawn(payload, self.daemon as i32)
        if handle is None:
            raise ProcessError("failed to start the process")
        self._handle = handle
        self._set_identity(_pid(handle))
        self._started = True
        _children.append(self)

    def run(self) -> void:
        """Run the target in this process (what a child effectively does)."""
        if isinstance(self._target, None):
            raise ProcessError("no target was given")
        reduction.call_target(self._target, self._args)

    def join(self, timeout: f64 = -1.0) -> void:
        """Wait for the child to finish, or for `timeout` seconds to pass."""
        if not self._started:
            raise ValueError("cannot join a process before it is started")
        if self._closed:
            raise ValueError("process object is closed")
        if self._handle is None:
            return
        wait_ms: i64 = -1
        if timeout >= 0.0:
            wait_ms = (timeout * 1000.0) as i64
        _wait(self._handle, wait_ms)

    def is_alive(self) -> bool:
        """Return whether the child is still running."""
        if not self._started:
            raise ValueError("process object has not been started")
        if self._closed:
            return False
        if self._handle is None:
            return True
        return _is_alive(self._handle) == 1

    def terminate(self) -> void:
        """Request the child's immediate termination."""
        if not self._started:
            raise ValueError("process object has not been started")
        if self._handle is None:
            return
        _terminate(self._handle)

    def kill(self) -> void:
        """Stop the child with the strongest mechanism the OS offers."""
        if not self._started:
            raise ValueError("process object has not been started")
        if self._handle is None:
            return
        _kill(self._handle)

    def close(self) -> void:
        """Release the parent's handle to the child."""
        if self._closed:
            return
        if self._handle is not None:
            _close(self._handle)
            self._handle = None
        self._closed = True

    def __repr__(self) -> str:
        """Return a Python-style representation."""
        return "<Process " + self.name + " pid=" + str(self.pid) + ">"


# ---------------------------------------------------------------------------
# The current process
# ---------------------------------------------------------------------------


def current_process() -> Process:
    """Return the Process object for the calling process."""
    if not _current_ready:
        main: Process = Process(target=None, name="MainProcess")
        main.daemon = False
        main._set_identity(self_pid())
        main._started = True
        _current = main
        _current_ready = True
    return _current as Process


def parent_process() -> Any:
    """Return the parent process, or `None` for a top-level process.

    A child is launched by re-running the executable, so it does not know its
    parent, and this reports whether there is a parent at all.
    """
    return None


def active_children() -> list[Process]:
    """Return the live children started by this process, reaping the rest."""
    live: list[Process] = []
    kept: list[Any] = []
    for entry in _children:
        child: Process = entry as Process
        if child.is_alive():
            kept.append(child)
            live.append(child)
    _children = kept
    return live


def active_children_count() -> i64:
    """Return how many children are currently alive."""
    return len(active_children()) as i64
