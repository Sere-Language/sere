# Runtime and process introspection. Import with: import sys
#
# `sys` describes the running Sere program and its runtime. Operating-system
# services, files, and process control live in `os`; the raw Win32 layer lives in
# `windows`. The split is deliberate:
#
#   sys      this program, this runtime, this build, these arguments
#   os       the operating system it runs on
#   windows  the Win32 API underneath both
#
# Values that describe the build and target (`version`, `platform`,
# `architecture`, `target_triple`, `pointer_size`, `byteorder`, `build_mode`,
# `optimization`) are fixed when the program is compiled, so a cross-compiled
# binary reports the target it was built for rather than the machine that built
# it. Values that describe the process (`argv`, `executable`, `start_time_ns`)
# are captured at start-up.
#
# Compile-time flags: `if __windows__: ...` and `if cfg!(linux): ...`.
# Module globals: __name__, __file__, __package__, __doc__, __debug__,
# __sere_version__, __platform__, __arch__.
#
# `panic(message)` is already a language builtin, so this module does not wrap
# it, and neither `abort` nor `panic` flushes buffered output.

# ---------------------------------------------------------------------------
# Types: enums
# ---------------------------------------------------------------------------

enum Family:
    """Operating-system families."""
    Windows
    Linux
    Macos
    Unknown


enum Arch:
    """Processor architectures a program can be built for."""
    X86
    X86_64
    Arm
    Arm64
    Unknown


enum ByteOrder:
    """Byte order of the target."""
    Little
    Big


enum BuildMode:
    """How the runtime was compiled."""
    Debug
    Release
    RelWithDebInfo
    MinSizeRel
    Unknown


enum OptimizationLevel:
    """Optimization level the runtime was compiled with."""
    O0
    O1
    O2
    O3
    Os
    Oz
    Unknown


enum Backend:
    """Code generator that produced this program."""
    Native
    Serem
    Unknown


enum ABI:
    """Application binary interface of the target."""
    MSVC
    GNU
    Musl
    Darwin
    Unknown


# The spec names these two types `Platform` and `Architecture`; both are aliases
# of the enums above so a program can use either spelling.
type Platform = Family
type Architecture = Arch

# ---------------------------------------------------------------------------
# Types: structures
# ---------------------------------------------------------------------------

struct VersionInfo:
    """Version of the Sere language and runtime.

    `pre_release` is the tag before the numeric release (`"pre"` for a preview
    build, empty for a final one). `build` is the packaging tag, empty unless
    the release build set one, which keeps ordinary builds reproducible.
    """
    major: i32
    minor: i32
    patch: i32
    pre_release: str
    build: str
    text: str


struct CompilerInfo:
    """The compiler and runtime that produced this program."""
    name: str
    version: str
    backend: str
    gc: str


struct ImplementationInfo:
    """The runtime implementation, mirroring the language's own identity."""
    name: str
    version: VersionInfo
    backend: str
    gc: str


struct RuntimeFeatures:
    """Capabilities this runtime and target provide."""
    threads: bool
    async_runtime: bool
    ffi: bool
    debug_symbols: bool


struct RuntimeFlags:
    """Immutable execution settings fixed when the runtime was built."""
    debug: bool
    assertions: bool
    optimized: bool
    gc_enabled: bool


struct TargetInfo:
    """The platform, architecture, and ABI the program was built for."""
    platform: str
    platform_family: Family
    architecture: str
    architecture_kind: Arch
    triple: str
    os: str
    abi: str
    pointer_size: i32
    pointer_bits: i32
    byte_order: ByteOrder


struct FloatInfo:
    """The double-precision model, read from the C runtime's <float.h>."""
    max: f64
    min: f64
    epsilon: f64
    radix: i32
    mantissa_bits: i32
    max_exp: i32
    min_exp: i32


struct ExceptionInfo:
    """The exception currently being handled, if any.

    `active` is False outside a `catch` block, in which case `type` and
    `message` are empty. `type` is the Sere class name without its module
    qualifier, such as `ValueError`.
    """
    active: bool
    type: str
    message: str


struct GCStats:
    """Counters from the active collector.

    `bytes_in_use` is the live heap, `bytes_allocated` the cumulative total, and
    `collections` how many times the collector has run. Values come from the
    collector's own bookkeeping, so they cost nothing to read.
    """
    name: str
    collections: u64
    bytes_in_use: u64
    bytes_allocated: u64
    live_blocks: u64


struct MemoryStats:
    """Runtime heap totals, which are not the process's resident set size."""
    allocated: u64
    live: u64
    blocks: u64


struct RuntimeStats:
    """Snapshot of the runtime's time and memory use."""
    uptime_ns: u64
    gc: GCStats
    memory: MemoryStats


struct RuntimeInfo:
    """Single snapshot of everything `sys` reports about the build and target.

    Each field also has its own accessor, so this is the convenient form for
    diagnostics and bug reports rather than the only way in.
    """
    version: VersionInfo
    compiler: CompilerInfo
    target: TargetInfo
    build_mode: BuildMode
    build_mode_name: str
    optimization: OptimizationLevel
    optimization_name: str
    debug: bool
    assertions: bool
    features: RuntimeFeatures
    gc: str

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

const STDIN_FD: i64 = 0
const STDOUT_FD: i64 = 1
const STDERR_FD: i64 = 2

const FAMILY_WINDOWS: i32 = 0
const FAMILY_LINUX: i32 = 1
const FAMILY_MACOS: i32 = 2
const FAMILY_UNKNOWN: i32 = 3

const ARCH_X86: i32 = 0
const ARCH_X86_64: i32 = 1
const ARCH_ARM: i32 = 2
const ARCH_ARM64: i32 = 3
const ARCH_UNKNOWN: i32 = 4

const BYTE_ORDER_LITTLE: i32 = 0
const BYTE_ORDER_BIG: i32 = 1

# ---------------------------------------------------------------------------
# Native bindings: process arguments and identity
# ---------------------------------------------------------------------------

extern "C" "sere_process_argc"
def _argc() -> i32
"""Return the number of process arguments."""

extern "C" "sere_process_argv"
def _argv() -> list[str]
"""Return the process arguments as a fresh list."""

extern "C" "sere_process_program_path"
def program_path() -> str
"""Return `argv[0]` exactly as the platform passed it."""

extern "C" "sere_process_program_name"
def program_name() -> str
"""Return the final component of `argv[0]`."""

extern "C" "sere_os_executable_path"
def executable() -> str
"""Return the absolute path of the executable hosting this program."""

extern "C" "sere_sys_pid"
def pid() -> i32
"""Return the current process ID."""

extern "C" "sere_sys_cpu_count"
def cpu_count() -> i32
"""Return the number of logical CPUs."""

