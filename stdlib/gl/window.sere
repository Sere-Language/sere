# Windows, input, and timing.
#
# A `Window` owns an operating-system window and an OpenGL context, and it also
# owns the event queue: nothing arrives until `poll()` or `wait()` is called, so
# an application loop looks like this:
#
#     window: gl.Window = gl.Window("sere", 960, 540)
#     if not window.is_open():
#         print("no display available")
#         return 1
#
#     window.make_current()
#     gl.default_depth_state()
#
#     while window.is_open():
#         window.poll()
#         if window.should_close():
#             window.close()
#
#         gl.viewport(0, 0, window.framebuffer_width(), window.framebuffer_height())
#         gl.clear_color(0.1, 0.1, 0.12, 1.0)
#         gl.clear(gl.GL_COLOR_BUFFER_BIT + gl.GL_DEPTH_BUFFER_BIT)
#         ... draw ...
#         window.swap()
#
#     window.destroy()
#
# `is_open()` is False when the runtime could not create a context, which is the
# case on a host without a display; there is no exception to catch.
#
# Keys are virtual-key codes, so `window.key(gl.KEY_ESCAPE)` reads the same on
# any keyboard layout. `key_char()` returns the last typed character as a code
# point, for text entry. Mouse events are per frame: `mouse_pressed()` is true
# only on the frame the button went down.
#
# Timing comes from `time()` (seconds since the window was created) and `dt()`
# (seconds since the previous frame), both monotonic, which is what a simulation
# wants rather than the wall clock.

from gl.constants import *

# ---------------------------------------------------------------------------
# Native surface
# ---------------------------------------------------------------------------

