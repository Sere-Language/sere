# Sere standard library prelude.
# print() and str() are compiler intrinsics and accept any value, including pointers.
# Names can alias functions and intrinsics: donut = print; donut("hi")
# Casts: value as T, or T(value) / Unique[T](pointer).
# Memory ops are language intrinsics:
#   unique[T](value) -> Unique[T]
#   shared[T](value) -> Shared[T]
#   alloc[T]() -> Ptr[T]
#   free(pointer) -> void
#   load(pointer) -> T
#   store(pointer, value) -> void
# Pointer syntax: &value is Ptr[T], *pointer loads T, *pointer = value stores.
#   len(items: list[T] | array[T] | dict[K, V]) -> i64
#   append(items: list[T], value: T) -> void
# Collections: list[T], array[T], dict[K, V]. Index with xs[i] / ages[key].
# Slices: xs[1:], xs[:n], xs[a:b], xs[:]
# Introspection: typeof(x), isinstance[T](x), isinstance(x, T), dir(x), dir(), inspect(x)
# Converters: parse[i32]("123"), try_parse[f64]("1.5") -> T | None
#   Also bool, str, None, Int, hex/binary/octal (0xFF, 0b1010, 0o17), digit underscores.
# Module globals: __name__, __file__, __package__, __doc__, __debug__, __sere_version__
# Host flags (compile-time bools; false branches are not typechecked):
#   __windows__, __linux__, __macos__, __unix__, __x86_64__, __arm64__
#   __platform__ ("windows"|"linux"|"macos"), __arch__ ("x86_64"|"arm64"|"unknown")
#   if __windows__: ...
#   if cfg!(linux): ...
#   ifdef <expr>: ... elifdef <expr>: ... elsedef: ...  (a preprocessor if;
#     the condition folds, so the branch that does not apply is not checked)
#     ifdef(windows) / ifdef windows mean __windows__
# Names: x.__name__, x.__type__, x.__module__, x.__qualname__
# Types: class (identity), struct (value copy), enum (discriminant; Color.Variant only)
#   Any accepts every value. None is void as a type: i32 | None = None (or = void)
# Methods: super() is the first base class; super().__init__(...) / super().method(...)
# Macros: `macro name(x): quote:` defines a compile-time rewrite.
#   Invoke with name!(args). Indent macros use `name:`.
#   Prelude macros:
#     dbg!(value)          print and yield value (statement form)
#     todo!("message")     panic with a message
#     unreachable!()       panic("unreachable")
#     cfg!(windows)        expands to __windows__ (also linux/macos/unix/x86_64/arm64/debug)
# Extra stdlib files in this folder are importable:
#   import inspect, io, fs, path, os, math, string, time, regex
#   import vec, matrix, arrays, ml, bytes, gc, heap, random, hash
#   import sys, log, encoding, bit, env, windows, gl, qt6
# Strings: double or single quotes, triple quotes for multiline, backticks for regex.
# byte is a builtin alias of u8 (unsigned 8-bit).
# prelude.sere is imported automatically into every program.

type Int = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 # type: ignore
type Float = f32 | f64 # type: ignore

type UnsignedInt = u8 | u16 | u32 | u64 # type: ignore
type SignedInt = i8 | i16 | i32 | i64

extern "C" "sere_input"
def input(prompt: str) -> str
"""Read a line after displaying a prompt."""

def abs(value: i32) -> i32:
    """Return the absolute value."""
    if value < 0:
        return -value
    return value

def min(left: i32, right: i32) -> i32:
    """Return the smaller integer."""
    if left < right:
        return left
    else:
        return right

def max(left: i32, right: i32) -> i32:
    """Return the larger integer."""
    if left > right:
        return left
    else:
        return right

def clamp(value: i32, low: i32, high: i32) -> i32:
    """Clamp value to the inclusive range."""
    return min(max(value, low), high)

def sign(value: i32) -> i32:
    """Return -1, 0, or 1 according to value's sign."""
    if value > 0:
        return 1
    elif value < 0:
        return -1

    return 0

# ---------------------------------------------------------------------------
# Sequence helpers
#
# Python-like list functions. They copy and index rather than consuming an
# iterator, because a list element is a scalar or a string here: a list of
# aggregates (tuples, records) is not something both backends can store yet, so
# `zip` and friends that would return pairs are deliberately absent.
# ---------------------------------------------------------------------------


def sorted[T](items: list[T]) -> list[T]:
    """Return a new list with the items in ascending order.

    Insertion sort: stable, simple, and good enough for the list sizes a
    compile-time or tooling helper sees. The input list is left alone.
    """
    result: list[T] = []
    index: i64 = 0
    while index < len(items):
        result.append(items[index])
        index = index + 1
    position: i64 = 1
    while position < len(result):
        current: T = result[position]
        hole: i64 = position
        while hole > 0 and current < result[hole - 1]:
            result[hole] = result[hole - 1]
            hole = hole - 1
        result[hole] = current
        position = position + 1
    return result


def sorted_desc[T](items: list[T]) -> list[T]:
    """Return a new list with the items in descending order."""
    result: list[T] = []
    index: i64 = 0
    while index < len(items):
        result.append(items[index])
        index = index + 1
    position: i64 = 1
    while position < len(result):
        current: T = result[position]
        hole: i64 = position
        while hole > 0 and current > result[hole - 1]:
            result[hole] = result[hole - 1]
            hole = hole - 1
        result[hole] = current
        position = position + 1
    return result


def reversed_list[T](items: list[T]) -> list[T]:
    """Return a new list with the items in reverse order."""
    result: list[T] = []
    index: i64 = len(items) - 1
    while index >= 0:
        result.append(items[index])
        index = index - 1
    return result


def sum_ints(items: list[i64]) -> i64:
    """Return the sum of a list of integers; empty lists sum to 0."""
    total: i64 = 0
    index: i64 = 0
    while index < len(items):
        total = total + items[index]
        index = index + 1
    return total


def sum_floats(items: list[f64]) -> f64:
    """Return the sum of a list of floats; empty lists sum to 0."""
    total: f64 = 0.0
    index: i64 = 0
    while index < len(items):
        total = total + items[index]
        index = index + 1
    return total


def min_list[T](items: list[T]) -> T:
    """Return the smallest item. An empty list is a ValueError."""
    if len(items) == 0:
        raise ValueError("min_list() arg is an empty list")
    smallest: T = items[0]
    index: i64 = 1
    while index < len(items):
        if items[index] < smallest:
            smallest = items[index]
        index = index + 1
    return smallest


def max_list[T](items: list[T]) -> T:
    """Return the largest item. An empty list is a ValueError."""
    if len(items) == 0:
        raise ValueError("max_list() arg is an empty list")
    largest: T = items[0]
    index: i64 = 1
    while index < len(items):
        if items[index] > largest:
            largest = items[index]
        index = index + 1
    return largest


def any_of(items: list[bool]) -> bool:
    """Return whether any item is true."""
    index: i64 = 0
    while index < len(items):
        if items[index]:
            return True
        index = index + 1
    return False


def all_of(items: list[bool]) -> bool:
    """Return whether every item is true. An empty list is true."""
    index: i64 = 0
    while index < len(items):
        if not items[index]:
            return False
        index = index + 1
    return True


def count_of[T](items: list[T], value: T) -> i64:
    """Return how many items equal value."""
    total: i64 = 0
    index: i64 = 0
    while index < len(items):
        if items[index] == value:
            total = total + 1
        index = index + 1
    return total


def index_of[T](items: list[T], value: T) -> i64:
    """Return the first index of value, or -1 when it is not there."""
    index: i64 = 0
    while index < len(items):
        if items[index] == value:
            return index
        index = index + 1
    return -1


def contains_item[T](items: list[T], value: T) -> bool:
    """Return whether value appears in the list."""
    return index_of(items, value) >= 0

class Exception:
    """Base class for Sere exceptions."""
    message: str

    def __init__(self, message: str = "") -> void:
        """Create an exception with an optional message."""
        self.message = message

class SyntaxError(Exception):
    """Raised for invalid syntax."""
    pass

class IndentationError(Exception):
    """Raised for invalid indentation."""
    pass

class NameError(Exception):
    """Raised for an unknown name."""
    pass

class AttributeError(Exception):
    """Raised for an unknown attribute."""
    pass

class TypeError(Exception):
    """Raised for an invalid type."""
    pass

class IndexError(Exception):
    """Raised for an invalid index."""
    pass

class ImportError(Exception):
    """Raised when a module cannot be imported."""
    pass

class ValueError(Exception):
    """Raised for an invalid value."""
    pass

class AssertionError(Exception):
    """Raised when an assertion fails."""
    pass

class PermissionError(Exception):
    """Raised when an operation lacks permission."""
    pass

class RuntimeError(Exception):
    """Raised for a runtime failure."""
    pass

class RecursionError(Exception):
    """Raised when recursion exceeds its limit."""
    pass

class NotImplementedError(Exception):
    """Raised for an unsupported operation."""
    pass

class ResultError(Exception):
    """Raised when an unsuccessful Result is unwrapped."""
    pass

enum Result[T, E]:
    """A value that is either successful or an error."""
    Ok(value: T)
    Err(error: E)

    def is_ok(self) -> bool:
        """Return whether this result is Ok."""
        match self:
            case Result.Ok(_):
                return True
            case Result.Err(_):
                return False

    def is_err(self) -> bool:
        """Return whether this result is Err."""
        match self:
            case Result.Ok(_):
                return False
            case Result.Err(_):
                return True

    def unwrap(self) -> T:
        """Return the value or raise ResultError."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(error):
                raise ResultError(str(error))

    def try_unwrap(self) -> T | None:
        """Return the value, or None for an error."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(_):
                return None

    def expect(self, message: str) -> T:
        """Return the value or raise with message."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(error):
                raise ResultError(message + ": " + str(error))

    def ok(self) -> T | None:
        """Return the success value, or None."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(_):
                return None

    def err(self) -> E | None:
        """Return the error value, or None."""
        match self:
            case Result.Ok(_):
                return None
            case Result.Err(error):
                return error

    def unwrap_or(self, default: T) -> T:
        """Return the value, or default for an error."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(_):
                return default

    def unwrap_or_else(self, fn: Callable[[E], T]) -> T:
        """Return the value, or compute one from the error."""
        match self:
            case Result.Ok(value):
                return value
            case Result.Err(error):
                return fn(error)

    def map[U](self, fn: Callable[[T], U]) -> Result[U, E]:
        """Map a successful value."""
        match self:
            case Result.Ok(value):
                return Result.Ok(fn(value))
            case Result.Err(error):
                return Result.Err(error)

    def map_err[F](self, fn: Callable[[E], F]) -> Result[T, F]:
        """Map an error value."""
        match self:
            case Result.Ok(value):
                return Result.Ok(value)
            case Result.Err(error):
                return Result.Err(fn(error))

    def map_or[U](self, default: U, fn: Callable[[T], U]) -> U:
        """Map a value or return default for an error."""
        match self:
            case Result.Ok(value):
                return fn(value)
            case Result.Err(_):
                return default

    def map_or_else[U](self, default_fn: Callable[[E], U], fn: Callable[[T], U]) -> U:
        """Map a value or compute a fallback from the error."""
        match self:
            case Result.Ok(value):
                return fn(value)
            case Result.Err(error):
                return default_fn(error)

    def and_[U](self, other: Result[U, E]) -> Result[U, E]:
        """Return other for success, otherwise this error."""
        match self:
            case Result.Ok(_):
                return other
            case Result.Err(error):
                return Result.Err(error)

    def and_then[U](self, fn: Callable[[T], Result[U, E]]) -> Result[U, E]:
        """Chain a function over a successful value."""
        match self:
            case Result.Ok(value):
                return fn(value)
            case Result.Err(error):
                return Result.Err(error)

    def or_[F](self, other: Result[T, F]) -> Result[T, F]:
        """Return this success, or other for an error."""
        match self:
            case Result.Ok(value):
                return Result.Ok(value)
            case Result.Err(_):
                return other

    def or_else[F](self, fn: Callable[[E], Result[T, F]]) -> Result[T, F]:
        """Return this success, or compute a result from the error."""
        match self:
            case Result.Ok(value):
                return Result.Ok(value)
            case Result.Err(error):
                return fn(error)

    def contains(self, expected: T) -> bool:
        """Return whether this result contains expected."""
        match self:
            case Result.Ok(value):
                return value == expected
            case Result.Err(_):
                return False

    def contains_err(self, expected: E) -> bool:
        """Return whether this result contains expected error."""
        match self:
            case Result.Ok(_):
                return False
            case Result.Err(error):
                return error == expected


macro dbg(x):
    quote:
        print($x)
        $x

macro todo(message):
    quote:
        panic($message)

macro unreachable:
    quote:
        panic("unreachable")

macro cfg:
    match:
        (windows) => quote:
            __windows__
        (linux) => quote:
            __linux__
        (macos) => quote:
            __macos__
        (unix) => quote:
            __unix__
        (x86_64) => quote:
            __x86_64__
        (arm64) => quote:
            __arm64__
        (debug) => quote:
            __debug__
