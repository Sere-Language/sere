# Sere standard library prelude.
# print() and str() are compiler intrinsics and accept any value, including pointers.
# Names can alias functions and intrinsics: donut = print; donut("hi")
# Casts: value as T, or T(value) / Unique[T](pointer).
# Memory ops are language intrinsics:
#   unique[T](value) -> Unique[T]
#   shared[T](value) -> Shared[T]
#   alloc[T]() -> Ptr[T]
#   free(pointer) -> void
#   load(pointer) -> T
#   store(pointer, value) -> void
# Pointer syntax: &value is Ptr[T], *pointer loads T, *pointer = value stores.
#   len(items: list[T] | array[T] | dict[K, V]) -> i64
#   append(items: list[T], value: T) -> void
# Collections: list[T], array[T], dict[K, V]. Index with xs[i] / ages[key].
# Slices: xs[1:], xs[:n], xs[a:b], xs[:]
# Introspection: typeof(x), isinstance[T](x), isinstance(x, T), dir(x), dir(), inspect(x)
# Module globals: __name__, __file__, __package__, __doc__, __debug__, __sere_version__
# Host flags (compile-time bools; false branches are not typechecked):
#   __windows__, __linux__, __macos__, __unix__, __x86_64__, __arm64__
#   __platform__ ("windows"|"linux"|"macos"), __arch__ ("x86_64"|"arm64"|"unknown")
#   if __windows__: ...
#   if cfg!(linux): ...
# Names: x.__name__, x.__type__, x.__module__, x.__qualname__
# Types: class (identity), struct (value copy), enum (discriminant; Color.Variant only)
# Methods: super() is the first base class; super().__init__(...) / super().method(...)
# Macros: `macro name(x): quote:` defines a compile-time rewrite.
#   Invoke with name!(args). Indent macros use `name:`.
#   Prelude macros:
#     dbg!(value)          print and yield value (statement form)
#     todo!("message")     panic with a message
#     unreachable!()       panic("unreachable")
#     cfg!(windows)        expands to __windows__ (also linux/macos/unix/x86_64/arm64/debug)
# Extra stdlib files in this folder are importable:
#   import inspect, io, fs, path, os, math, string, time, regex
#   import vec, matrix, arrays, ml, bytes, gc, heap, random, hash
#   import sys, log, encoding, bit, env, windows, gl, qt6
# Strings: double or single quotes, triple quotes for multiline, backticks for regex.
# byte is a builtin alias of u8 (unsigned 8-bit).
# prelude.sere is imported automatically into every program.
 
type Int = i8 | i16 | i32 | i64 | u8 | u16 | u32 | u64 # type: ignore
type Float = f32 | f64 # type: ignore

def abs(value: i32) -> i32:
    if value < 0:
        return -value
    return value

def min(left: i32, right: i32) -> i32:
    if left < right:
        return left
    else:
        return right

def max(left: i32, right: i32) -> i32:
    if left > right:
        return left
    else:
        return right

def clamp(value: i32, low: i32, high: i32) -> i32:
    return min(max(value, low), high)

def sign(value: i32) -> i32:
    if value > 0:
        return 1
    elif value < 0:
        return -1

    return 0

class Exception:
    message: str

    def __init__(self, message: str = "") -> void:
        self.message = message

class SyntaxError(Exception):
    pass

class IndentationError(Exception):
    pass

class NameError(Exception):
    pass

class AttributeError(Exception):
    pass

class TypeError(Exception):
    pass

class IndexError(Exception):
    pass

class ImportError(Exception):
    pass

class ValueError(Exception):
    pass

class AssertionError(Exception):
    pass

class PermissionError(Exception):
    pass

class RuntimeError(Exception):
    pass

class RecursionError(Exception):
    pass

class NotImplementedError(Exception):
    pass

macro dbg(x):
    quote:
        print($x)
        $x

macro todo(message):
    quote:
        panic($message)

macro unreachable:
    quote:
        panic("unreachable")

macro cfg:
    match:
        (windows) => quote:
            __windows__
        (linux) => quote:
            __linux__
        (macos) => quote:
            __macos__
        (unix) => quote:
            __unix__
        (x86_64) => quote:
            __x86_64__
        (arm64) => quote:
            __arm64__
        (debug) => quote:
            __debug__

