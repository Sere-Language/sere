# Environment variables. Import with: import env

import string

extern "C" "sere_os_getenv"
def get(name: str) -> str
"""Return an environment variable value."""

extern "C" "sere_os_getcwd"
def cwd() -> str
"""Return the current working directory."""

def is_set(name: str) -> bool:
    """Return whether an environment variable has a value."""
    return string.eq(get(name), "") == False
